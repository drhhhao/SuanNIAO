// 蒜鸟电脑端主界面：首页、布局、映射、总览、设置、关于。
// 风格参考 Relay：白底、细线、黑色选中块、青柠绿点缀，跟随 Windows 的深浅色。
// 软件渲染器不画阴影、不支持缩放：层次靠细线和底色，动效用位置、透明度和颜色的过渡。
import { ScrollView, AboutSlint, Palette } from "std-widgets.slint";
import "../fonts/Nunito.ttf";

// 位置和大小的单位是格，可以是小数
export struct ModuleItem {
    id: string,
    kind: string,
    label: string,
    x: float,
    y: float,
    w: float,
    h: float,
    // 按键：按住连发
    repeat: bool,
}

// 一块区域，单位是格
export struct Area {
    x: float,
    y: float,
    w: float,
    h: float,
}

// 拖动中松手后模块会在哪：Rust 算好（对齐、不重叠、不出界）
export struct Ghost {
    x: float,
    y: float,
    w: float,
    h: float,
    // false：放不下，画红框，松手不动
    ok: bool,
    // 旁边显示的字：「宽 1.25 × 高 2」「左 1.5 · 上 2」「和「回车」互换」
    label: string,
    // 拖到别的模块上互换位置：被换走的模块会去哪
    moved: [Area],
}

// 动作序列里的一步，给映射页的一行用
export struct ActionItem {
    // 0 按键 1 组合键 2 鼠标按键 3 鼠标滚轮 4 光标移动 5 输入文本 6 等待 7 打开应用 8 打开网站 9 媒体控制 10 切换方案 11 禁用；-1 看不懂（只读）
    kind: int,
    // 下拉框选中的项：按键在按键表里的位置、鼠标键、方向、媒体键、粘贴方式
    choice: int,
    // 按键下拉框：选中的按键在列表里第几行（含分组标题，用来滚到它）和显示的字
    row: int,
    shown: string,
    // 组合键、文本、路径、网址；看不懂的步骤是它的原文
    text: string,
    // 打开应用的启动参数
    args: string,
    // 光标距离、等待毫秒数
    number: int,
    // 打开应用：已经在运行就切到它的窗口
    flag: bool,
    enabled: bool,
    // 不合法时的红字提示（网址、路径、按键名）
    problem: string,
}

// 按键下拉框的一行：分组标题（header）或者一个按键（key 是它在按键表里的位置）
export struct KeyOption {
    text: string,
    header: bool,
    key: int,
}

// 导入遥控器映射的预览：一个遥控器键
// 设置页「扫码连接」里一部扫码绑定过局域网的手机
export struct LanPhoneRow {
    id: string,
    name: string,
    detail: string,
    online: bool,
}

export struct ImportRow {
    // 键上的字（手机上显示的）
    label: string,
    // 图标（按单击的动作挑，见 OverviewRow）
    icon: string,
    glyph: string,
    tone: int,
    click: string,
    double: string,
    long: string,
    // 按住时
    hold: string,
    // 补充说明（单击是补上的原键……）
    note: string,
    checked: bool,
    // 三种按法有没有配
    configured: bool,
}

// 已保存的动作序列：一条
export struct SavedItem {
    name: string,
    summary: string,
    count: int,
}

export struct OverviewRow {
    label: string,
    // 按键上的字
    key: string,
    click: string,
    double: string,
    long: string,
    // 今天按了几次
    today: int,
    // 在映射页按键列表里是第几个
    index: int,
    // 按住时：0 长按一次 1 重复长按 2 连发 3 直通（2、3 时双击、长按不生效）
    hold: int,
    hold-name: string,
    // 图标按单击的动作挑：icon 是图标名；没有合适图标的键 glyph 是两三个字（Esc、^C、F5），tone 是颜色
    icon: string,
    glyph: string,
    tone: int,
    // 连发、直通时又配了双击或长按：那些不会生效
    ignored: bool,
}

export struct RecentItem {
    // key：按键；voice：语音
    kind: string,
    title: string,
    detail: string,
    time: string,
    // 按住连发合成一条时连着按了几下
    count: int,
    icon: string,
    glyph: string,
    tone: int,
}

// 映射页左边的列表：页面标题（可以收起）或者一个按键
export struct MapRow {
    header: bool,
    text: string,
    // 右边的小字：按住时（连发、直通、重复长按），或者配了的双击、长按
    tag: string,
    icon: string,
    glyph: string,
    tone: int,
    // 按键：在所有按键里第几个；页面标题：第几页
    index: int,
    collapsed: bool,
    // 页面标题：这一页（搜索时是搜到的）几个按键
    count: int,
}

// 下拉框选项，由 Rust 填入，和配置里的取值一一对应
export global Lists {
    in property <[string]> action-kinds;
    in property <[KeyOption]> key-options;
    in property <[string]> mouse-buttons;
    in property <[string]> directions;
    in property <[string]> media-keys;
    in property <[string]> paste-modes;
    // 按住时的四种（名字和一句说明）
    in property <[string]> hold-modes;
    in property <[string]> hold-notes;
    // 切换方案的方向
    in property <[string]> profile-directions;
    // 一键预设（分组）
    in property <[KeyOption]> presets;
    // 按键下拉框里输入的字：筛出名字或按键名里有它的（分组标题留着有结果的）
    pure callback filter-keys(string) -> [KeyOption];
}

// 动效：统一的时长和缓动（顺滑，不回弹）
global Motion {
    out property <duration> quick: 140ms;
    out property <duration> normal: 240ms;
}

// ───────────────────────── 配色、图标 ─────────────────────────

export global Theme {
    // 截图检查用：强制深色（SuanNIAO.exe --dark，由主窗口设）
    in-out property <bool> force-dark: false;
    out property <bool> dark: root.force-dark || Palette.color-scheme == ColorScheme.dark;
    out property <color> win: dark ? #0f0f10 : #ffffff;
    out property <color> side: dark ? #131314 : #fbfbfa;
    out property <color> line: dark ? #242427 : #ecebe8;
    out property <color> line2: dark ? #2f2f33 : #e1e0dc;
    out property <color> soft: dark ? #18181a : #f7f7f5;
    out property <color> hover: dark ? #1e1e21 : #f1f1ee;
    out property <color> fg: dark ? #f2f2f2 : #141414;
    out property <color> fg2: dark ? #cfcfcf : #3a3a3a;
    out property <color> mut: dark ? #8a8a8f : #8b8a86;
    out property <color> ink: dark ? #f3f3f3 : #121212;
    out property <color> ink-fg: dark ? #121212 : #ffffff;
    out property <color> lime: dark ? #c3f06a : #dcf7a1;
    out property <color> lime-fg: dark ? #1c2a06 : #3d5c0e;
    out property <color> lime-dot: dark ? #bef264 : #84cc16;
    out property <color> green: #22c55e;
    out property <color> amber: #f59e0b;
    out property <color> red: dark ? #f87171 : #dc2626;
    // 醒目横幅（配置读不出来）
    out property <color> warn-bg: dark ? #3a1f12 : #fff4e5;
    out property <color> warn-line: dark ? #7c3a14 : #fcd9a8;
    out property <color> warn-fg: dark ? #fdba74 : #9a3412;
    // 电量低
    out property <color> low: dark ? #fb7185 : #e11d48;
    // 手机外观，和手机端一致
    out property <color> phone-bg: dark ? #000000 : #efefec;
    out property <color> phone-tile: dark ? #111111 : #ffffff;
    out property <color> phone-line: dark ? #232323 : #e2e2de;
    out property <color> phone-fg: dark ? #f2f2f2 : #121212;
    out property <color> phone-mut: dark ? #767676 : #8d8d88;

    // 色块：0 中性、1 青柠、2 橙、3 紫、4 绿
    public pure function tone-bg(t: int) -> color {
        if (t == 1) {
            return lime;
        }
        if (t == 2) {
            return dark ? #33210f : #ffedd5;
        }
        if (t == 3) {
            return dark ? #251d3d : #ede9fe;
        }
        if (t == 4) {
            return dark ? #0f2a19 : #dcfce7;
        }
        return dark ? #222225 : #f1f1ef;
    }

    public pure function tone-fg(t: int) -> color {
        if (t == 1) {
            return lime-fg;
        }
        if (t == 2) {
            return dark ? #fb923c : #c2410c;
        }
        if (t == 3) {
            return dark ? #a78bfa : #6d28d9;
        }
        if (t == 4) {
            return dark ? #4ade80 : #15803d;
        }
        return dark ? #b4b4b9 : #5f5f5c;
    }
}

// 图标名 → 图标（按键的图标按动作挑，名字由 Rust 给）
global Icons {
    public pure function get(name: string) -> image {
        if (name == "enter") {
            return @image-url("../icons/enter.svg");
        }
        if (name == "del") {
            return @image-url("../icons/del.svg");
        }
        if (name == "wrap") {
            return @image-url("../icons/wrap.svg");
        }
        if (name == "tab") {
            return @image-url("../icons/tab.svg");
        }
        if (name == "stab") {
            return @image-url("../icons/stab.svg");
        }
        if (name == "up") {
            return @image-url("../icons/up.svg");
        }
        if (name == "down") {
            return @image-url("../icons/down.svg");
        }
        if (name == "left") {
            return @image-url("../icons/left.svg");
        }
        if (name == "right") {
            return @image-url("../icons/right.svg");
        }
        if (name == "kbd") {
            return @image-url("../icons/kbd.svg");
        }
        if (name == "mouse") {
            return @image-url("../icons/mouse.svg");
        }
        if (name == "wheel") {
            return @image-url("../icons/wheel.svg");
        }
        if (name == "move") {
            return @image-url("../icons/move.svg");
        }
        if (name == "text") {
            return @image-url("../icons/text.svg");
        }
        if (name == "app") {
            return @image-url("../icons/app.svg");
        }
        if (name == "globe") {
            return @image-url("../icons/globe.svg");
        }
        if (name == "clock") {
            return @image-url("../icons/clock.svg");
        }
        if (name == "music") {
            return @image-url("../icons/music.svg");
        }
        if (name == "layers") {
            return @image-url("../icons/layers.svg");
        }
        if (name == "stop") {
            return @image-url("../icons/stop.svg");
        }
        if (name == "pad") {
            return @image-url("../icons/pad.svg");
        }
        if (name == "mic") {
            return @image-url("../icons/mic.svg");
        }
        return @image-url("../icons/btn.svg");
    }
}

// 按键上的字 → 图标（布局画布、手机缩略图用：和手机端认的那几个键一致，手机上就是按字画的）
global Keys {
    public pure function icon(label: string) -> image {
        if (label == "↑" || label == "上") {
            return @image-url("../icons/up.svg");
        }
        if (label == "↓" || label == "下") {
            return @image-url("../icons/down.svg");
        }
        if (label == "←" || label == "左") {
            return @image-url("../icons/left.svg");
        }
        if (label == "→" || label == "右") {
            return @image-url("../icons/right.svg");
        }
        if (label == "回车" || label == "Enter" || label == "↵") {
            return @image-url("../icons/enter.svg");
        }
        if (label == "删除" || label == "退格" || label == "Backspace" || label == "⌫") {
            return @image-url("../icons/del.svg");
        }
        if (label == "换行") {
            return @image-url("../icons/wrap.svg");
        }
        if (label == "Tab") {
            return @image-url("../icons/tab.svg");
        }
        if (label == "Shift+Tab") {
            return @image-url("../icons/stab.svg");
        }
        return @image-url("../icons/btn.svg");
    }

    // 手机上画图标的那几个键（其余的手机上直接写字）
    public pure function drawn(label: string) -> bool {
        return label == "↑" || label == "上" || label == "↓" || label == "下" || label == "←" || label == "左" || label == "→" || label == "右" || label == "回车" || label == "Enter" || label == "↵" || label == "删除" || label == "退格" || label == "Backspace" || label == "⌫" || label == "换行" || label == "Tab" || label == "Shift+Tab";
    }

}

// ───────────────────────── 小部件 ─────────────────────────

// 图标：宽度固定，在所在那一行里自动上下居中
component Icon inherits Rectangle {
    in property <image> source;
    in property <color> tint: Theme.fg;
    in property <length> size: 16px;
    width: root.size;
    min-height: root.size;
    Image {
        width: root.size;
        height: root.size;
        source: root.source;
        colorize: root.tint;
        image-fit: contain;
    }
}

// 左上角的品牌字「蒜鸟」：三层叠起来，字身跟着深浅色，蒜苗绿色，蛋固定蛋黄色（tools/logo/wordmark.py 生成）
component Wordmark inherits Rectangle {
    // 一个字的大小（字号）
    in property <length> em: 25px;
    width: root.em * 1.955;
    height: root.em * 1.162;
    Image {
        width: 100%;
        height: 100%;
        source: @image-url("../../assets/wordmark.svg");
        colorize: Theme.fg;
    }
    Image {
        width: 100%;
        height: 100%;
        source: @image-url("../../assets/wordmark-sprouts.svg");
        colorize: Theme.dark ? #bef264 : #6db81f;
    }
    Image {
        width: 100%;
        height: 100%;
        source: @image-url("../../assets/wordmark-egg.svg");
    }
}

// 黑色主按钮
component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> icon-after: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 36px;
    border-radius: 10px;
    background: area.pressed ? Theme.ink.with-alpha(0.78) : area.has-hover && root.enabled ? Theme.ink.with-alpha(0.88) : Theme.ink;
    opacity: root.enabled ? 1 : 0.35;
    animate background { duration: 150ms; }
    HorizontalLayout {
        padding-left: root.text == "" ? 10px : 14px;
        padding-right: root.text == "" ? 10px : 14px;
        spacing: 7px;
        alignment: center;
        if root.has-icon && !root.icon-after: Icon {
            source: root.icon;
            tint: Theme.ink-fg;
            size: 15px;
        }
        if root.text != "": Text {
            text: root.text;
            color: Theme.ink-fg;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
        if root.has-icon && root.icon-after: Icon {
            source: root.icon;
            tint: Theme.ink-fg;
            size: 15px;
        }
    }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// 白底细边框按钮
component GhostButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> icon-after: false;
    in property <bool> small: false;
    in property <bool> enabled: true;
    in property <color> text-color: Theme.fg;
    callback clicked();
    height: root.small ? 30px : 36px;
    border-radius: root.small ? 8px : 10px;
    border-width: 1px;
    border-color: Theme.line2;
    background: !root.enabled ? Theme.win : area.pressed ? Theme.line : area.has-hover ? Theme.hover : Theme.win;
    opacity: root.enabled ? 1 : 0.45;
    animate background { duration: 150ms; }
    HorizontalLayout {
        padding-left: root.text == "" ? 8px : root.small ? 10px : 13px;
        padding-right: root.text == "" ? 8px : root.small ? 10px : 13px;
        spacing: 7px;
        alignment: center;
        if root.has-icon && !root.icon-after: Icon {
            source: root.icon;
            tint: root.text-color;
            size: 15px;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.text-color;
            font-size: root.small ? 12.5px : 13px;
            font-weight: 500;
            vertical-alignment: center;
        }
        if root.has-icon && root.icon-after: Icon {
            source: root.icon;
            tint: root.text-color;
            size: 15px;
        }
    }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// 只有图标的小按钮（动作行里的上移、下移、删除）
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    in property <color> tint: Theme.mut;
    callback clicked();
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: root.enabled && area.has-hover ? Theme.hover : transparent;
    // 用不了的时候淡一点，但还看得清
    opacity: root.enabled ? 1 : 0.42;
    animate background { duration: 150ms; }
    Icon {
        source: root.icon;
        tint: root.enabled && area.has-hover ? Theme.fg : root.tint;
        size: 16px;
    }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// 窗口按钮（最小化、最大化、关闭）：系统的标题栏去掉了，换成和顶栏别的按钮一个样子。
// 整格（顶栏那么高）都能点，只在中间画一块
component TitleButton inherits Rectangle {
    in property <image> icon;
    // 关闭按钮：悬停时变红
    in property <bool> danger: false;
    // 窗口不在前台时图标淡一点（和系统的标题栏一样）
    in property <bool> active: true;
    // 最大化按钮的悬停、按下由程序给（这个按钮上的鼠标消息不经过界面）
    in property <bool> outside-hover: false;
    in property <bool> outside-pressed: false;
    // 这一格比按钮宽出来多少：关闭按钮那格一直伸到窗口右边，最大化时鼠标甩到屏幕右上角也点得到
    in property <length> extra-right: 0px;
    // 安装界面正在装的时候关闭按钮点不了
    in property <bool> enabled: true;
    callback clicked();
    property <bool> hovered: root.enabled && (area.has-hover || root.outside-hover);
    property <bool> down: root.enabled && (area.pressed || root.outside-pressed);
    width: 34px + root.extra-right;
    Rectangle {
        x: 1px;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: !root.hovered ? transparent : root.danger ? (root.down ? #b91c1c : #dc2626) : root.down ? Theme.line : Theme.hover;
        animate background { duration: 150ms; }
        Icon {
            source: root.icon;
            tint: root.hovered && root.danger ? #ffffff : root.hovered ? Theme.fg : root.active ? Theme.fg2 : Theme.mut;
            size: 16px;
            opacity: root.enabled ? 1 : 0.35;
        }
    }
    area := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// 彩色小标签
component Chip inherits Rectangle {
    in property <string> text;
    in property <int> tone: 0;
    in property <bool> dot: false;
    horizontal-stretch: 0;
    height: 22px;
    border-radius: 7px;
    background: Theme.tone-bg(root.tone);
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        alignment: center;
        if root.dot: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.tone-fg(root.tone);
            }
        }
        Text {
            text: root.text;
            color: Theme.tone-fg(root.tone);
            font-size: 11.5px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// 键名样式的小块（Enter、Ctrl+Backspace…）
component KeyCap inherits Rectangle {
    in property <string> text;
    height: 24px;
    border-radius: 7px;
    border-width: root.text == "—" ? 0px : 1px;
    border-color: Theme.line2;
    background: root.text == "—" ? transparent : Theme.soft;
    HorizontalLayout {
        padding-left: root.text == "—" ? 0px : 8px;
        padding-right: root.text == "—" ? 0px : 8px;
        Text {
            text: root.text;
            color: root.text == "—" ? Theme.line2 : Theme.fg;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// 按键的彩色图标块：图标按动作挑（回车、删除、方向键……），没有合适图标的写两三个字（Esc、^C、F5）
component KeyTile inherits Rectangle {
    // button / touchpad / voice / voiceButton
    in property <string> kind: "button";
    in property <string> icon;
    in property <string> glyph;
    in property <int> tone: 0;
    in property <length> size: 32px;
    property <int> shade: root.kind == "voiceButton" ? 1 : root.kind == "button" ? root.tone : 0;
    width: root.size;
    height: root.size;
    border-radius: root.size * 0.28;
    background: Theme.tone-bg(root.shade);
    if root.kind != "button" || root.glyph == "": Icon {
        source: root.kind == "touchpad" ? @image-url("../icons/pad.svg") : root.kind == "voiceButton" ? @image-url("../icons/mic.svg") : root.kind == "voice" ? @image-url("../icons/text.svg") : Icons.get(root.icon);
        tint: Theme.tone-fg(root.shade);
        size: root.size * 0.5;
    }
    if root.kind == "button" && root.glyph != "": Text {
        width: root.size;
        height: root.size;
        text: root.glyph;
        color: Theme.tone-fg(root.shade);
        font-size: root.glyph.character-count > 2 ? root.size * 0.32 : root.size * 0.38;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Card inherits Rectangle {
    background: Theme.win;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.line;
}

// 卡片标题行：图标 + 标题，后面接调用方放的东西
component CardHead inherits HorizontalLayout {
    in property <string> title;
    in property <image> icon;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    spacing: 10px;
    min-height: 58px;
    Icon {
        source: root.icon;
        size: 17px;
    }
    Text {
        text: root.title;
        color: Theme.fg;
        font-size: 15.5px;
        font-weight: 600;
        vertical-alignment: center;
    }
    @children
}

// 会折行的说明文字。Slint 1.18 在布局里按「一行排得下」算折行文字的高度，窄的时候会和下面的东西叠在一起；
// 直接读 preferred-height 时是按现在的实际宽度折行算的，所以高度绑到它上面，行数变了布局跟着变
component Muted inherits Text {
    min-width: 0px;
    color: Theme.mut;
    font-size: 12.5px;
    wrap: word-wrap;
    height: self.preferred-height;
}

// 同上，普通颜色的折行文字
component WrapText inherits Text {
    min-width: 0px;
    color: Theme.fg2;
    font-size: 13px;
    wrap: word-wrap;
    height: self.preferred-height;
}

// 开关：圆钮顺滑地滑过去
component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled();
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? Theme.ink : Theme.line2;
    animate background { duration: 220ms; }
    Rectangle {
        x: root.checked ? 18px : 2px;
        y: 2px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.checked ? Theme.ink-fg : #ffffff;
        animate x { duration: Motion.normal; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        animate background { duration: 220ms; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

// 分段选择（受控）：自己不改选中的是哪段，点了只报告 picked，由数据决定 current（列表复用、切换按键时不会错位）。
// 下标 >= disabled-from 的几段置灰，点了报告 blocked（说明为什么用不了）
component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    in property <length> segment-width: 64px;
    in property <int> disabled-from: 99;
    callback picked(int);
    callback blocked(int);
    width: root.options.length * root.segment-width + 6px;
    height: 34px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.soft;
    Rectangle {
        x: 3px + root.current * root.segment-width;
        y: 3px;
        width: root.segment-width;
        height: root.height - 6px;
        border-radius: 8px;
        background: Theme.win;
        border-width: 1px;
        border-color: Theme.line2;
        animate x { duration: Motion.normal; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }
    for option[i] in root.options: Rectangle {
        x: 3px + i * root.segment-width;
        y: 3px;
        width: root.segment-width;
        height: root.height - 6px;
        Text {
            width: parent.width;
            height: parent.height;
            text: option;
            color: i >= root.disabled-from ? Theme.line2 : i == root.current ? Theme.fg : Theme.mut;
            font-size: 12.5px;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
            animate color { duration: 200ms; }
        }
        TouchArea {
            mouse-cursor: i < root.disabled-from ? MouseCursor.pointer : MouseCursor.not-allowed;
            clicked => {
                if (i >= root.disabled-from) {
                    root.blocked(i);
                } else if (i != root.current) {
                    root.picked(i);
                }
            }
        }
    }
}

// 加减按钮夹着一个数
component Stepper inherits Rectangle {
    in property <string> text;
    in property <length> text-width: 72px;
    callback minus();
    callback plus();
    width: root.text-width + 56px;
    height: 32px;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.line2;
    background: Theme.win;
    for b[i] in [{ sign: "−", left: true }, { sign: "+", left: false }]: Rectangle {
        x: b.left ? 1px : parent.width - 29px;
        y: 1px;
        width: 28px;
        height: parent.height - 2px;
        border-radius: 8px;
        background: area.has-hover ? Theme.hover : transparent;
        animate background { duration: 150ms; }
        Text {
            width: parent.width;
            height: parent.height;
            text: b.sign;
            color: Theme.fg2;
            font-size: 15px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if (b.left) {
                    root.minus();
                } else {
                    root.plus();
                }
            }
        }
    }
    Text {
        x: 28px;
        width: parent.width - 56px;
        height: parent.height;
        text: root.text;
        color: Theme.fg;
        font-size: 12.5px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// 数字框：两边加减，中间可以直接输入（按回车或换到别的输入框时生效）
component NumberField inherits Rectangle {
    // 数字前面的小字：左、上、宽、高
    in property <string> prefix;
    in property <float> value;
    callback minus();
    callback plus();
    callback typed(float);
    width: 116px;
    height: 32px;
    border-radius: 9px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.ink : Theme.line2;
    background: Theme.win;
    animate border-color { duration: 150ms; }
    // 先把框里还原成当前值再交出去：收下了 value 会变、框里跟着变；放不下就停在原来的值
    function commit() {
        if (input.text.is-float() && input.text.to-float() != root.value) {
            root.typed(input.text.to-float());
        }
        input.text = root.value;
    }
    changed value => {
        input.text = root.value;
    }
    for b[i] in [{ sign: "−", left: true }, { sign: "+", left: false }]: Rectangle {
        x: b.left ? 1px : parent.width - 29px;
        y: 1px;
        width: 28px;
        height: parent.height - 2px;
        border-radius: 8px;
        background: area.has-hover ? Theme.hover : transparent;
        animate background { duration: 150ms; }
        Text {
            width: parent.width;
            height: parent.height;
            text: b.sign;
            color: Theme.fg2;
            font-size: 15px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if (b.left) {
                    root.minus();
                } else {
                    root.plus();
                }
            }
        }
    }
    Text {
        x: 32px;
        height: parent.height;
        text: root.prefix;
        color: Theme.mut;
        font-size: 12px;
        vertical-alignment: center;
    }
    input := TextInput {
        x: 48px;
        width: parent.width - 80px;
        height: parent.height;
        text: root.value;
        color: Theme.fg;
        font-size: 12.5px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        single-line: true;
        input-type: decimal;
        selection-background-color: Theme.lime;
        selection-foreground-color: Theme.lime-fg;
        accepted => {
            root.commit();
        }
        changed has-focus => {
            if (!self.has-focus) {
                root.commit();
            }
        }
    }
}

// 滑块：黑色进度 + 白色圆钮
component SliderBar inherits Rectangle {
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    callback changed();
    width: 160px;
    height: 22px;
    property <float> t: Math.max(0, Math.min(1, (root.value - root.minimum) / (root.maximum - root.minimum)));
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.line2;
    }
    Rectangle {
        x: 0;
        y: (parent.height - 4px) / 2;
        width: root.t * (root.width - 16px) + 8px;
        height: 4px;
        border-radius: 2px;
        background: Theme.ink;
    }
    Rectangle {
        x: root.t * (root.width - 16px);
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Theme.win;
        border-width: 1.5px;
        border-color: Theme.ink;
    }
    function set-from(x: length) {
        root.value = root.minimum + Math.max(0, Math.min(1, (x - 8px) / (root.width - 16px))) * (root.maximum - root.minimum);
        root.changed();
    }
    TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.set-from(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.set-from(self.mouse-x);
            }
        }
    }
}

// 单行输入框：聚焦时边框变黑
component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    callback edited(string);
    height: 34px;
    border-radius: 9px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.ink : Theme.line2;
    background: Theme.win;
    clip: true;
    animate border-color { duration: 150ms; }
    if root.text == "": Text {
        x: 11px;
        width: parent.width - 22px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.mut;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    input := TextInput {
        x: 11px;
        width: parent.width - 22px;
        height: parent.height;
        text <=> root.text;
        color: Theme.fg;
        font-size: 13px;
        vertical-alignment: center;
        single-line: true;
        selection-background-color: Theme.lime;
        selection-foreground-color: Theme.lime-fg;
        edited => {
            root.edited(self.text);
        }
    }
}

// 下拉选择（受控）：点开在下面弹出列表，项多时可以滚动（底下有渐隐提示还有更多）。
// 选了只报告 selected，current-index 由数据决定
component Select inherits Rectangle {
    in property <[string]> model;
    in property <int> current-index;
    in property <length> popup-min-width: 160px;
    in property <length> popup-max-height: 420px;
    callback selected(int);
    height: 34px;
    min-width: 80px;
    border-radius: 9px;
    border-width: 1px;
    border-color: area.has-hover ? Theme.mut : Theme.line2;
    background: Theme.win;
    animate border-color { duration: 150ms; }
    Text {
        x: 11px;
        width: parent.width - 36px;
        height: parent.height;
        text: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
        color: Theme.fg;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    Icon {
        x: parent.width - 26px;
        size: 14px;
        source: @image-url("../icons/chev.svg");
        tint: Theme.mut;
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            popup.show();
        }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: Math.max(root.width, root.popup-min-width);
        height: Math.min(root.model.length * 32px + 10px, root.popup-max-height);
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            property <bool> shown: false;
            init => {
                self.shown = true;
            }
            opacity: self.shown ? 1 : 0;
            y: self.shown ? 0px : -4px;
            animate opacity, y { duration: Motion.quick; easing: ease-out; }
            background: Theme.win;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.line2;
            list := Flickable {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                content-height: root.model.length * 32px + 8px;
                for item[i] in root.model: Rectangle {
                    x: 4px;
                    y: 4px + i * 32px;
                    width: parent.width - 8px;
                    height: 32px;
                    border-radius: 7px;
                    background: option.has-hover ? Theme.hover : i == root.current-index ? Theme.soft : transparent;
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: item;
                        color: Theme.fg;
                        font-size: 13px;
                        font-weight: i == root.current-index ? 600 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    option := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.selected(i);
                            popup.close();
                        }
                    }
                }
            }
            // 下面还有没露出来的项：底部渐隐
            if list.content-height + list.content-y > list.height + 4px: Rectangle {
                x: 1px;
                y: parent.height - 30px;
                width: parent.width - 2px;
                height: 29px;
                border-radius: 9px;
                background: @linear-gradient(180deg, Theme.win.with-alpha(0) 0%, Theme.win 85%);
                Icon {
                    x: (parent.width - 14px) / 2;
                    y: 12px;
                    source: @image-url("../icons/chev.svg");
                    tint: Theme.mut;
                    size: 14px;
                }
            }
        }
    }
}

// 按键下拉框：分组列出（常用、修饰键、标点、媒体、字母数字、功能键），分组标题不能选。
// 上面有搜索框：输入名字或按键名筛选。current-row 是选中的按键在列表里第几行（打开时滚到它附近）。
// 还没选按键（invalid）时边框标红、写「请选择按键」
component KeyPicker inherits Rectangle {
    in property <[KeyOption]> model;
    in property <string> shown;
    in property <int> current-row: -1;
    in property <bool> invalid;
    callback selected(int);
    height: 34px;
    min-width: 80px;
    border-radius: 9px;
    border-width: root.invalid ? 1.5px : 1px;
    border-color: root.invalid ? Theme.red : area.has-hover ? Theme.mut : Theme.line2;
    background: Theme.win;
    animate border-color { duration: 150ms; }
    Text {
        x: 11px;
        width: parent.width - 36px;
        height: parent.height;
        text: root.shown == "" ? "请选择按键" : root.shown;
        color: root.shown == "" ? Theme.red : Theme.fg;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    Icon {
        x: parent.width - 26px;
        size: 14px;
        source: @image-url("../icons/chev.svg");
        tint: Theme.mut;
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            popup.show();
        }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: Math.max(root.width, 240px);
        height: 360px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        box := Rectangle {
            property <bool> shown: false;
            property <string> query;
            property <[KeyOption]> rows: self.query == "" ? root.model : Lists.filter-keys(self.query);
            init => {
                self.shown = true;
                search.focus();
            }
            opacity: self.shown ? 1 : 0;
            y: self.shown ? 0px : -4px;
            animate opacity, y { duration: Motion.quick; easing: ease-out; }
            background: Theme.win;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.line2;
            // 搜索框
            Rectangle {
                x: 6px;
                y: 6px;
                width: parent.width - 12px;
                height: 32px;
                border-radius: 8px;
                background: Theme.soft;
                border-width: 1px;
                border-color: search.has-focus ? Theme.mut : Theme.line;
                Icon {
                    x: 9px;
                    size: 14px;
                    source: @image-url("../icons/search.svg");
                    tint: Theme.mut;
                }
                if box.query == "": Text {
                    x: 30px;
                    width: parent.width - 40px;
                    height: parent.height;
                    text: "搜索：回车、Esc、F5、Ctrl……";
                    color: Theme.mut;
                    font-size: 12.5px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                search := TextInput {
                    x: 30px;
                    width: parent.width - 40px;
                    height: parent.height;
                    color: Theme.fg;
                    font-size: 12.5px;
                    vertical-alignment: center;
                    single-line: true;
                    selection-background-color: Theme.lime;
                    selection-foreground-color: Theme.lime-fg;
                    edited => {
                        box.query = self.text;
                    }
                    // 回车：选第一个搜到的按键
                    accepted => {
                        if (box.rows.length > 0 && !box.rows[0].header) {
                            root.selected(box.rows[0].key);
                            popup.close();
                        } else if (box.rows.length > 1 && !box.rows[1].header) {
                            root.selected(box.rows[1].key);
                            popup.close();
                        }
                    }
                }
            }
            list := Flickable {
                x: 1px;
                y: 44px;
                width: parent.width - 2px;
                height: parent.height - 45px;
                content-height: box.rows.length * 30px + 8px;
                // 打开时让选中的那一项落在中间附近（搜索时从头看）
                content-y: box.query != "" ? 0px : -Math.max(0px, Math.min(root.model.length * 30px + 8px - self.height, root.current-row * 30px - 120px));
                for option[i] in box.rows: Rectangle {
                    x: 4px;
                    y: 4px + i * 30px;
                    width: parent.width - 8px;
                    height: 30px;
                    border-radius: 7px;
                    background: option.header ? transparent : pick.has-hover ? Theme.hover : option.text == root.shown ? Theme.soft : transparent;
                    Text {
                        x: option.header ? 8px : 12px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: option.text;
                        color: option.header ? Theme.mut : Theme.fg;
                        font-size: option.header ? 11.5px : 13px;
                        font-weight: option.header ? 600 : option.text == root.shown ? 600 : 400;
                        vertical-alignment: option.header ? bottom : center;
                        overflow: elide;
                    }
                    pick := TouchArea {
                        enabled: !option.header;
                        mouse-cursor: pointer;
                        clicked => {
                            root.selected(option.key);
                            popup.close();
                        }
                    }
                }
                if box.rows.length == 0: Text {
                    y: 16px;
                    width: parent.width;
                    text: "没有这个按键";
                    color: Theme.mut;
                    font-size: 12.5px;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

// 设置里的一行：左边名字和说明，右边控件。说明折行时行高跟着变（见 Muted）
component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> note;
    // 这一行现在用不上（比如布局里没有语音输入框）：淡一点
    in property <bool> dim: false;
    // 卡片里的第一行（上面没有卡片标题）：不画分隔线，卡片自己有边框
    in property <bool> first: false;
    min-height: 54px;
    Rectangle {
        height: 1px;
        y: 0;
        background: Theme.line;
        visible: !root.first;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            min-width: 0px;
            opacity: root.dim ? 0.5 : 1;
            Text {
                text: root.label;
                color: Theme.fg;
                font-size: 13px;
                font-weight: 500;
                overflow: elide;
            }
            // 说明只占一行，放不下就省略：Slint 1.18 在滚动区里改窗口宽度后，折行文字的高度不跟着重算，会盖到下一行
            if root.note != "": Text {
                text: root.note;
                color: Theme.mut;
                font-size: 11.5px;
                overflow: elide;
            }
        }
        @children
    }
}

// 设置卡片里的小标题（把同一类的几行分成一组）
component GroupLabel inherits Rectangle {
    in property <string> text;
    in property <string> note;
    height: 34px;
    Rectangle {
        height: 1px;
        y: 0;
        background: Theme.line;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        spacing: 8px;
        Text {
            text: root.text;
            color: Theme.mut;
            font-size: 11.5px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            text: root.note;
            color: Theme.mut;
            font-size: 11.5px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

// 进页面时淡入
component Page inherits Rectangle {
    property <bool> shown: false;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: 220ms; easing: ease-out; }
    init => {
        root.shown = true;
    }
}

// 页面标题：上面一行小字，下面大标题，右边放按钮
component PageHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> note;
    spacing: 16px;
    padding-bottom: 2px;
    VerticalLayout {
        spacing: 4px;
        alignment: end;
        horizontal-stretch: 1;
        min-width: 0px;
        Muted {
            text: root.note;
            font-size: 13px;
        }
        Text {
            text: root.title;
            color: Theme.fg;
            font-size: 32px;
            font-weight: 600;
            letter-spacing: -0.6px;
        }
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        @children
    }
}

// ───────────────────────── 手机缩略图 ─────────────────────────

component PhonePreview inherits Rectangle {
    in property <[ModuleItem]> modules;
    in property <int> columns: 4;
    in property <int> rows: 8;
    in property <length> pad: 8px;
    in property <length> gap: 2px;
    background: Theme.phone-bg;
    border-radius: 24px;
    border-width: 1px;
    border-color: Theme.phone-line;
    property <length> cw: (root.width - 2 * root.pad) / Math.max(1, root.columns);
    property <length> ch: (root.height - 2 * root.pad) / Math.max(1, root.rows);
    for m in root.modules: Rectangle {
        x: root.pad + m.x * root.cw + root.gap;
        y: root.pad + m.y * root.ch + root.gap;
        width: m.w * root.cw - 2 * root.gap;
        height: m.h * root.ch - 2 * root.gap;
        border-radius: 7px;
        background: Theme.phone-tile;
        border-width: 1px;
        border-color: Theme.phone-line;
        if m.kind == "touchpad": Text {
            x: 6px;
            y: 4px;
            text: "触控板";
            color: Theme.phone-mut;
            font-size: 8px;
        }
        if m.kind == "voiceButton" || m.kind == "voice": VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                alignment: center;
                Icon {
                    source: m.kind == "voice" ? @image-url("../icons/text.svg") : @image-url("../icons/mic.svg");
                    tint: Theme.phone-fg;
                    size: 11px;
                }
            }
            Text {
                text: m.kind == "voice" ? "输入框" : "语音";
                color: Theme.phone-fg;
                font-size: 8px;
                horizontal-alignment: center;
            }
        }
        if m.kind == "button" && Keys.drawn(m.label): Icon {
            source: Keys.icon(m.label);
            tint: Theme.phone-fg;
            size: 11px;
        }
        if m.kind == "button" && !Keys.drawn(m.label): Text {
            width: parent.width - 4px;
            height: parent.height;
            text: m.label;
            color: Theme.phone-fg;
            font-size: 8.5px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// ───────────────────────── 表格行 ─────────────────────────

// 按键映射表的一行：按键、三种按法、今天按了几次（最常用的带个点）、按住时，点了去映射页
component KeyRow inherits Rectangle {
    in property <OverviewRow> data;
    in property <int> max-today;
    in property <bool> last;
    callback clicked();
    property <bool> top: root.data.today > 0 && root.data.today == root.max-today;
    height: 52px;
    Rectangle {
        x: 6px;
        y: 3px;
        width: parent.width - 12px;
        height: parent.height - 6px;
        border-radius: 9px;
        background: area.has-hover ? Theme.soft : transparent;
        animate background { duration: 150ms; }
    }
    if !root.last: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 12px;
        HorizontalLayout {
            horizontal-stretch: 1.3;
            min-width: 0px;
            preferred-width: 0px;
            spacing: 11px;
            VerticalLayout {
                alignment: center;
                KeyTile {
                    icon: root.data.icon;
                    glyph: root.data.glyph;
                    tone: root.data.tone;
                }
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.data.label;
                    color: Theme.fg;
                    font-size: 13px;
                    font-weight: 600;
                    overflow: elide;
                }
            }
        }
        // 连发、直通的按键：双击、长按的动作还留着，但不生效，淡一点
        for cell[ci] in [root.data.click, root.data.double, root.data.long]: HorizontalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                KeyCap {
                    text: cell;
                    opacity: (root.data.hold == 2 || root.data.hold == 3) && ci > 0 ? 0.35 : 1;
                }
            }
        }
        HorizontalLayout {
            width: 118px;
            spacing: 8px;
            alignment: start;
            Text {
                width: 30px;
                text: root.data.today;
                color: root.data.today > 0 ? Theme.fg : Theme.mut;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 64px;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.line;
                    Rectangle {
                        x: 0;
                        width: root.max-today > 0 ? parent.width * root.data.today / root.max-today : 0px;
                        height: parent.height;
                        border-radius: 2px;
                        background: root.top ? Theme.lime-dot : Theme.ink;
                        animate width { duration: 500ms; easing: ease-out; }
                    }
                }
            }
        }
        // 按住时：只说配置，不掺用量
        HorizontalLayout {
            width: 84px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Chip {
                    text: root.data.hold-name;
                    tone: root.data.hold >= 2 ? 3 : 0;
                }
            }
        }
        VerticalLayout {
            width: 20px;
            alignment: center;
            Icon {
                source: @image-url("../icons/chev-right.svg");
                tint: area.has-hover ? Theme.fg : Theme.mut;
                size: 15px;
            }
        }
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component TableHead inherits Rectangle {
    height: 36px;
    background: Theme.soft;
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.line;
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 12px;
        Text {
            horizontal-stretch: 1.3;
            min-width: 0px;
            preferred-width: 0px;
            text: "按键";
            color: Theme.mut;
            font-size: 12px;
            vertical-alignment: center;
        }
        for title in ["单击", "双击", "长按"]: Text {
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            text: title;
            color: Theme.mut;
            font-size: 12px;
            vertical-alignment: center;
        }
        Text {
            width: 118px;
            text: "今天按了";
            color: Theme.mut;
            font-size: 12px;
            vertical-alignment: center;
        }
        Text {
            width: 84px;
            text: "按住时";
            color: Theme.mut;
            font-size: 12px;
            vertical-alignment: center;
        }
        Rectangle {
            width: 20px;
        }
    }
}

component FeedRow inherits Rectangle {
    in property <RecentItem> item;
    in property <bool> first;
    property <bool> shown: false;
    height: 56px;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: 300ms; easing: ease-out; }
    init => {
        root.shown = true;
    }
    if !root.first: Rectangle {
        y: 0;
        height: 1px;
        background: Theme.line;
    }
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            KeyTile {
                size: 30px;
                icon: root.item.icon;
                glyph: root.item.glyph;
                tone: root.item.tone;
                kind: root.item.kind == "voice" ? "voiceButton" : "button";
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.item.count > 1 ? root.item.title + " ×" + root.item.count : root.item.title;
                color: Theme.fg;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.item.detail;
                color: Theme.mut;
                font-size: 12.5px;
                overflow: elide;
            }
        }
        Text {
            text: root.item.time;
            color: Theme.mut;
            font-size: 11.5px;
            vertical-alignment: center;
        }
    }
}

// ───────────────────────── 首页 ─────────────────────────

component Stat inherits HorizontalLayout {
    in property <image> icon;
    in property <string> value;
    in property <string> label;
    // 窗口窄时文字可以收成省略号（设备名可能很长）
    in property <bool> shrink: false;
    in property <color> value-color: Theme.fg;
    spacing: 8px;
    Icon {
        source: root.icon;
        size: 16px;
        tint: root.value-color;
    }
    Text {
        text: root.value;
        color: root.value-color;
        font-size: 19px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: root.shrink ? TextOverflow.elide : TextOverflow.clip;
    }
    Text {
        text: root.label;
        color: Theme.fg2;
        font-size: 13px;
        vertical-alignment: center;
        overflow: root.shrink ? TextOverflow.elide : TextOverflow.clip;
    }
    @children
}

// 连接自检的一项：打勾（好了）、警告（有问题）、空圈（还不知道）
component CheckRow inherits HorizontalLayout {
    // 1 好了、0 有问题、-1 不知道
    in property <int> state;
    in property <string> title;
    in property <string> note;
    spacing: 10px;
    padding-top: 7px;
    padding-bottom: 7px;
    VerticalLayout {
        alignment: start;
        padding-top: 1px;
        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: root.state == 1 ? Theme.lime : root.state == 0 ? Theme.warn-bg : transparent;
            border-width: root.state < 0 ? 1.5px : 0px;
            border-color: Theme.line2;
            if root.state >= 0: Icon {
                x: 3px;
                size: 14px;
                source: root.state == 1 ? @image-url("../icons/check.svg") : @image-url("../icons/warn.svg");
                tint: root.state == 1 ? Theme.lime-fg : Theme.warn-fg;
            }
        }
    }
    VerticalLayout {
        spacing: 2px;
        horizontal-stretch: 1;
        min-width: 0px;
        Text {
            text: root.title;
            color: Theme.fg;
            font-size: 13px;
            font-weight: 600;
        }
        if root.note != "": Muted {
            text: root.note;
            font-size: 12px;
        }
    }
}

// 首页「连接手机」里局域网那一项：绑过手机就写绑了谁、在不在线；没绑过提示也可以扫码，旁边给个「显示二维码」
component LanCheck inherits HorizontalLayout {
    in property <[LanPhoneRow]> phones;
    in property <bool> up;
    callback pair();
    spacing: 10px;
    CheckRow {
        horizontal-stretch: 1;
        state: root.up ? 1 : -1;
        title: root.phones.length == 0 ? "局域网（可选）" : "局域网：已绑定 " + root.phones[0].name + (root.phones.length > 1 ? " 等 " + root.phones.length + " 部" : "");
        note: root.phones.length == 0 ? "在「设置 → 扫码连接」里绑定" : root.up ? "在线，正在连上…" : "不在线：连同一个网络就会连上";
    }
    if root.phones.length == 0: VerticalLayout {
        alignment: center;
        GhostButton {
            small: true;
            text: "显示二维码";
            has-icon: true;
            icon: @image-url("../icons/qr.svg");
            clicked => {
                root.pair();
            }
        }
    }
}

component HomePage inherits Page {
    in property <string> greeting;
    in property <string> date-text;
    in property <bool> core-running;
    in property <bool> connected;
    in property <string> device;
    in property <string> since-text;
    in property <int> today-presses;
    in property <int> today-voice;
    in property <[OverviewRow]> rows;
    in property <int> max-today;
    in property <[RecentItem]> recent;
    // 手机布局卡片：第一页（主页）
    in property <[ModuleItem]> home-modules;
    in property <string> home-page-name;
    in property <int> columns;
    in property <int> grid-rows;
    in property <int> page-count;
    // 手机电量（-1 = 不知道）、当前方案
    in property <int> battery-level: -1;
    in property <bool> battery-charging;
    in property <string> profile-name;
    // 同步：0 未连接 1 已同步 2 等手机确认 3 手机没有确认
    in property <int> sync-state;
    in property <string> sync-text;
    // 连接自检：1 好了、0 有问题、-1 不知道
    in property <int> check-bluetooth: -1;
    in property <int> check-paired: -1;
    in property <string> bluetooth-note;
    in property <string> paired-note;
    // 扫码绑定过的手机（局域网）
    in property <[LanPhoneRow]> lan-phones;
    // 第一次用：问一句要不要开机自启
    in property <bool> ask-autostart;
    // 窗口窄：数字条里不写连了多久（手机圆标的浮层里有）
    in property <bool> narrow;
    callback open-folder();
    callback start-core();
    callback goto(int);
    callback open-key(int);
    callback autostart-answer(bool);
    callback recheck();
    callback open-tutorial();
    // 「显示二维码」：扫码绑定手机
    callback lan-pair();
    property <bool> trouble: false;
    // 用局域网的人（绑过手机）：蓝牙那几项没过不算出问题，显示成灰圈
    property <bool> uses-lan: root.lan-phones.length > 0;
    property <bool> lan-up: root.core-running && root.uses-lan && (root.lan-phones[0].online || (root.lan-phones.length > 1 && root.lan-phones[1].online));
    property <bool> low: root.battery-level >= 0 && root.battery-level <= 20 && !root.battery-charging;
    VerticalLayout {
        alignment: start;
        spacing: 16px;
        PageHead {
            note: root.date-text;
            title: root.greeting;
            GhostButton {
                text: "配置文件夹";
                has-icon: true;
                icon: @image-url("../icons/folder.svg");
                clicked => {
                    root.open-folder();
                }
            }
            GhostButton {
                text: "使用教程";
                has-icon: true;
                icon: @image-url("../icons/help.svg");
                clicked => {
                    root.open-tutorial();
                }
            }
        }
        // 第一次用：问一句开机自启（关掉就不再问）
        if root.ask-autostart: Card {
            HorizontalLayout {
                padding: 14px;
                padding-left: 16px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        source: @image-url("../icons/power.svg");
                        size: 17px;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    min-width: 0px;
                    spacing: 2px;
                    Text {
                        text: "开机时自动启动后台？";
                        color: Theme.fg;
                        font-size: 13.5px;
                        font-weight: 600;
                    }
                    Muted {
                        text: "开了以后不开这个窗口，手机也能连。在「设置」里能改。";
                    }
                }
                VerticalLayout {
                    alignment: center;
                    GhostButton {
                        small: true;
                        text: "不用了";
                        clicked => {
                            root.autostart-answer(false);
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    PrimaryButton {
                        text: "开机自启";
                        clicked => {
                            root.autostart-answer(true);
                        }
                    }
                }
            }
        }
        // 数字条：连接、电量、今天的用量（内存只在侧栏显示）
        Rectangle {
            height: 56px;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.soft;
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 18px;
                // 设备名太长就省略（窄的时候先收它）
                Stat {
                    icon: @image-url("../icons/phone.svg");
                    shrink: true;
                    horizontal-stretch: 0;
                    min-width: 0px;
                    max-width: 340px;
                    value: root.connected ? root.device : root.core-running ? "未连接" : "后台未运行";
                    label: root.connected && !root.narrow ? root.since-text : "";
                }
                if root.connected && root.battery-level >= 0: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 1px;
                        height: 20px;
                        background: Theme.line2;
                    }
                }
                if root.connected && root.battery-level >= 0: Stat {
                    icon: root.battery-charging ? @image-url("../icons/bolt.svg") : @image-url("../icons/battery.svg");
                    value: root.battery-level + "%";
                    value-color: root.low ? Theme.low : Theme.fg;
                    label: root.battery-charging ? "充电中" : root.low ? "电量低" : "手机电量";
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 1px;
                        height: 20px;
                        background: Theme.line2;
                    }
                }
                Stat {
                    icon: @image-url("../icons/kbd.svg");
                    value: root.today-presses;
                    label: "次按键 · 今天";
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 1px;
                        height: 20px;
                        background: Theme.line2;
                    }
                }
                Stat {
                    icon: @image-url("../icons/mic.svg");
                    value: root.today-voice;
                    label: "字语音 · 今天";
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
        }
        // 没连上：三步自检
        if !root.connected: Card {
            VerticalLayout {
                alignment: start;
                CardHead {
                    title: root.core-running ? "连接手机" : "后台未运行";
                    icon: root.uses-lan ? @image-url("../icons/wifi.svg") : @image-url("../icons/bluetooth.svg");
                    VerticalLayout {
                        alignment: center;
                        Chip {
                            dot: true;
                            tone: 2;
                            text: "未连接";
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    if root.core-running: VerticalLayout {
                        alignment: center;
                        GhostButton {
                            small: true;
                            text: "重新检查";
                            clicked => {
                                root.recheck();
                            }
                        }
                    }
                    if !root.core-running: VerticalLayout {
                        alignment: center;
                        PrimaryButton {
                            text: "启动后台";
                            has-icon: true;
                            icon: @image-url("../icons/power.svg");
                            clicked => {
                                root.start-core();
                            }
                        }
                    }
                }
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 12px;
                    if !root.core-running: Muted {
                        text: "后台没在运行，手机连不上。";
                        font-size: 12.5px;
                    }
                    // 用局域网的人：局域网放第一项
                    if root.uses-lan: LanCheck {
                        phones: root.lan-phones;
                        up: root.lan-up;
                        pair => {
                            root.lan-pair();
                        }
                    }
                    CheckRow {
                        state: root.uses-lan && root.check-bluetooth == 0 ? -1 : root.check-bluetooth;
                        title: root.check-bluetooth == 0 ? "电脑蓝牙没开" : "电脑蓝牙已打开";
                        note: root.uses-lan && root.check-bluetooth == 0 ? "只用局域网的话可以不管" : root.bluetooth-note;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        CheckRow {
                            horizontal-stretch: 1;
                            state: root.uses-lan && root.check-paired == 0 ? -1 : root.check-paired;
                            title: root.check-paired == 0 ? "还没和手机配对" : "已和手机配对";
                            note: root.uses-lan && root.check-paired == 0 ? "只用局域网的话可以不管" : root.paired-note;
                        }
                        // 没配对：显示二维码，手机蒜鸟扫一下就发起蓝牙配对
                        if root.check-paired == 0 && !root.uses-lan: VerticalLayout {
                            alignment: center;
                            GhostButton {
                                small: true;
                                text: "扫码配对";
                                has-icon: true;
                                icon: @image-url("../icons/qr.svg");
                                clicked => {
                                    root.lan-pair();
                                }
                            }
                        }
                    }
                    CheckRow {
                        state: -1;
                        title: "手机上打开蒜鸟";
                        note: root.uses-lan ? "两边都开着，就会自动连上" : "第一次要扫码配对或选这台电脑";
                    }
                    // 还没用局域网：放最后，提示也可以扫码
                    if !root.uses-lan: LanCheck {
                        phones: root.lan-phones;
                        up: false;
                        pair => {
                            root.lan-pair();
                        }
                    }
                    HorizontalLayout {
                        padding-top: 4px;
                        alignment: start;
                        Rectangle {
                            height: 26px;
                            width: trouble-text.preferred-width + 22px;
                            border-radius: 7px;
                            background: trouble-area.has-hover ? Theme.hover : transparent;
                            HorizontalLayout {
                                padding-left: 4px;
                                spacing: 4px;
                                Icon {
                                    source: @image-url("../icons/help.svg");
                                    size: 14px;
                                    tint: Theme.fg2;
                                }
                                trouble-text := Text {
                                    text: root.trouble ? "收起" : "连不上？";
                                    color: Theme.fg2;
                                    font-size: 12.5px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                            trouble-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.trouble = !root.trouble;
                                }
                            }
                        }
                    }
                    if root.trouble: VerticalLayout {
                        padding-top: 6px;
                        spacing: 4px;
                        Muted {
                            text: "· 电脑：打开蓝牙；没配对就点「扫码配对」让手机扫。";
                        }
                        Muted {
                            text: "· 手机：打开蒜鸟，右上角「···」→「选择电脑」。";
                        }
                        Muted {
                            text: "· 局域网：两边连同一个网络；还不行就重新扫码。";
                        }
                        Muted {
                            text: "· 还不行：两边蓝牙关了再开，或退出蒜鸟再打开。";
                        }
                    }
                }
            }
        }
        // 按键映射表
        Card {
            VerticalLayout {
                alignment: start;
                CardHead {
                    title: "按键映射";
                    icon: @image-url("../icons/kbd.svg");
                    VerticalLayout {
                        alignment: center;
                        Chip {
                            tone: 1;
                            text: "方案：" + root.profile-name;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.page-count > 1 ? "所有页面 · 按今天用的次数排" : "按今天用的次数排";
                        color: Theme.mut;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                        min-width: 0px;
                        horizontal-stretch: 0.001;
                    }
                    VerticalLayout {
                        alignment: center;
                        GhostButton {
                            small: true;
                            text: "查看全部";
                            clicked => {
                                root.goto(3);
                            }
                        }
                    }
                }
                TableHead { }
                for row[i] in root.rows: KeyRow {
                    data: row;
                    max-today: root.max-today;
                    last: i == root.rows.length - 1;
                    clicked => {
                        root.open-key(i);
                    }
                }
                if root.rows.length == 0: Text {
                    text: "布局里还没有按键。到「布局」里添加按键。";
                    color: Theme.mut;
                    font-size: 12.5px;
                    horizontal-alignment: center;
                    height: 64px;
                    vertical-alignment: center;
                }
            }
        }
        HorizontalLayout {
            spacing: 16px;
            // 手机布局（两列等宽：min / preferred 都是 0，宽度只按 stretch 平分，不被内容撑开）
            Card {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                VerticalLayout {
                    alignment: start;
                    CardHead {
                        title: "手机布局";
                        icon: @image-url("../icons/grid.svg");
                        VerticalLayout {
                            alignment: center;
                            Chip {
                                text: root.columns + " 列 × " + root.grid-rows + " 行";
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        VerticalLayout {
                            alignment: center;
                            GhostButton {
                                small: true;
                                text: "编辑布局";
                                clicked => {
                                    root.goto(1);
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-bottom: 16px;
                        spacing: 18px;
                        PhonePreview {
                            width: 140px;
                            height: 250px;
                            modules: root.home-modules;
                            columns: root.columns;
                            rows: root.grid-rows;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            alignment: start;
                            for info[i] in [
                                { k: "第一页", v: root.home-page-name },
                                { k: "这一页的模块", v: root.home-modules.length + " 个" },
                                { k: "页数", v: root.page-count + " 页" },
                                { k: "同步", v: root.sync-text },
                            ]: Rectangle {
                                height: 40px;
                                if i > 0: Rectangle {
                                    y: 0;
                                    height: 1px;
                                    background: Theme.line;
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: info.k;
                                        color: Theme.mut;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: info.v;
                                        color: i != 3 ? Theme.fg : root.sync-state == 1 ? Theme.tone-fg(4) : root.sync-state == 3 ? Theme.warn-fg : Theme.mut;
                                        font-size: 13px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // 最近动作
            Card {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                VerticalLayout {
                    alignment: start;
                    CardHead {
                        title: "最近动作";
                        icon: @image-url("../icons/act.svg");
                        VerticalLayout {
                            alignment: center;
                            Chip {
                                dot: true;
                                tone: root.connected ? 1 : 0;
                                text: root.connected ? "实时" : "未连接";
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-bottom: 8px;
                        alignment: start;
                        for item[i] in root.recent: FeedRow {
                            item: item;
                            first: i == 0;
                        }
                        if root.recent.length == 0: Text {
                            text: "手机上的操作会显示在这里。";
                            color: Theme.mut;
                            font-size: 12.5px;
                            height: 80px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}

// ───────────────────────── 布局 ─────────────────────────

// 「添加模块」里的一块
component PaletteItem inherits Rectangle {
    in property <string> k;
    in property <string> title;
    in property <string> note;
    callback clicked();
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    height: 64px;
    border-radius: 12px;
    border-width: 1px;
    border-color: add.has-hover ? Theme.line2 : Theme.line;
    background: add.has-hover ? Theme.soft : Theme.win;
    animate background, border-color { duration: 150ms; }
    HorizontalLayout {
        padding: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            KeyTile {
                size: 30px;
                kind: root.k;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: Theme.fg;
                font-size: 13px;
                font-weight: 600;
            }
            Text {
                text: root.note;
                color: Theme.mut;
                font-size: 11.5px;
                overflow: elide;
            }
        }
    }
    add := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// 页面标签：选中的是黑底
component PageTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 32px;
    width: tab-text.preferred-width + 28px;
    border-radius: 16px;
    background: root.selected ? Theme.ink : tab.has-hover ? Theme.hover : Theme.win;
    border-width: root.selected ? 0px : 1px;
    border-color: Theme.line2;
    animate background { duration: 200ms; }
    tab-text := Text {
        x: 14px;
        height: parent.height;
        text: root.text;
        color: root.selected ? Theme.ink-fg : Theme.fg;
        font-size: 13px;
        font-weight: 600;
        vertical-alignment: center;
    }
    tab := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component LayoutPage inherits Page {
    in property <[string]> page-names;
    in property <int> page-index;
    in property <int> columns;
    in property <int> rows;
    in property <[ModuleItem]> modules;
    in property <int> selected;
    in property <int> sel-kind;
    in-out property <string> sel-label;
    in property <float> sel-x;
    in property <float> sel-y;
    in property <float> sel-w;
    in property <float> sel-h;
    in property <int> sel-hold;
    // 选中的按键能不能选「直通」（单击正好是一个按键或组合键）
    in property <bool> sel-passthrough-ok;
    in-out property <string> page-name;
    // 手机画面多高：按窗口高度算好，整部手机一屏放得下
    in property <length> canvas-height: 694px;
    callback select-page(int);
    callback add-page();
    callback rename-page(string);
    callback delete-page();
    callback open-grid();
    callback select-module(int);
    // 拖动中：第几个模块、拖的哪条边（0 = 整体移动）、鼠标移动了几格、是不是按着 Alt（不对齐）
    callback drag-preview(int, int, float, float, bool) -> Ghost;
    // 松手：放到虚影那里（和别的模块互换时 Rust 一起挪）
    callback place-module(int, float, float, float, float);
    // 松手时那里放不下
    callback drag-failed();
    callback add-module(int);
    callback delete-module();
    callback kind-changed(int);
    callback label-changed(string);
    // 属性面板里直接输入的数：左、上、宽、高
    callback rect-changed(float, float, float, float);
    // 属性面板里的加减：field 0 左、1 上、2 宽、3 高；dir 是 +1 / -1
    callback nudge(int, int);
    callback hold-changed(int);
    callback hold-blocked();
    callback edit-mapping();

    // 正在拖第几个模块（-1 = 没在拖）、拖的哪条边（0 = 整体移动）
    property <int> drag-index: -1;
    property <int> drag-edges: 0;
    property <Ghost> ghost;
    // 手机外壳的大小（按画布高度等比缩放，比例和原来的 306 × 632 一样）
    property <length> phone-h: root.canvas-height - 62px;
    property <length> phone-w: root.phone-h * 306 / 632;
    property <float> k: root.phone-h / 632px;
    // 选中模块的八个抓手：e 是要动的边（左 1、右 2、上 4、下 8，角是两条边相加），ax、ay 是在模块上的相对位置。
    // 角放在后面，压在边上面
    property <[{ e: int, ax: float, ay: float }]> handles: [
        { e: 4, ax: 0.5, ay: 0 },
        { e: 8, ax: 0.5, ay: 1 },
        { e: 1, ax: 0, ay: 0.5 },
        { e: 2, ax: 1, ay: 0.5 },
        { e: 5, ax: 0, ay: 0 },
        { e: 6, ax: 1, ay: 0 },
        { e: 9, ax: 0, ay: 1 },
        { e: 10, ax: 1, ay: 1 },
    ];

    // 松手：拖过就放到虚影那里（放不下提示一下）；只是点了一下什么都不做
    function finish-drag() {
        if (root.drag-index >= 0) {
            if (root.ghost.ok) {
                root.place-module(root.drag-index, root.ghost.x, root.ghost.y, root.ghost.w, root.ghost.h);
            } else {
                root.drag-failed();
            }
        }
        root.drag-index = -1;
    }

    VerticalLayout {
        alignment: start;
        spacing: 12px;
        PageHead {
            title: "布局";
            note: "拖动换位置，拖边角改大小，自动保存";
        }
        // 页面标签单独一行（页面多了折到下一行，不挤标题）
        FlexboxLayout {
            spacing: 6px;
            cross-axis-alignment: center;
            for name[i] in root.page-names: PageTab {
                text: name;
                selected: i == root.page-index;
                clicked => {
                    root.select-page(i);
                }
            }
            Rectangle {
                height: 32px;
                width: new-page-text.preferred-width + 40px;
                border-radius: 16px;
                border-width: 1px;
                border-color: Theme.line2;
                background: new-page.has-hover ? Theme.hover : Theme.win;
                animate background { duration: 150ms; }
                Icon {
                    x: 11px;
                    size: 14px;
                    source: @image-url("../icons/plus.svg");
                    tint: Theme.fg2;
                }
                new-page-text := Text {
                    x: 29px;
                    height: parent.height;
                    text: "新页面";
                    color: Theme.fg2;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                new-page := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.add-page();
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 16px;
            // 画布：和手机一样的外观，按窗口高度缩放
            Card {
                width: root.phone-w + 54px;
                height: root.canvas-height;
                background: Theme.soft;
                Text {
                    x: 16px;
                    y: 14px;
                    text: "手机画面";
                    color: Theme.mut;
                    font-size: 12px;
                }
                // 拖的时候提醒一下 Alt 的用法
                Text {
                    x: parent.width - self.width - 16px;
                    y: 14px;
                    text: root.drag-index >= 0 ? "按住 Alt 不对齐" : "";
                    color: Theme.mut;
                    font-size: 12px;
                }
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: 40px;
                    width: root.phone-w;
                    height: root.phone-h;
                    background: Theme.phone-bg;
                    border-radius: 40px * root.k;
                    border-width: 1px;
                    border-color: Theme.phone-line;
                    canvas := Rectangle {
                        x: 14px * root.k;
                        y: 18px * root.k;
                        width: parent.width - 28px * root.k;
                        height: parent.height - 36px * root.k;
                        property <length> cell-w: self.width / root.columns;
                        property <length> cell-h: self.height / root.rows;
                        for r in root.rows - 1: Rectangle {
                            x: 0;
                            y: (r + 1) * canvas.cell-h;
                            width: canvas.width;
                            height: 1px;
                            background: Theme.phone-line.with-alpha(0.6);
                        }
                        for c in root.columns - 1: Rectangle {
                            x: (c + 1) * canvas.cell-w;
                            y: 0;
                            width: 1px;
                            height: canvas.height;
                            background: Theme.phone-line.with-alpha(0.6);
                        }
                        // 拖动时再淡淡地画出 1/4 格的线，看得出会对齐到哪
                        if root.drag-index >= 0: Rectangle {
                            for q in root.rows * 4: Rectangle {
                                x: 0;
                                y: q * canvas.cell-h / 4;
                                width: canvas.width;
                                height: 1px;
                                background: Theme.phone-line.with-alpha(Math.mod(q, 4) == 0 ? 0 : 0.35);
                            }
                            for q in root.columns * 4: Rectangle {
                                x: q * canvas.cell-w / 4;
                                y: 0;
                                width: 1px;
                                height: canvas.height;
                                background: Theme.phone-line.with-alpha(Math.mod(q, 4) == 0 ? 0 : 0.35);
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.select-module(-1);
                            }
                        }
                        for m[i] in root.modules: Rectangle {
                            x: m.x * canvas.cell-w + 3px;
                            y: m.y * canvas.cell-h + 3px;
                            width: m.w * canvas.cell-w - 6px;
                            height: m.h * canvas.cell-h - 6px;
                            border-radius: Math.min(13px, Math.min(self.width, self.height) / 3);
                            background: Theme.phone-tile;
                            border-width: i == root.selected ? 2px : 1px;
                            border-color: i == root.selected ? Theme.phone-fg : Theme.phone-line;
                            clip: true;
                            // 整体拖走时原地留个淡影
                            opacity: root.drag-index == i && root.drag-edges == 0 ? 0.35 : 1;
                            animate opacity { duration: 150ms; }
                            if m.kind == "touchpad": Text {
                                x: 10px;
                                y: 8px;
                                text: "触控板";
                                color: Theme.phone-mut;
                                font-size: 11px;
                                font-weight: 700;
                            }
                            if m.kind != "touchpad": VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                if m.kind != "button" || Keys.drawn(m.label): HorizontalLayout {
                                    alignment: center;
                                    Icon {
                                        source: m.kind == "voiceButton" ? @image-url("../icons/mic.svg") : m.kind == "voice" ? @image-url("../icons/text.svg") : Keys.icon(m.label);
                                        tint: Theme.phone-fg;
                                        size: 18px;
                                    }
                                }
                                // 不到一格高的图标键只留图标；图标下面的小字放不下就省略
                                if (m.kind == "button" && !Keys.drawn(m.label)) || m.h * canvas.cell-h > 60px: Text {
                                    text: m.kind == "button" && Keys.drawn(m.label) && (m.label == "↑" || m.label == "↓" || m.label == "←" || m.label == "→") ? "" : m.kind == "button" ? m.label : m.kind == "voice" ? "语音输入框" : "语音按钮";
                                    color: m.kind == "button" && !Keys.drawn(m.label) ? Theme.phone-fg : Theme.phone-mut;
                                    font-size: m.kind == "button" && !Keys.drawn(m.label) ? (m.w * canvas.cell-w < 52px ? 11px : 14px) : 10.5px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    wrap: m.kind == "button" && !Keys.drawn(m.label) ? TextWrap.word-wrap : TextWrap.no-wrap;
                                    overflow: elide;
                                }
                            }
                            // 拖中间：整体移动（拖动超过 4 像素才算，免得点一下就动）
                            TouchArea {
                                mouse-cursor: move;
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down) {
                                        if (event.button == PointerEventButton.left) {
                                            root.select-module(i);
                                        }
                                    } else if (event.kind == PointerEventKind.move) {
                                        if (self.pressed && (root.drag-index == i || Math.abs(self.mouse-x - self.pressed-x) + Math.abs(self.mouse-y - self.pressed-y) > 4px)) {
                                            root.drag-index = i;
                                            root.drag-edges = 0;
                                            root.ghost = root.drag-preview(i, 0, (self.mouse-x - self.pressed-x) / canvas.cell-w, (self.mouse-y - self.pressed-y) / canvas.cell-h, event.modifiers.alt);
                                        }
                                    } else if (event.kind == PointerEventKind.up) {
                                        root.finish-drag();
                                    } else if (event.kind == PointerEventKind.cancel) {
                                        root.drag-index = -1;
                                    }
                                }
                            }
                        }
                        // 互换：被换走的模块会去哪（虚线框）
                        if root.drag-index >= 0: Rectangle {
                            for a in root.ghost.moved: Rectangle {
                                x: a.x * canvas.cell-w + 3px;
                                y: a.y * canvas.cell-h + 3px;
                                width: a.w * canvas.cell-w - 6px;
                                height: a.h * canvas.cell-h - 6px;
                                border-radius: Math.min(13px, Math.min(self.width, self.height) / 3);
                                border-width: 1.5px;
                                border-color: Theme.phone-fg.with-alpha(0.55);
                                background: Theme.lime-dot.with-alpha(0.12);
                                animate x, y, width, height { duration: 110ms; easing: ease-out; }
                            }
                        }
                        // 拖动时：松手后会在哪（放不下是红框）
                        if root.drag-index >= 0: Rectangle {
                            x: root.ghost.x * canvas.cell-w + 3px;
                            y: root.ghost.y * canvas.cell-h + 3px;
                            width: root.ghost.w * canvas.cell-w - 6px;
                            height: root.ghost.h * canvas.cell-h - 6px;
                            border-radius: Math.min(13px, Math.min(self.width, self.height) / 3);
                            border-width: 2px;
                            border-color: root.ghost.ok ? Theme.phone-fg : Theme.red;
                            background: root.ghost.ok ? Theme.lime-dot.with-alpha(0.25) : Theme.red.with-alpha(0.12);
                            animate x, y, width, height { duration: 110ms; easing: ease-out; }
                            animate border-color, background { duration: 150ms; }
                        }
                        // 选中的模块：四条边、四个角都能拖着改大小。抓手钉在模块原来的位置（拖动时不跟着跑），
                        // 拖的时候藏起来，只看虚影
                        if root.selected >= 0 && root.selected < root.modules.length: Rectangle {
                            property <ModuleItem> sm: root.modules[root.selected];
                            property <length> mx: self.sm.x * canvas.cell-w + 3px;
                            property <length> my: self.sm.y * canvas.cell-h + 3px;
                            property <length> mw: self.sm.w * canvas.cell-w - 6px;
                            property <length> mh: self.sm.h * canvas.cell-h - 6px;
                            for hd in root.handles: TouchArea {
                                property <bool> corner: hd.ax != 0.5 && hd.ay != 0.5;
                                // 上下两条边
                                property <bool> across: hd.ax == 0.5;
                                width: self.corner ? 16px : self.across ? Math.max(0px, parent.mw - 16px) : 10px;
                                height: self.corner ? 16px : self.across ? 10px : Math.max(0px, parent.mh - 16px);
                                x: parent.mx + hd.ax * parent.mw - self.width / 2;
                                y: parent.my + hd.ay * parent.mh - self.height / 2;
                                mouse-cursor: hd.e == 5 || hd.e == 10 ? MouseCursor.nwse-resize : hd.e == 6 || hd.e == 9 ? MouseCursor.nesw-resize : self.across ? MouseCursor.ns-resize : MouseCursor.ew-resize;
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.move) {
                                        if (self.pressed) {
                                            root.drag-index = root.selected;
                                            root.drag-edges = hd.e;
                                            root.ghost = root.drag-preview(root.selected, hd.e, (self.mouse-x - self.pressed-x) / canvas.cell-w, (self.mouse-y - self.pressed-y) / canvas.cell-h, event.modifiers.alt);
                                        }
                                    } else if (event.kind == PointerEventKind.up) {
                                        root.finish-drag();
                                    } else if (event.kind == PointerEventKind.cancel) {
                                        root.drag-index = -1;
                                    }
                                }
                                Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: parent.corner ? 10px : parent.across ? 18px : 6px;
                                    height: parent.corner ? 10px : parent.across ? 6px : 18px;
                                    border-radius: 3px;
                                    background: parent.has-hover || parent.pressed ? Theme.lime-dot : Theme.phone-tile;
                                    border-width: 1.5px;
                                    border-color: Theme.phone-fg;
                                    opacity: root.drag-index >= 0 ? 0 : 1;
                                    animate background, opacity { duration: 120ms; }
                                }
                            }
                        }
                        // 拖动时旁边的小黑条：现在多大、在哪、和谁互换
                        if root.drag-index >= 0: Rectangle {
                            property <length> gx: root.ghost.x * canvas.cell-w;
                            property <length> gy: root.ghost.y * canvas.cell-h;
                            property <length> gw: root.ghost.w * canvas.cell-w;
                            property <length> gh: root.ghost.h * canvas.cell-h;
                            width: Math.min(canvas.width, size-text.preferred-width + 18px);
                            height: 22px;
                            x: Math.max(0px, Math.min(canvas.width - self.width, self.gx + (self.gw - self.width) / 2));
                            y: self.gy + self.gh + 4px + self.height <= canvas.height ? self.gy + self.gh + 4px : Math.max(0px, self.gy - self.height - 4px);
                            border-radius: 7px;
                            background: root.ghost.ok ? Theme.ink : Theme.red;
                            animate x, y { duration: 110ms; easing: ease-out; }
                            size-text := Text {
                                width: parent.width;
                                height: parent.height;
                                text: root.ghost.ok ? root.ghost.label : "放不下";
                                color: Theme.ink-fg;
                                font-size: 11.5px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
            VerticalLayout {
                spacing: 16px;
                alignment: start;
                horizontal-stretch: 1;
                min-width: 0px;
                // 模块属性
                Card {
                    VerticalLayout {
                        alignment: start;
                        CardHead {
                            title: root.selected < 0 ? "没有选中模块" : "模块属性";
                            icon: @image-url("../icons/sliders.svg");
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            if root.selected >= 0: VerticalLayout {
                                alignment: center;
                                Chip {
                                    text: root.sel-kind == 0 ? "按键" : root.sel-kind == 1 ? "触控板" : root.sel-kind == 2 ? "语音输入框" : "语音按钮";
                                }
                            }
                        }
                        if root.selected < 0: VerticalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-bottom: 16px;
                            Muted {
                                text: "点左边的模块编辑；按住 Alt 拖可以不对齐格子。";
                                font-size: 13px;
                            }
                        }
                        if root.selected >= 0: VerticalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-bottom: 16px;
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    width: 84px;
                                    text: "类型";
                                    color: Theme.mut;
                                    font-size: 12.5px;
                                    vertical-alignment: center;
                                }
                                Select {
                                    model: ["按键", "触控板", "语音输入框", "语音按钮"];
                                    current-index: root.sel-kind;
                                    selected(k) => {
                                        root.kind-changed(k);
                                    }
                                }
                            }
                            if root.sel-kind == 0: HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    width: 84px;
                                    text: "按键上的字";
                                    color: Theme.mut;
                                    font-size: 12.5px;
                                    vertical-alignment: center;
                                }
                                Field {
                                    placeholder: "按键上显示的字";
                                    text <=> root.sel-label;
                                    edited(t) => {
                                        root.label-changed(t);
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                Text {
                                    width: 84px;
                                    text: "位置";
                                    color: Theme.mut;
                                    font-size: 12.5px;
                                    vertical-alignment: center;
                                }
                                NumberField {
                                    prefix: "左";
                                    value: root.sel-x;
                                    minus => {
                                        root.nudge(0, -1);
                                    }
                                    plus => {
                                        root.nudge(0, 1);
                                    }
                                    typed(v) => {
                                        root.rect-changed(v, root.sel-y, root.sel-w, root.sel-h);
                                    }
                                }
                                NumberField {
                                    prefix: "上";
                                    value: root.sel-y;
                                    minus => {
                                        root.nudge(1, -1);
                                    }
                                    plus => {
                                        root.nudge(1, 1);
                                    }
                                    typed(v) => {
                                        root.rect-changed(root.sel-x, v, root.sel-w, root.sel-h);
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                Text {
                                    width: 84px;
                                    text: "大小";
                                    color: Theme.mut;
                                    font-size: 12.5px;
                                    vertical-alignment: center;
                                }
                                NumberField {
                                    prefix: "宽";
                                    value: root.sel-w;
                                    minus => {
                                        root.nudge(2, -1);
                                    }
                                    plus => {
                                        root.nudge(2, 1);
                                    }
                                    typed(v) => {
                                        root.rect-changed(root.sel-x, root.sel-y, v, root.sel-h);
                                    }
                                }
                                NumberField {
                                    prefix: "高";
                                    value: root.sel-h;
                                    minus => {
                                        root.nudge(3, -1);
                                    }
                                    plus => {
                                        root.nudge(3, 1);
                                    }
                                    typed(v) => {
                                        root.rect-changed(root.sel-x, root.sel-y, root.sel-w, v);
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Rectangle {
                                    width: 84px;
                                }
                                Muted {
                                    text: "单位是格，回车生效，最小 0.5 格。";
                                    horizontal-stretch: 1;
                                }
                            }
                            if root.sel-kind == 0: HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    width: 84px;
                                    text: "按住时";
                                    color: Theme.mut;
                                    font-size: 12.5px;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    HorizontalLayout {
                                        alignment: start;
                                        Segmented {
                                            options: Lists.hold-modes;
                                            current: root.sel-hold;
                                            segment-width: 66px;
                                            disabled-from: root.sel-passthrough-ok ? 99 : 3;
                                            picked(i) => {
                                                root.hold-changed(i);
                                            }
                                            blocked => {
                                                root.hold-blocked();
                                            }
                                        }
                                    }
                                    Muted {
                                        text: root.sel-hold >= 0 && root.sel-hold < Lists.hold-notes.length ? Lists.hold-notes[root.sel-hold] : "";
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                padding-top: 4px;
                                if root.sel-kind == 0: PrimaryButton {
                                    text: "设置它的映射";
                                    has-icon: true;
                                    icon-after: true;
                                    icon: @image-url("../icons/arrow.svg");
                                    clicked => {
                                        root.edit-mapping();
                                    }
                                }
                                GhostButton {
                                    text: "删除这个模块";
                                    has-icon: true;
                                    icon: @image-url("../icons/trash.svg");
                                    text-color: Theme.red;
                                    clicked => {
                                        root.delete-module();
                                    }
                                }
                            }
                        }
                    }
                }
                // 添加模块
                Card {
                    VerticalLayout {
                        alignment: start;
                        CardHead {
                            title: "添加模块";
                            icon: @image-url("../icons/plus.svg");
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: "放在第一个空位，满了放到新的一页";
                                color: Theme.mut;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                                min-width: 0px;
                                horizontal-stretch: 0.001;
                            }
                        }
                        VerticalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-bottom: 16px;
                            spacing: 10px;
                            HorizontalLayout {
                                spacing: 10px;
                                PaletteItem {
                                    k: "button";
                                    title: "按键";
                                    note: "三种按法";
                                    clicked => {
                                        root.add-module(0);
                                    }
                                }
                                PaletteItem {
                                    k: "touchpad";
                                    title: "触控板";
                                    note: "移动、滚动";
                                    clicked => {
                                        root.add-module(1);
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                PaletteItem {
                                    k: "voiceButton";
                                    title: "语音按钮";
                                    note: "按住说话";
                                    clicked => {
                                        root.add-module(3);
                                    }
                                }
                                PaletteItem {
                                    k: "voice";
                                    title: "语音输入框";
                                    note: "先看再发";
                                    clicked => {
                                        root.add-module(2);
                                    }
                                }
                            }
                        }
                    }
                }
                // 这一页
                Card {
                    VerticalLayout {
                        alignment: start;
                        CardHead {
                            title: "这一页";
                            icon: @image-url("../icons/doc.svg");
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            VerticalLayout {
                                alignment: center;
                                GhostButton {
                                    small: true;
                                    text: "删除本页";
                                    enabled: root.page-names.length > 1;
                                    text-color: Theme.red;
                                    clicked => {
                                        root.delete-page();
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-bottom: 16px;
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    width: 84px;
                                    text: "页面名称";
                                    color: Theme.mut;
                                    font-size: 12.5px;
                                    vertical-alignment: center;
                                }
                                Field {
                                    placeholder: "页面名称";
                                    text <=> root.page-name;
                                    edited(t) => {
                                        root.rename-page(t);
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    width: 84px;
                                    text: "网格";
                                    color: Theme.mut;
                                    font-size: 12.5px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.columns + " 列 × " + root.rows + " 行（所有页面共用）";
                                    color: Theme.fg;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    min-width: 0px;
                                    horizontal-stretch: 1;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    GhostButton {
                                        small: true;
                                        text: "改网格…";
                                        clicked => {
                                            root.open-grid();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ───────────────────────── 映射 ─────────────────────────

// 受控的开关：自己不改状态，点了只报告想要的新状态（列表里的行会被复用，不能让开关自己记状态）
component Switch inherits Rectangle {
    in property <bool> checked;
    out property <bool> hovered: switch-area.has-hover;
    callback toggled(bool);
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? Theme.ink : Theme.line2;
    animate background { duration: 220ms; }
    Rectangle {
        x: root.checked ? 18px : 2px;
        y: 2px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.checked ? Theme.ink-fg : #ffffff;
        animate x { duration: Motion.normal; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        animate background { duration: 220ms; }
    }
    switch-area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggled(!root.checked);
        }
    }
}

// 录快捷键的状态（全局：正在录的时候主窗口的撤销快捷键让开）
export global Recorder {
    in-out property <bool> active;
    // 正在按着的修饰键，例如「Ctrl + Shift + …」
    in-out property <string> hint;
}

// 带下拉菜单的小按钮：点开列出分组的选项（分组标题不能点），选了报告选项的 key
component MenuButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <[KeyOption]> model;
    in property <length> popup-width: 260px;
    in property <length> popup-height: 360px;
    callback selected(int);
    height: 28px;
    border-radius: 8px;
    border-width: 1px;
    border-color: area.has-hover ? Theme.mut : Theme.line2;
    background: area.has-hover ? Theme.soft : Theme.win;
    animate background, border-color { duration: 150ms; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 5px;
        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                tint: Theme.fg2;
                size: 14px;
            }
        }
        Text {
            text: root.text;
            color: Theme.fg2;
            font-size: 12.5px;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Icon {
                source: @image-url("../icons/chev.svg");
                tint: Theme.mut;
                size: 12px;
            }
        }
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            popup.show();
        }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.popup-width;
        height: Math.min(root.popup-height, root.model.length * 30px + 10px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            property <bool> shown: false;
            init => {
                self.shown = true;
            }
            opacity: self.shown ? 1 : 0;
            y: self.shown ? 0px : -4px;
            animate opacity, y { duration: Motion.quick; easing: ease-out; }
            background: Theme.win;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.line2;
            Flickable {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                content-height: root.model.length * 30px + 8px;
                for option[i] in root.model: Rectangle {
                    x: 4px;
                    y: 4px + i * 30px;
                    width: parent.width - 8px;
                    height: 30px;
                    border-radius: 7px;
                    background: option.header ? transparent : pick.has-hover ? Theme.hover : transparent;
                    // 分组之间画一条细线隔开（第一组不画）
                    if option.header && i > 0: Rectangle {
                        x: 4px;
                        y: 6px;
                        width: parent.width - 8px;
                        height: 1px;
                        background: Theme.line;
                    }
                    Text {
                        x: option.header ? 8px : 12px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: option.text;
                        color: option.header ? Theme.mut : Theme.fg;
                        font-size: option.header ? 11.5px : 13px;
                        font-weight: option.header ? 600 : 400;
                        vertical-alignment: option.header ? bottom : center;
                        overflow: elide;
                    }
                    pick := TouchArea {
                        enabled: !option.header;
                        mouse-cursor: pointer;
                        clicked => {
                            root.selected(option.key);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

// 小按钮：图标 + 字（映射页工具条用）
component ToolButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked();
    height: 28px;
    border-radius: 8px;
    border-width: 1px;
    border-color: area.has-hover && root.enabled ? Theme.mut : Theme.line2;
    background: area.has-hover && root.enabled ? Theme.soft : Theme.win;
    opacity: root.enabled ? 1 : 0.45;
    animate background, border-color { duration: 150ms; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 5px;
        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                tint: Theme.fg2;
                size: 14px;
            }
        }
        Text {
            text: root.text;
            color: Theme.fg2;
            font-size: 12.5px;
            vertical-alignment: center;
        }
    }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// 进度条：青柠色的一段顺滑地变长（下载更新、安装）
component ProgressBar inherits Rectangle {
    in property <float> value;
    height: 8px;
    border-radius: 4px;
    background: Theme.line;
    Rectangle {
        x: 0;
        width: root.value <= 0 ? 0px : Math.max(parent.height, Math.min(1, root.value) * parent.width);
        border-radius: 4px;
        background: Theme.lime-dot;
        animate width { duration: 260ms; easing: ease-out; }
    }
}

// 红色按钮（卸载）：和确认框里删东西的按钮一个样子
component DangerButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: 36px;
    min-width: 96px;
    border-radius: 10px;
    background: area.pressed ? Theme.red.darker(0.2) : area.has-hover && root.enabled ? Theme.red.darker(0.1) : Theme.red;
    opacity: root.enabled ? 1 : 0.35;
    animate background { duration: 150ms; }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: root.text;
            color: #ffffff;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// 盖住整个窗口的对话框底板：深色半透明背景，中间一张卡片，出现时淡入、轻轻上移。
// Esc 关掉（dismiss）；dismissable 的（不会丢东西的）点遮罩也能关
component DialogCard inherits Rectangle {
    in property <length> card-width: 520px;
    in property <length> card-height: 280px;
    in property <bool> dismissable: true;
    // 里面有输入框自己要焦点的（起名字）设成 false；按键照样先经过这里（Esc 关）
    in property <bool> focus-self: true;
    callback dismiss();
    property <bool> shown: false;
    background: (Theme.dark ? #000000b0 : #14141460).with-alpha(self.shown ? (Theme.dark ? 0.69 : 0.38) : 0);
    animate background { duration: 160ms; easing: ease-out; }
    init => {
        self.shown = true;
        if (root.focus-self) {
            keys.focus();
        }
    }
    keys := FocusScope {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismiss();
                return accept;
            }
            return reject;
        }
        TouchArea {
            mouse-cursor: root.dismissable ? MouseCursor.pointer : MouseCursor.default;
            clicked => {
                if (root.dismissable) {
                    root.dismiss();
                }
            }
        }
        card := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + (root.shown ? 0px : 10px);
            width: Math.min(root.card-width, parent.width - 60px);
            height: Math.min(root.card-height, parent.height - 60px);
            opacity: root.shown ? 1 : 0;
            animate opacity, y { duration: 160ms; easing: ease-out; }
            background: Theme.win;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.line2;
            clip: true;
            // 点在卡片空白处不算点遮罩
            TouchArea { }
            @children
        }
    }
}

// 扫码连接手机：二维码（一次性配对码，10 分钟有效）、这台电脑的地址、怎么扫。
// 同一个码蓝牙配对、局域网绑定都用（手机按扫码时选的连接方式用）
component LanDialog inherits DialogCard {
    in property <image> qr;
    in property <bool> ready;
    in property <string> addr-text;
    in property <string> note;
    callback close();
    card-width: 460px;
    card-height: 520px;
    dismiss => {
        root.close();
    }
    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        Text {
            text: "扫码连接手机";
            color: Theme.fg;
            font-size: 16px;
            font-weight: 700;
        }
        WrapText {
            text: "手机蒜鸟里点右上角「···」→「扫码连接电脑」，扫下面的码。";
            color: Theme.fg2;
            font-size: 13px;
        }
        HorizontalLayout {
            alignment: center;
            // 二维码一直是白底黑块（深色模式也是），手机才扫得出来
            Rectangle {
                width: 268px;
                height: 268px;
                border-radius: 12px;
                background: #ffffff;
                border-width: 1px;
                border-color: Theme.line2;
                if root.ready: Image {
                    x: 14px;
                    y: 14px;
                    width: 240px;
                    height: 240px;
                    source: root.qr;
                    image-rendering: pixelated;
                }
                if !root.ready: Text {
                    text: "正在准备二维码…";
                    color: #888888;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.addr-text;
            color: Theme.fg;
            font-size: 12.5px;
            horizontal-alignment: center;
            overflow: elide;
        }
        WrapText {
            text: root.note;
            color: Theme.mut;
            font-size: 11.5px;
        }
        Rectangle {
            vertical-stretch: 1;
        }
        HorizontalLayout {
            alignment: end;
            GhostButton {
                text: "关闭";
                clicked => {
                    root.close();
                }
            }
        }
    }
}

// 确认框：标题、说明（可以多行）、确定和取消。notice：只是告诉一声（报错），只有一个「知道了」
component ConfirmDialog inherits DialogCard {
    in property <string> title;
    in property <string> body;
    in property <string> ok-text: "确定";
    in property <bool> danger;
    in property <bool> notice;
    callback accept();
    callback cancel();
    card-width: 560px;
    card-height: Math.min(560px, 150px + body-text.height);
    dismiss => {
        if (root.notice) {
            root.accept();
        } else {
            root.cancel();
        }
    }
    VerticalLayout {
        padding: 22px;
        spacing: 14px;
        Text {
            text: root.title;
            color: Theme.fg;
            font-size: 16px;
            font-weight: 700;
        }
        Flickable {
            vertical-stretch: 1;
            content-height: body-text.height;
            body-text := WrapText {
                width: parent.width;
                text: root.body;
                color: Theme.fg2;
                font-size: 13px;
            }
        }
        HorizontalLayout {
            spacing: 10px;
            alignment: end;
            if !root.notice: GhostButton {
                text: "取消";
                clicked => {
                    root.cancel();
                }
            }
            if !root.danger: PrimaryButton {
                text: root.ok-text;
                clicked => {
                    root.accept();
                }
            }
            if root.danger: Rectangle {
                height: 36px;
                min-width: 96px;
                border-radius: 10px;
                background: danger-area.has-hover ? Theme.red.darker(0.1) : Theme.red;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    Text {
                        text: root.ok-text;
                        color: #ffffff;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
                danger-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.accept();
                    }
                }
            }
        }
    }
}

// 有新版本：版本号、这次更新了什么、手机 App 是不是也有新版。
// 立即更新：下载电脑端的安装包（进度条），下载好了蒜鸟自己关掉、打开安装程序，装好以后再打开（ui/src/update.rs）
component UpdateDialog inherits DialogCard {
    in property <string> current;
    in property <string> version;
    // 「12.3 MB · 10 月 30 日发布」
    in property <string> detail;
    in property <[string]> notes;
    // 没列出来的还有几条
    in property <int> more;
    // 手机 App 也有新版时的一句话，空的就不显示
    in property <string> phone;
    // 0 看看，1 正在下载，2 没成（下载出错），3 下载好了、正在打开安装程序
    in property <int> stage;
    in property <float> progress;
    in property <string> progress-text;
    in property <string> error;
    callback update-now();
    callback later();
    callback skip();
    callback cancel-download();
    callback open-page();
    card-width: 520px;
    card-height: Math.min(620px, body.preferred-height);
    // 正在下载时点遮罩、按 Esc 不关（要关点「取消」）
    dismissable: root.stage == 0 || root.stage == 2;
    dismiss => {
        if (root.stage == 0 || root.stage == 2) {
            root.later();
        }
    }
    body := VerticalLayout {
        alignment: start;
        padding: 24px;
        spacing: 16px;
        HorizontalLayout {
            spacing: 14px;
            Rectangle {
                width: 52px;
                height: 52px;
                border-radius: 14px;
                background: Theme.lime;
                Image {
                    source: @image-url("../../assets/logo.svg");
                    width: 36px;
                    height: 36px;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 7px;
                Text {
                    text: root.stage == 1 ? "正在下载蒜鸟 " + root.version : root.stage == 2 ? "更新没有完成" : root.stage == 3 ? "正在打开安装程序" : "蒜鸟有新版本了";
                    color: Theme.fg;
                    font-size: 18px;
                    font-weight: 700;
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Chip {
                        text: root.current;
                    }
                    Icon {
                        source: @image-url("../icons/right.svg");
                        tint: Theme.mut;
                        size: 13px;
                    }
                    Chip {
                        text: root.version;
                        tone: 1;
                        dot: true;
                    }
                    if root.detail != "": Text {
                        text: "  " + root.detail;
                        color: Theme.mut;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }
        }
        if root.stage != 2: Rectangle {
            background: Theme.soft;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.line;
            VerticalLayout {
                padding: 14px;
                padding-top: 12px;
                spacing: 7px;
                Text {
                    text: "这次更新了";
                    color: Theme.mut;
                    font-size: 11.5px;
                    font-weight: 600;
                }
                for note in root.notes: HorizontalLayout {
                    spacing: 9px;
                    VerticalLayout {
                        alignment: start;
                        padding-top: 7px;
                        Rectangle {
                            width: 5px;
                            height: 5px;
                            border-radius: 2.5px;
                            background: Theme.lime-dot;
                        }
                    }
                    WrapText {
                        text: note;
                        horizontal-stretch: 1;
                    }
                }
                if root.notes.length == 0: Muted {
                    text: "这次没写更新说明。";
                }
                if root.more > 0: Muted {
                    text: "……还有 " + root.more + " 条，网页上看得到全部";
                    font-size: 12px;
                }
            }
        }
        if root.phone != "" && root.stage == 0: HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: start;
                padding-top: 1px;
                Icon {
                    source: @image-url("../icons/phone.svg");
                    tint: Theme.fg2;
                    size: 15px;
                }
            }
            Muted {
                text: root.phone;
                color: Theme.fg2;
                horizontal-stretch: 1;
            }
        }
        if root.stage == 1 || root.stage == 3: VerticalLayout {
            spacing: 8px;
            ProgressBar {
                value: root.stage == 3 ? 1 : root.progress;
            }
            Muted {
                text: root.progress-text;
                font-size: 12px;
            }
        }
        if root.stage == 2: Rectangle {
            background: Theme.warn-bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.warn-line;
            HorizontalLayout {
                padding: 14px;
                spacing: 10px;
                VerticalLayout {
                    alignment: start;
                    padding-top: 1px;
                    Icon {
                        source: @image-url("../icons/warn.svg");
                        tint: Theme.warn-fg;
                        size: 16px;
                    }
                }
                WrapText {
                    text: root.error;
                    color: Theme.warn-fg;
                    horizontal-stretch: 1;
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            // 跳过：这个版本不再提醒（「关于」里还看得到）
            if root.stage == 0: Rectangle {
                width: skip-text.preferred-width;
                skip-text := Text {
                    text: "跳过这个版本";
                    color: skip-area.has-hover ? Theme.fg2 : Theme.mut;
                    font-size: 12.5px;
                    vertical-alignment: center;
                }
                skip-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.skip();
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            if root.stage == 0: GhostButton {
                text: "以后再说";
                clicked => {
                    root.later();
                }
            }
            if root.stage == 0: PrimaryButton {
                text: "立即更新";
                has-icon: true;
                icon: @image-url("../icons/download.svg");
                clicked => {
                    root.update-now();
                }
            }
            if root.stage == 1: GhostButton {
                text: "取消";
                clicked => {
                    root.cancel-download();
                }
            }
            if root.stage == 2: GhostButton {
                text: "去网页下载";
                has-icon: true;
                icon: @image-url("../icons/globe.svg");
                clicked => {
                    root.open-page();
                }
            }
            if root.stage == 2: GhostButton {
                text: "关闭";
                clicked => {
                    root.later();
                }
            }
            if root.stage == 2: PrimaryButton {
                text: "重试";
                has-icon: true;
                icon: @image-url("../icons/refresh.svg");
                clicked => {
                    root.update-now();
                }
            }
        }
    }
}

// 起名字：一个输入框（回车就是确定）
component NameDialog inherits DialogCard {
    in property <string> title;
    in property <string> note;
    in property <string> initial;
    in property <string> ok-text: "确定";
    callback accept(string);
    callback cancel();
    card-width: 460px;
    card-height: 210px;
    // 点遮罩不关（会丢掉输入的名字），Esc 关
    dismissable: false;
    focus-self: false;
    dismiss => {
        root.cancel();
    }
    VerticalLayout {
        padding: 22px;
        spacing: 12px;
        Text {
            text: root.title;
            color: Theme.fg;
            font-size: 16px;
            font-weight: 700;
        }
        if root.note != "": Muted {
            text: root.note;
        }
        Rectangle {
            height: 36px;
            border-radius: 9px;
            border-width: 1px;
            border-color: input.has-focus ? Theme.ink : Theme.line2;
            background: Theme.win;
            input := TextInput {
                x: 11px;
                width: parent.width - 22px;
                height: parent.height;
                text: root.initial;
                color: Theme.fg;
                font-size: 13.5px;
                vertical-alignment: center;
                single-line: true;
                selection-background-color: Theme.lime;
                selection-foreground-color: Theme.lime-fg;
                init => {
                    self.focus();
                    self.select-all();
                }
                accepted => {
                    root.accept(self.text);
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            alignment: end;
            GhostButton {
                text: "取消";
                clicked => {
                    root.cancel();
                }
            }
            PrimaryButton {
                text: root.ok-text;
                clicked => {
                    root.accept(input.text);
                }
            }
        }
    }
}

// 已保存的动作序列：把当前按法存起来，或者插入 / 替换到当前按法，可以改名、删除
component SequencesDialog inherits DialogCard {
    in property <[SavedItem]> items;
    in property <string> target;
    in property <int> current-count;
    callback save();
    callback insert(int);
    callback replace(int);
    callback rename(int);
    callback remove(int);
    callback close();
    card-width: 720px;
    card-height: 560px;
    dismiss => {
        root.close();
    }
    VerticalLayout {
        CardHead {
            title: "已保存的动作序列";
            icon: @image-url("../icons/bookmark.svg");
            Rectangle {
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: @image-url("../icons/x.svg");
                    clicked => {
                        root.close();
                    }
                }
            }
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 12px;
            spacing: 10px;
            Muted {
                text: "当前：" + root.target + "（" + root.current-count + " 步）。存起来后可以插入或替换到别的按法。";
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                PrimaryButton {
                    text: "把当前按法存为序列";
                    clicked => {
                        root.save();
                    }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.line;
        }
        if root.items.length == 0: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            Muted {
                text: "还没有保存过动作序列。";
                horizontal-alignment: center;
            }
        }
        if root.items.length > 0: Flickable {
            vertical-stretch: 1;
            content-height: root.items.length * 58px;
            for item[i] in root.items: Rectangle {
                y: i * 58px;
                height: 58px;
                if i > 0: Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.line;
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        spacing: 2px;
                        Text {
                            text: item.name;
                            color: Theme.fg;
                            font-size: 13.5px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: item.count + " 步：" + item.summary;
                            color: Theme.mut;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }
                    for b[bi] in ["插入", "替换", "改名", "删除"]: VerticalLayout {
                        alignment: center;
                        GhostButton {
                            small: true;
                            text: b;
                            clicked => {
                                if (bi == 0) {
                                    root.insert(i);
                                } else if (bi == 1) {
                                    root.replace(i);
                                } else if (bi == 2) {
                                    root.rename(i);
                                } else {
                                    root.remove(i);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// 一步动作的参数（随类型变）：宽的时候和类型下拉框排在一行，窄的时候换到第二行
component ActionParams inherits HorizontalLayout {
    in property <ActionItem> item;
    callback choice-changed(int);
    callback text-changed(string);
    callback number-changed(int);
    callback flag-changed(bool);
    callback browse();
    // 录快捷键：按下、松开的键交给 Rust 判断，返回 0 接着录、1 录好了、2 取消
    callback record-key(string, bool, bool, bool, bool, bool) -> int;
    property <bool> recording;
    spacing: 8px;
    if root.item.kind == 0 && !root.recording: VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        KeyPicker {
            model: Lists.key-options;
            shown: root.item.shown;
            current-row: root.item.row;
            invalid: root.item.shown == "";
            selected(k) => {
                root.choice-changed(k);
            }
        }
    }
    if root.item.kind == 0 && !root.recording: VerticalLayout {
        alignment: center;
        GhostButton {
            small: true;
            text: "录制";
            has-icon: true;
            icon: @image-url("../icons/record.svg");
            clicked => {
                Recorder.hint = "";
                Recorder.active = true;
                root.recording = true;
            }
        }
    }
    if root.item.kind == 1 && !root.recording: VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Field {
            placeholder: "用 + 连接，例如 Ctrl+Shift+P";
            text: root.item.text;
            edited(t) => {
                root.text-changed(t);
            }
        }
    }
    if root.item.kind == 1 && !root.recording: VerticalLayout {
        alignment: center;
        GhostButton {
            small: true;
            text: "录制";
            has-icon: true;
            icon: @image-url("../icons/record.svg");
            clicked => {
                Recorder.hint = "";
                Recorder.active = true;
                root.recording = true;
            }
        }
    }
    // 录的时候：按下按键或组合键就填进去，Esc 取消；点到别处也取消
    if (root.item.kind == 0 || root.item.kind == 1) && root.recording: Rectangle {
        horizontal-stretch: 1;
        height: 34px;
        border-radius: 9px;
        border-width: 1.5px;
        border-color: Theme.ink;
        background: Theme.soft;
        Text {
            x: 11px;
            width: parent.width - 22px;
            height: parent.height;
            text: Recorder.hint == "" ? (root.item.kind == 0 ? "按下要录的键…（Esc 取消）" : "按下要录的组合键…（Esc 取消）") : Recorder.hint + " + …";
            color: Recorder.hint == "" ? Theme.mut : Theme.fg;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
        FocusScope {
            init => {
                self.focus();
            }
            key-pressed(event) => {
                if (root.record-key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta, true) != 0) {
                    Recorder.active = false;
                    root.recording = false;
                }
                accept
            }
            key-released(event) => {
                if (root.record-key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta, false) != 0) {
                    Recorder.active = false;
                    root.recording = false;
                }
                accept
            }
            changed has-focus => {
                if (!self.has-focus && root.recording) {
                    Recorder.active = false;
                    root.recording = false;
                }
            }
        }
    }
    if root.item.kind == 2 || root.item.kind == 9: VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Select {
            model: root.item.kind == 2 ? Lists.mouse-buttons : Lists.media-keys;
            current-index: root.item.choice;
            selected(c) => {
                root.choice-changed(c);
            }
        }
    }
    if root.item.kind == 3 || root.item.kind == 4: VerticalLayout {
        alignment: center;
        Select {
            width: 76px;
            model: Lists.directions;
            current-index: root.item.choice;
            selected(c) => {
                root.choice-changed(c);
            }
        }
    }
    if root.item.kind == 3: Muted {
        text: "每次滚一格";
        wrap: no-wrap;
        overflow: elide;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    if root.item.kind == 4: VerticalLayout {
        alignment: center;
        NumberField {
            prefix: "距离";
            value: root.item.number;
            minus => {
                root.number-changed(Math.max(1, root.item.number - 10));
            }
            plus => {
                root.number-changed(Math.min(500, root.item.number + 10));
            }
            typed(v) => {
                root.number-changed(Math.max(1, Math.min(500, Math.round(v))));
            }
        }
    }
    if root.item.kind == 4: Muted {
        text: "像素";
        wrap: no-wrap;
        overflow: elide;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    if root.item.kind == 5: VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Field {
            placeholder: "要输入的文字，例如常用的提示词";
            text: root.item.text;
            edited(t) => {
                root.text-changed(t);
            }
        }
    }
    if root.item.kind == 5: VerticalLayout {
        alignment: center;
        Select {
            width: 112px;
            model: Lists.paste-modes;
            current-index: root.item.choice;
            selected(c) => {
                root.choice-changed(c);
            }
        }
    }
    if root.item.kind == 6: VerticalLayout {
        alignment: center;
        NumberField {
            prefix: "等";
            value: root.item.number;
            minus => {
                root.number-changed(Math.max(0, root.item.number - 50));
            }
            plus => {
                root.number-changed(Math.min(300000, root.item.number + 50));
            }
            typed(v) => {
                root.number-changed(Math.max(0, Math.min(300000, Math.round(v))));
            }
        }
    }
    if root.item.kind == 6: Muted {
        text: "毫秒后再做后面的步骤";
        wrap: no-wrap;
        overflow: elide;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    if root.item.kind == 7: VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Field {
            placeholder: "程序或快捷方式的完整路径（.exe、.lnk）";
            text: root.item.text;
            edited(t) => {
                root.text-changed(t);
            }
        }
    }
    if root.item.kind == 7: VerticalLayout {
        alignment: center;
        GhostButton {
            small: true;
            text: "浏览…";
            clicked => {
                root.browse();
            }
        }
    }
    if root.item.kind == 8: VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Field {
            placeholder: "网址，例如 example.com（只能是 http、https）";
            text: root.item.text;
            edited(t) => {
                root.text-changed(t);
            }
        }
    }
    if root.item.kind == 10: VerticalLayout {
        alignment: center;
        Select {
            width: 150px;
            model: Lists.profile-directions;
            current-index: root.item.choice;
            selected(c) => {
                root.choice-changed(c);
            }
        }
    }
    if root.item.kind == 10: VerticalLayout {
        alignment: center;
        Switch {
            checked: root.item.flag;
            toggled(on) => {
                root.flag-changed(on);
            }
        }
    }
    if root.item.kind == 10: Text {
        text: "循环切换";
        color: Theme.fg2;
        font-size: 12.5px;
        vertical-alignment: center;
        overflow: elide;
        min-width: 0px;
        horizontal-stretch: 1;
    }
    if root.item.kind == 11: Muted {
        text: "什么都不做";
        wrap: no-wrap;
        overflow: elide;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    if root.item.kind < 0: Text {
        text: root.item.text;
        color: Theme.mut;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
        min-width: 0px;
        horizontal-stretch: 1;
    }
}

// 动作序列里的一步：序号、启用开关、类型、各类型的参数、上移下移删除。
// 打开应用多一行（启动参数、已在运行就切过去）；不合法时下面一行红字；看不懂的步骤只读。
// 窗口窄的时候参数换到第二行，免得挤在一起
component ActionRow inherits Rectangle {
    in property <ActionItem> item;
    in property <int> index;
    in property <int> count;
    callback kind-changed(int);
    callback choice-changed(int);
    callback text-changed(string);
    callback args-changed(string);
    callback number-changed(int);
    callback flag-changed(bool);
    callback enabled-changed(bool);
    callback move(int);
    callback remove();
    callback browse();
    callback record-key(string, bool, bool, bool, bool, bool) -> int;
    // 第二行开始的地方：对齐到类型下拉框
    property <length> indent: 80px;
    // 窗口窄（由主窗口按宽度算好传进来；不能看自己的宽度，否则和布局互相依赖）
    in property <bool> narrow;
    border-radius: 11px;
    border-width: 1px;
    border-color: Theme.line;
    background: root.item.enabled && root.item.kind >= 0 ? Theme.win : Theme.soft;
    animate background { duration: 150ms; }
    // 悬停在开关上时整行压到后面几行上面，提示才不会被挡住
    z: enable-switch.hovered ? 1 : 0;
    VerticalLayout {
        padding-left: 10px;
        padding-right: 8px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 6px;
                    background: Theme.soft;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.index + 1;
                        color: Theme.fg2;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                visible: root.item.kind >= 0;
                width: root.item.kind >= 0 ? 38px : 0px;
                enable-switch := Switch {
                    checked: root.item.enabled;
                    toggled(on) => {
                        root.enabled-changed(on);
                    }
                }
            }
            if root.item.kind >= 0: VerticalLayout {
                alignment: center;
                Select {
                    width: 124px;
                    model: Lists.action-kinds;
                    current-index: root.item.kind;
                    popup-min-width: 200px;
                    popup-max-height: 400px;
                    selected(k) => {
                        root.kind-changed(k);
                    }
                }
            }
            if root.item.kind < 0: VerticalLayout {
                alignment: center;
                Chip {
                    text: "看不懂的动作";
                    tone: 2;
                }
            }
            // 宽的时候参数排在这一行（停用的步骤淡一点）；窄的时候这里只是占位
            if !root.narrow || root.item.kind < 0: Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                opacity: root.item.enabled ? 1 : 0.5;
                ActionParams {
                    item: root.item;
                    choice-changed(c) => {
                        root.choice-changed(c);
                    }
                    text-changed(t) => {
                        root.text-changed(t);
                    }
                    number-changed(n) => {
                        root.number-changed(n);
                    }
                    flag-changed(on) => {
                        root.flag-changed(on);
                    }
                    browse => {
                        root.browse();
                    }
                    record-key(t, c, a, sh, m, p) => {
                        return root.record-key(t, c, a, sh, m, p);
                    }
                }
            }
            if root.narrow && root.item.kind >= 0: Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: @image-url("../icons/up.svg");
                    enabled: root.index > 0;
                    clicked => {
                        root.move(-1);
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: @image-url("../icons/down.svg");
                    enabled: root.index < root.count - 1;
                    clicked => {
                        root.move(1);
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: @image-url("../icons/trash.svg");
                    clicked => {
                        root.remove();
                    }
                }
            }
        }
        if root.narrow && root.item.kind >= 0 && root.item.kind != 11: HorizontalLayout {
            padding-left: 32px;
            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                opacity: root.item.enabled ? 1 : 0.5;
                ActionParams {
                    item: root.item;
                    choice-changed(c) => {
                        root.choice-changed(c);
                    }
                    text-changed(t) => {
                        root.text-changed(t);
                    }
                    number-changed(n) => {
                        root.number-changed(n);
                    }
                    flag-changed(on) => {
                        root.flag-changed(on);
                    }
                    browse => {
                        root.browse();
                    }
                    record-key(t, c, a, sh, m, p) => {
                        return root.record-key(t, c, a, sh, m, p);
                    }
                }
            }
        }
        if root.item.kind == 7: HorizontalLayout {
            padding-left: root.narrow ? 32px : root.indent;
            padding-right: root.narrow ? 0px : 104px;
            spacing: 10px;
            Field {
                horizontal-stretch: 1;
                placeholder: "启动参数（可以不填）";
                text: root.item.args;
                edited(t) => {
                    root.args-changed(t);
                }
            }
            VerticalLayout {
                alignment: center;
                Switch {
                    checked: root.item.flag;
                    toggled(on) => {
                        root.flag-changed(on);
                    }
                }
            }
            Text {
                text: "已经在运行就切到它的窗口";
                color: Theme.fg2;
                font-size: 12.5px;
                vertical-alignment: center;
            }
        }
        if root.item.problem != "": HorizontalLayout {
            padding-left: root.narrow ? 32px : root.indent;
            Text {
                text: root.item.problem;
                color: Theme.red;
                font-size: 12px;
                wrap: word-wrap;
                min-width: 0px;
                horizontal-stretch: 1;
            }
        }
        if root.item.kind < 0: HorizontalLayout {
            padding-left: 32px;
            Muted {
                text: "蒜鸟不认识这一步：保存时原样留着，执行时跳过。";
            }
        }
    }
    // 开关的说明：悬停时浮在开关上面
    if enable-switch.hovered: Rectangle {
        x: 34px;
        y: -30px;
        width: hint-text.preferred-width + 20px;
        height: 26px;
        border-radius: 7px;
        background: Theme.ink;
        hint-text := Text {
            x: 10px;
            height: parent.height;
            text: root.item.enabled ? "关掉就跳过这一步" : "已停用，执行时跳过";
            color: Theme.ink-fg;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

component MappingPage inherits Page {
    // 左边的列表：按页分组（可以收起），可以搜索
    in property <[MapRow]> list;
    in property <int> button-count;
    in property <[OverviewRow]> rows;
    in property <int> button-index;
    in property <int> trigger-index;
    // 「↑ · 长按」
    in property <string> button-title;
    // 页面多于一页时，按键所在的页
    in property <string> button-page;
    in property <[ActionItem]> actions;
    // 当前按键按住时怎么办（0 长按一次 1 重复长按 2 连发 3 直通）、能不能选直通；各种时间（说明里用）
    in property <int> hold;
    in property <bool> passthrough-ok;
    in property <int> long-press-ms;
    in property <int> long-repeat-delay-ms;
    in property <int> long-repeat-interval-ms;
    in property <int> repeat-delay-ms;
    in property <int> repeat-interval-ms;
    callback hold-changed(int);
    callback hold-blocked();
    callback select-button(int);
    callback toggle-page(int);
    callback search(string);
    callback select-trigger(int);
    callback trigger-blocked(int);
    callback add-action();
    callback remove-action(int);
    callback move-action(int, int);
    callback action-kind(int, int);
    callback action-choice(int, int);
    callback action-text(int, string);
    callback action-args(int, string);
    callback action-number(int, int);
    callback action-flag(int, bool);
    callback action-enabled(int, bool);
    callback browse(int);
    callback goto(int);
    // 窗口窄：动作的参数换到第二行
    in property <bool> narrow-actions;
    // 方案
    in property <[string]> profile-names;
    in property <int> profile-index;
    callback profile-selected(int);
    callback profile-new();
    callback profile-copy();
    callback profile-rename();
    callback profile-delete();
    // 动作下面的工具条
    callback apply-preset(int);
    callback copy-actions();
    callback paste-actions();
    callback save-sequence();
    callback open-sequences();
    callback record-key(int, string, bool, bool, bool, bool, bool) -> int;
    property <OverviewRow> current: root.button-index >= 0 && root.button-index < root.rows.length ? root.rows[root.button-index] : { label: "", key: "", click: "", double: "", long: "", today: 0, index: 0, hold: 0, hold-name: "", icon: "", glyph: "", tone: 0, ignored: false };
    property <string> query;
    VerticalLayout {
        alignment: start;
        spacing: 16px;
        PageHead {
            title: "映射";
            note: "每个键单击、双击、长按各做什么";
        }
        // 方案：布局共用，切方案只换每个按键的动作和按住时
        Card {
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        source: @image-url("../icons/layers.svg");
                        tint: Theme.fg2;
                        size: 16px;
                    }
                }
                Text {
                    text: "方案";
                    color: Theme.fg;
                    font-size: 13.5px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Select {
                        width: 210px;
                        model: root.profile-names;
                        current-index: root.profile-index;
                        popup-min-width: 240px;
                        selected(i) => {
                            root.profile-selected(i);
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    ToolButton {
                        text: "新增";
                        icon: @image-url("../icons/plus.svg");
                        clicked => {
                            root.profile-new();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    ToolButton {
                        text: "复制";
                        icon: @image-url("../icons/copy.svg");
                        clicked => {
                            root.profile-copy();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    ToolButton {
                        text: "重命名";
                        icon: @image-url("../icons/text.svg");
                        clicked => {
                            root.profile-rename();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    ToolButton {
                        text: "删除";
                        icon: @image-url("../icons/trash.svg");
                        enabled: root.profile-names.length > 1;
                        clicked => {
                            root.profile-delete();
                        }
                    }
                }
                Text {
                    text: "布局各方案共用";
                    color: Theme.mut;
                    font-size: 12.5px;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    min-width: 0px;
                }
            }
        }
        if root.button-count == 0: Card {
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: "布局里还没有按键。先到「布局」里添加按键。";
                    color: Theme.mut;
                    font-size: 13px;
                }
                HorizontalLayout {
                    alignment: start;
                    PrimaryButton {
                        text: "去布局";
                        has-icon: true;
                        icon-after: true;
                        icon: @image-url("../icons/arrow.svg");
                        clicked => {
                            root.goto(1);
                        }
                    }
                }
            }
        }
        if root.button-count > 0: HorizontalLayout {
            spacing: 16px;
            // 左边：所有按键，按页分组
            Card {
                width: 250px;
                VerticalLayout {
                    alignment: start;
                    padding: 6px;
                    spacing: 2px;
                    // 搜索
                    Rectangle {
                        height: 34px;
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: search.has-focus ? Theme.mut : Theme.line;
                        background: Theme.soft;
                        Icon {
                            x: 10px;
                            size: 14px;
                            source: @image-url("../icons/search.svg");
                            tint: Theme.mut;
                        }
                        if root.query == "": Text {
                            x: 31px;
                            width: parent.width - 40px;
                            height: parent.height;
                            text: "搜索按键或动作";
                            color: Theme.mut;
                            font-size: 12.5px;
                            vertical-alignment: center;
                        }
                        search := TextInput {
                            x: 31px;
                            width: parent.width - 58px;
                            height: parent.height;
                            color: Theme.fg;
                            font-size: 12.5px;
                            vertical-alignment: center;
                            single-line: true;
                            selection-background-color: Theme.lime;
                            selection-foreground-color: Theme.lime-fg;
                            edited => {
                                root.query = self.text;
                                root.search(self.text);
                            }
                        }
                        if root.query != "": Rectangle {
                            x: parent.width - 28px;
                            y: (parent.height - 22px) / 2;
                            width: 22px;
                            height: 22px;
                            border-radius: 6px;
                            background: clear.has-hover ? Theme.hover : transparent;
                            Icon {
                                x: 4px;
                                size: 14px;
                                source: @image-url("../icons/x.svg");
                                tint: Theme.mut;
                            }
                            clear := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    search.text = "";
                                    root.query = "";
                                    root.search("");
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 4px;
                    }
                    for r[i] in root.list: Rectangle {
                        height: r.header ? 34px : 44px;
                        border-radius: 10px;
                        background: !r.header && r.index == root.button-index ? Theme.hover : row-area.has-hover ? Theme.soft : transparent;
                        animate background { duration: 150ms; }
                        // 页面标题：名字、几个按键，点了收起 / 展开
                        if r.header: HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 10px;
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: r.collapsed ? @image-url("../icons/chev-right.svg") : @image-url("../icons/chev.svg");
                                    tint: Theme.mut;
                                    size: 13px;
                                }
                            }
                            Text {
                                text: r.text;
                                color: Theme.fg2;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: r.count;
                                color: Theme.mut;
                                font-size: 11.5px;
                                vertical-alignment: center;
                            }
                        }
                        if !r.header: HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                KeyTile {
                                    size: 28px;
                                    icon: r.icon;
                                    glyph: r.glyph;
                                    tone: r.tone;
                                }
                            }
                            Text {
                                text: r.text;
                                color: Theme.fg;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: r.tag;
                                color: Theme.mut;
                                font-size: 11.5px;
                                vertical-alignment: center;
                            }
                        }
                        row-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (r.header) {
                                    root.toggle-page(r.index);
                                } else {
                                    root.select-button(r.index);
                                }
                            }
                        }
                    }
                    if root.list.length == 0: Text {
                        height: 56px;
                        text: "没有搜到";
                        color: Theme.mut;
                        font-size: 12.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            // 右边：选中按键的某种按法
            Card {
                horizontal-stretch: 1;
                min-width: 0px;
                VerticalLayout {
                    alignment: start;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 10px;
                        min-height: 58px;
                        VerticalLayout {
                            alignment: center;
                            KeyTile {
                                icon: root.current.icon;
                                glyph: root.current.glyph;
                                tone: root.current.tone;
                            }
                        }
                        Text {
                            text: root.button-title;
                            color: Theme.fg;
                            font-size: 15.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                            min-width: 0px;
                            horizontal-stretch: 1;
                        }
                        if root.button-page != "": VerticalLayout {
                            alignment: center;
                            Chip {
                                text: root.button-page;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            // 连发、直通时双击、长按不判定，置灰（点了说明为什么）
                            Segmented {
                                options: ["单击", "双击", "长按"];
                                current: root.trigger-index;
                                segment-width: 60px;
                                disabled-from: root.hold == 2 || root.hold == 3 ? 1 : 99;
                                picked(t) => {
                                    root.select-trigger(t);
                                }
                                blocked(t) => {
                                    root.trigger-blocked(t);
                                }
                            }
                        }
                    }
                    SettingRow {
                        label: "按住时";
                        note: (root.hold == 0 ? "按住 " + root.long-press-ms + " 毫秒算一次「长按」" : root.hold == 1 ? "按住 " + root.long-press-ms + " 毫秒长按，之后每 " + root.long-repeat-interval-ms + " 毫秒一次" : root.hold == 2 ? "按住 " + root.repeat-delay-ms + " 毫秒后每 " + root.repeat-interval-ms + " 毫秒重复「单击」" : "按下就按住，松手才抬起，像实体键盘") + (root.passthrough-ok ? "" : "；直通要单击只有一个键");
                        VerticalLayout {
                            alignment: center;
                            Segmented {
                                options: Lists.hold-modes;
                                current: root.hold;
                                segment-width: 68px;
                                disabled-from: root.passthrough-ok ? 99 : 3;
                                picked(i) => {
                                    root.hold-changed(i);
                                }
                                blocked => {
                                    root.hold-blocked();
                                }
                            }
                        }
                    }
                    // 连发、直通时配了双击、长按：说一声不会生效
                    if root.current.ignored: HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 8px;
                        Rectangle {
                            border-radius: 9px;
                            background: Theme.warn-bg;
                            border-width: 1px;
                            border-color: Theme.warn-line;
                            HorizontalLayout {
                                padding: 9px;
                                padding-left: 12px;
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: start;
                                    Icon {
                                        source: @image-url("../icons/warn.svg");
                                        tint: Theme.warn-fg;
                                        size: 15px;
                                    }
                                }
                                Muted {
                                    text: "按住时是「" + root.current.hold-name + "」，双击、长按不生效；要用就改成「长按一次」或「重复长按」。";
                                    color: Theme.warn-fg;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 6px;
                        Muted {
                            text: root.hold == 2 ? "按下就执行，按住一直重复。" : root.hold == 3 ? "按下时按住这个键，松手抬起。" : "按顺序执行，跳过停用的步骤。配了双击，单击会稍等再执行。";
                        }
                    }
                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 16px;
                        spacing: 8px;
                        for a[ai] in root.actions: ActionRow {
                            item: a;
                            index: ai;
                            count: root.actions.length;
                            narrow: root.narrow-actions;
                            kind-changed(k) => {
                                root.action-kind(ai, k);
                            }
                            choice-changed(c) => {
                                root.action-choice(ai, c);
                            }
                            text-changed(t) => {
                                root.action-text(ai, t);
                            }
                            args-changed(t) => {
                                root.action-args(ai, t);
                            }
                            number-changed(n) => {
                                root.action-number(ai, n);
                            }
                            flag-changed(on) => {
                                root.action-flag(ai, on);
                            }
                            enabled-changed(on) => {
                                root.action-enabled(ai, on);
                            }
                            move(delta) => {
                                root.move-action(ai, delta);
                            }
                            remove => {
                                root.remove-action(ai);
                            }
                            browse => {
                                root.browse(ai);
                            }
                            record-key(t, c, a, sh, m, p) => {
                                return root.record-key(ai, t, c, a, sh, m, p);
                            }
                        }
                        if root.actions.length == 0: Rectangle {
                            height: 64px;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Theme.line2;
                            background: Theme.soft;
                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: "还没有动作，按了不会有反应。";
                                color: Theme.mut;
                                font-size: 12.5px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            height: 40px;
                            border-radius: 11px;
                            border-width: 1px;
                            border-color: add.has-hover ? Theme.mut : Theme.line2;
                            background: add.has-hover ? Theme.soft : Theme.win;
                            animate background, border-color { duration: 150ms; }
                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                Icon {
                                    source: @image-url("../icons/plus.svg");
                                    tint: Theme.fg2;
                                    size: 15px;
                                }
                                Text {
                                    text: "添加动作";
                                    color: Theme.fg2;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                            }
                            add := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.add-action();
                                }
                            }
                        }
                        // 工具条：预设、复制粘贴、已保存的序列（放不下就折到下一行）
                        FlexboxLayout {
                            spacing: 6px;
                            padding-top: 4px;
                            cross-axis-alignment: center;
                            MenuButton {
                                text: "预设";
                                icon: @image-url("../icons/sparkle.svg");
                                model: Lists.presets;
                                popup-width: 300px;
                                popup-height: 420px;
                                selected(k) => {
                                    root.apply-preset(k);
                                }
                            }
                            ToolButton {
                                text: "复制动作";
                                icon: @image-url("../icons/copy.svg");
                                enabled: root.actions.length > 0;
                                clicked => {
                                    root.copy-actions();
                                }
                            }
                            ToolButton {
                                text: "粘贴动作";
                                icon: @image-url("../icons/paste.svg");
                                clicked => {
                                    root.paste-actions();
                                }
                            }
                            ToolButton {
                                text: "存为序列";
                                icon: @image-url("../icons/bookmark.svg");
                                enabled: root.actions.length > 0;
                                clicked => {
                                    root.save-sequence();
                                }
                            }
                            ToolButton {
                                text: "已保存的序列";
                                icon: @image-url("../icons/bookmark.svg");
                                clicked => {
                                    root.open-sequences();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ───────────────────────── 总览 ─────────────────────────

component OverviewPage inherits Page {
    in property <[OverviewRow]> rows;
    in property <string> profile-name;
    in property <int> max-today;
    callback open-key(int);
    callback goto(int);
    VerticalLayout {
        alignment: start;
        spacing: 16px;
        PageHead {
            title: "总览";
            note: "方案「" + root.profile-name + "」的全部按键，点一行去改";
            GhostButton {
                text: "去映射里改";
                has-icon: true;
                icon-after: true;
                icon: @image-url("../icons/arrow.svg");
                clicked => {
                    root.goto(2);
                }
            }
        }
        Card {
            VerticalLayout {
                alignment: start;
                padding-top: 8px;
                padding-bottom: 6px;
                TableHead { }
                for row[i] in root.rows: KeyRow {
                    data: row;
                    max-today: root.max-today;
                    last: i == root.rows.length - 1;
                    clicked => {
                        root.open-key(i);
                    }
                }
                if root.rows.length == 0: Text {
                    text: "布局里还没有按键。";
                    color: Theme.mut;
                    font-size: 12.5px;
                    height: 64px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// ───────────────────────── 设置 ─────────────────────────

// 一位小数：1 → 1.0、2.5 → 2.5
global Fmt {
    public pure function one(v: float) -> string {
        return Math.floor(Math.round(v * 10) / 10) + "." + Math.mod(Math.round(v * 10), 10);
    }
}

// 带滑块的一行：数值带单位（decimals 是 1 就保留一位小数）
component SliderRow inherits SettingRow {
    in-out property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    in property <string> unit;
    in property <int> decimals: 1;
    callback changed();
    VerticalLayout {
        alignment: center;
        SliderBar {
            minimum: root.minimum;
            maximum: root.maximum;
            value <=> root.value;
            changed => {
                root.changed();
            }
        }
    }
    Text {
        width: 44px;
        text: (root.decimals == 1 ? Fmt.one(root.value) : "" + Math.round(root.value)) + root.unit;
        color: Theme.fg2;
        font-size: 12.5px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// 卡片标题右边的「恢复默认」
component ResetButton inherits Rectangle {
    callback clicked();
    height: 26px;
    width: reset-text.preferred-width + 18px;
    border-radius: 7px;
    background: reset-area.has-hover ? Theme.hover : transparent;
    animate background { duration: 150ms; }
    reset-text := Text {
        x: 9px;
        height: parent.height;
        text: "恢复默认";
        color: reset-area.has-hover ? Theme.fg : Theme.mut;
        font-size: 12px;
        vertical-alignment: center;
    }
    reset-area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component SettingsPage inherits Page {
    in-out property <float> sensitivity;
    in-out property <float> acceleration;
    in-out property <float> scroll-speed;
    in-out property <bool> natural-scroll;
    in-out property <bool> smoothing;
    in-out property <bool> auto-send;
    in-out property <float> send-delay;
    in-out property <bool> enter-after;
    in-out property <int> input-mode;
    in-out property <bool> clip-sync;
    // 手机发来的文件：存到哪个文件夹、收到后放不放进剪贴板
    in property <string> receive-folder;
    in-out property <bool> receive-clip;
    in-out property <int> double-click-ms;
    in-out property <int> long-press-ms;
    in-out property <int> repeat-delay-ms;
    in-out property <int> repeat-interval-ms;
    in-out property <int> long-repeat-delay-ms;
    in-out property <int> long-repeat-interval-ms;
    in-out property <float> cursor-acceleration;
    in-out property <bool> autostart;
    in property <bool> core-running;
    in property <string> folder;
    // 布局里有没有语音输入框（只对它生效的两项没有时淡一点）
    in property <bool> has-voice-box;
    callback changed();
    // 恢复默认：0 触控板 1 语音输入 2 按键判定
    callback reset(int);
    callback autostart-changed(bool);
    callback open-folder();
    callback export-backup();
    callback import-config();
    // 导入遥控器映射：0 从本机读取 1 选择文件
    callback import-remote(int);
    callback open-logs();
    callback open-receive-folder();
    callback pick-receive-folder();
    // 局域网连接：扫码绑定过的手机、开不起来的原因；显示二维码、解除绑定
    in property <[LanPhoneRow]> lan-phones;
    in property <string> lan-error;
    callback lan-pair();
    callback lan-remove(string);
    VerticalLayout {
        alignment: start;
        spacing: 16px;
        PageHead {
            title: "设置";
            note: "改完立即生效，可以撤销";
        }
        HorizontalLayout {
            spacing: 16px;
            VerticalLayout {
                spacing: 16px;
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                alignment: start;
                Card {
                    VerticalLayout {
                        alignment: start;
                        CardHead {
                            title: "触控板";
                            icon: @image-url("../icons/pad.svg");
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            VerticalLayout {
                                alignment: center;
                                ResetButton {
                                    clicked => {
                                        root.reset(0);
                                    }
                                }
                            }
                        }
                        SliderRow {
                            label: "指针速度";
                            minimum: 0.5;
                            maximum: 6;
                            unit: "×";
                            value <=> root.sensitivity;
                            changed => {
                                root.changed();
                            }
                        }
                        SliderRow {
                            label: "指针加速";
                            note: "划得越快走得越远";
                            minimum: 0;
                            maximum: 3;
                            unit: "";
                            value <=> root.acceleration;
                            changed => {
                                root.changed();
                            }
                        }
                        SliderRow {
                            label: "滚动速度";
                            minimum: 0.2;
                            maximum: 4;
                            unit: "×";
                            value <=> root.scroll-speed;
                            changed => {
                                root.changed();
                            }
                        }
                        SettingRow {
                            label: "自然滚动";
                            note: "内容跟着手指走";
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    checked <=> root.natural-scroll;
                                    toggled => {
                                        root.changed();
                                    }
                                }
                            }
                        }
                        SettingRow {
                            label: "指针平滑";
                            note: "更连贯，多约 10 毫秒延迟";
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    checked <=> root.smoothing;
                                    toggled => {
                                        root.changed();
                                    }
                                }
                            }
                        }
                    }
                }
                Card {
                    VerticalLayout {
                        alignment: start;
                        CardHead {
                            title: "语音输入";
                            icon: @image-url("../icons/mic.svg");
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            VerticalLayout {
                                alignment: center;
                                ResetButton {
                                    clicked => {
                                        root.reset(1);
                                    }
                                }
                            }
                        }
                        GroupLabel {
                            text: "语音按钮和语音输入框";
                        }
                        SettingRow {
                            label: "文字上屏方式";
                            note: "终端里用剪贴板更稳";
                            VerticalLayout {
                                alignment: center;
                                Segmented {
                                    options: ["逐字", "剪贴板"];
                                    segment-width: 64px;
                                    current: root.input-mode;
                                    picked(i) => {
                                        root.input-mode = i;
                                        root.changed();
                                    }
                                }
                            }
                        }
                        SettingRow {
                            label: "发送后自动按回车";
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    checked <=> root.enter-after;
                                    toggled => {
                                        root.changed();
                                    }
                                }
                            }
                        }
                        GroupLabel {
                            text: "只对语音输入框";
                            note: root.has-voice-box ? "" : "布局里还没有语音输入框";
                        }
                        SettingRow {
                            label: "说完自动发送";
                            note: "停顿一下就自动发出";
                            dim: !root.has-voice-box;
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    checked <=> root.auto-send;
                                    toggled => {
                                        root.changed();
                                    }
                                }
                            }
                        }
                        SettingRow {
                            label: "停多久算说完";
                            dim: !root.has-voice-box || !root.auto-send;
                            VerticalLayout {
                                alignment: center;
                                Stepper {
                                    text: Fmt.one(root.send-delay) + " 秒";
                                    minus => {
                                        root.send-delay = Math.max(0.3, Math.round(root.send-delay * 10 - 1) / 10);
                                        root.changed();
                                    }
                                    plus => {
                                        root.send-delay = Math.min(3, Math.round(root.send-delay * 10 + 1) / 10);
                                        root.changed();
                                    }
                                }
                            }
                        }
                    }
                }
                Card {
                    VerticalLayout {
                        alignment: start;
                        CardHead {
                            title: "剪贴板";
                            icon: @image-url("../icons/paste.svg");
                        }
                        SettingRow {
                            label: "和手机同步剪贴板";
                            note: "一边复制，另一边就能粘贴";
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    checked <=> root.clip-sync;
                                    toggled => {
                                        root.changed();
                                    }
                                }
                            }
                        }
                    }
                }
                Card {
                    VerticalLayout {
                        alignment: start;
                        CardHead {
                            title: "接收文件";
                            icon: @image-url("../icons/download.svg");
                        }
                        SettingRow {
                            label: "保存到";
                            note: root.receive-folder;
                            HorizontalLayout {
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    GhostButton {
                                        small: true;
                                        text: "打开";
                                        has-icon: true;
                                        icon: @image-url("../icons/folder.svg");
                                        clicked => {
                                            root.open-receive-folder();
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    GhostButton {
                                        small: true;
                                        text: "更改…";
                                        clicked => {
                                            root.pick-receive-folder();
                                        }
                                    }
                                }
                            }
                        }
                        SettingRow {
                            label: "收到后放进剪贴板";
                            note: "图片直接粘进对话框";
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    checked <=> root.receive-clip;
                                    toggled => {
                                        root.changed();
                                    }
                                }
                            }
                        }
                    }
                }
                Card {
                    VerticalLayout {
                        alignment: start;
                        CardHead {
                            title: "扫码连接";
                            icon: @image-url("../icons/globe.svg");
                        }
                        SettingRow {
                            label: "扫码连接手机";
                            note: "蓝牙配对、局域网绑定都扫这一个码";
                            VerticalLayout {
                                alignment: center;
                                PrimaryButton {
                                    text: "显示二维码";
                                    clicked => {
                                        root.lan-pair();
                                    }
                                }
                            }
                        }
                        for phone in root.lan-phones: SettingRow {
                            label: phone.name;
                            note: phone.detail;
                            VerticalLayout {
                                alignment: center;
                                GhostButton {
                                    small: true;
                                    text: "解除绑定";
                                    clicked => {
                                        root.lan-remove(phone.id);
                                    }
                                }
                            }
                        }
                        if root.lan-error != "": HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-bottom: 12px;
                            WrapText {
                                text: root.lan-error;
                                color: Theme.red;
                                font-size: 11.5px;
                            }
                        }
                    }
                }
            }
            VerticalLayout {
                spacing: 16px;
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                alignment: start;
                Card {
                    VerticalLayout {
                        alignment: start;
                        CardHead {
                            title: "按键判定";
                            icon: @image-url("../icons/kbd.svg");
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            VerticalLayout {
                                alignment: center;
                                ResetButton {
                                    clicked => {
                                        root.reset(2);
                                    }
                                }
                            }
                        }
                        SettingRow {
                            label: "双击间隔";
                            note: "两下间隔在这以内算双击";
                            VerticalLayout {
                                alignment: center;
                                Stepper {
                                    text: root.double-click-ms + " 毫秒";
                                    minus => {
                                        root.double-click-ms = Math.max(150, root.double-click-ms - 50);
                                        root.changed();
                                    }
                                    plus => {
                                        root.double-click-ms = Math.min(800, root.double-click-ms + 50);
                                        root.changed();
                                    }
                                }
                            }
                        }
                        SettingRow {
                            label: "长按时间";
                            note: "按住这么久算长按";
                            VerticalLayout {
                                alignment: center;
                                Stepper {
                                    text: root.long-press-ms + " 毫秒";
                                    minus => {
                                        root.long-press-ms = Math.max(250, root.long-press-ms - 50);
                                        root.changed();
                                    }
                                    plus => {
                                        root.long-press-ms = Math.min(2000, root.long-press-ms + 50);
                                        root.changed();
                                    }
                                }
                            }
                        }
                        SettingRow {
                            label: "连发延迟";
                            note: "按住多久开始连发";
                            VerticalLayout {
                                alignment: center;
                                Stepper {
                                    text: root.repeat-delay-ms + " 毫秒";
                                    minus => {
                                        root.repeat-delay-ms = Math.max(150, root.repeat-delay-ms - 50);
                                        root.changed();
                                    }
                                    plus => {
                                        root.repeat-delay-ms = Math.min(1000, root.repeat-delay-ms + 50);
                                        root.changed();
                                    }
                                }
                            }
                        }
                        SettingRow {
                            label: "连发间隔";
                            note: "每秒约 " + Math.round(1000 / Math.max(1, root.repeat-interval-ms)) + " 次";
                            VerticalLayout {
                                alignment: center;
                                Stepper {
                                    text: root.repeat-interval-ms + " 毫秒";
                                    minus => {
                                        root.repeat-interval-ms = Math.max(20, root.repeat-interval-ms - 10);
                                        root.changed();
                                    }
                                    plus => {
                                        root.repeat-interval-ms = Math.min(200, root.repeat-interval-ms + 10);
                                        root.changed();
                                    }
                                }
                            }
                        }
                        SettingRow {
                            label: "重复长按：第二次";
                            note: "离第一次多久";
                            VerticalLayout {
                                alignment: center;
                                Stepper {
                                    text: root.long-repeat-delay-ms + " 毫秒";
                                    minus => {
                                        root.long-repeat-delay-ms = Math.max(100, root.long-repeat-delay-ms - 50);
                                        root.changed();
                                    }
                                    plus => {
                                        root.long-repeat-delay-ms = Math.min(1000, root.long-repeat-delay-ms + 50);
                                        root.changed();
                                    }
                                }
                            }
                        }
                        SettingRow {
                            label: "重复长按：之后";
                            note: "之后每次的间隔";
                            VerticalLayout {
                                alignment: center;
                                Stepper {
                                    text: root.long-repeat-interval-ms + " 毫秒";
                                    minus => {
                                        root.long-repeat-interval-ms = Math.max(30, root.long-repeat-interval-ms - 10);
                                        root.changed();
                                    }
                                    plus => {
                                        root.long-repeat-interval-ms = Math.min(500, root.long-repeat-interval-ms + 10);
                                        root.changed();
                                    }
                                }
                            }
                        }
                        SliderRow {
                            label: "光标加速度";
                            note: "光标连发时越按越快";
                            minimum: 0;
                            maximum: 100;
                            unit: "%";
                            decimals: 0;
                            value <=> root.cursor-acceleration;
                            changed => {
                                root.changed();
                            }
                        }
                    }
                }
                Card {
                    VerticalLayout {
                        alignment: start;
                        CardHead {
                            title: "后台程序";
                            icon: @image-url("../icons/power.svg");
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            VerticalLayout {
                                alignment: center;
                                Chip {
                                    dot: true;
                                    tone: root.core-running ? 4 : 0;
                                    text: root.core-running ? "运行中" : "未运行";
                                }
                            }
                        }
                        SettingRow {
                            label: "开机自动启动后台";
                            note: "不开这个窗口，手机也能连";
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    checked <=> root.autostart;
                                    toggled => {
                                        root.autostart-changed(root.autostart);
                                    }
                                }
                            }
                        }
                        SettingRow {
                            label: "配置文件夹";
                            note: root.folder;
                            VerticalLayout {
                                alignment: center;
                                GhostButton {
                                    small: true;
                                    text: "打开";
                                    has-icon: true;
                                    icon: @image-url("../icons/folder.svg");
                                    clicked => {
                                        root.open-folder();
                                    }
                                }
                            }
                        }
                        SettingRow {
                            label: "日志";
                            note: "出问题时看这里";
                            VerticalLayout {
                                alignment: center;
                                GhostButton {
                                    small: true;
                                    text: "打开";
                                    has-icon: true;
                                    icon: @image-url("../icons/folder.svg");
                                    clicked => {
                                        root.open-logs();
                                    }
                                }
                            }
                        }
                    }
                }
                Card {
                    VerticalLayout {
                        alignment: start;
                        CardHead {
                            title: "导出和导入";
                            icon: @image-url("../icons/upload.svg");
                        }
                        SettingRow {
                            label: "导出备份";
                            note: "布局、方案、设置存成一个文件";
                            VerticalLayout {
                                alignment: center;
                                GhostButton {
                                    small: true;
                                    text: "导出备份…";
                                    clicked => {
                                        root.export-backup();
                                    }
                                }
                            }
                        }
                        SettingRow {
                            label: "导入备份";
                            note: "导入前会先备份现在的";
                            VerticalLayout {
                                alignment: center;
                                GhostButton {
                                    small: true;
                                    text: "导入备份…";
                                    clicked => {
                                        root.import-config();
                                    }
                                }
                            }
                        }
                        SettingRow {
                            label: "遥控器映射";
                            note: "导入成新的一页";
                            VerticalLayout {
                                alignment: center;
                                MenuButton {
                                    text: "导入遥控器映射…";
                                    icon: @image-url("../icons/import.svg");
                                    popup-width: 200px;
                                    model: [
                                        { text: "从本机读取", header: false, key: 0 },
                                        { text: "选择文件…", header: false, key: 1 },
                                    ];
                                    selected(k) => {
                                        root.import-remote(k);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ───────────────────────── 关于 ─────────────────────────

component AboutPage inherits Page {
    in property <string> version;
    in property <string> folder;
    // 手机 App 的版本、型号（连过才知道）
    in property <string> phone-app;
    in property <string> phone-model;
    callback open-folder();
    // 更新（ui/src/update.rs）：状态标签（色块同 Chip）、下面一行小字（上次检查的时间、出错原因）
    in property <string> update-status;
    in property <int> update-tone;
    in property <string> update-note;
    in property <bool> update-available;
    in property <bool> update-checking;
    in-out property <bool> update-auto: true;
    callback check-update();
    callback show-update();
    callback update-auto-changed(bool);
    VerticalLayout {
        alignment: start;
        spacing: 16px;
        PageHead {
            title: "关于";
            note: "版本与说明";
        }
        HorizontalLayout {
            alignment: start;
            Card {
                width: 560px;
                VerticalLayout {
                    alignment: start;
                    padding: 28px;
                    spacing: 14px;
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Image {
                            source: @image-url("../../assets/logo.svg");
                            width: 36px;
                            height: 36px;
                        }
                        Text {
                            text: "蒜鸟";
                            font-size: 28px;
                            font-weight: 900;
                            color: Theme.fg;
                        }
                        VerticalLayout {
                            alignment: end;
                            padding-bottom: 9px;
                            Rectangle {
                                width: 7px;
                                height: 7px;
                                border-radius: 3.5px;
                                background: Theme.lime-dot;
                            }
                        }
                    }
                    WrapText {
                        text: "把手机变成电脑的触控板、快捷键和语音输入。";
                        font-size: 13.5px;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Chip {
                            text: "电脑端 " + root.version;
                        }
                        Chip {
                            text: root.phone-app != "" ? "手机 App " + root.phone-app : "手机 App：还没连过";
                        }
                        if root.phone-model != "": Chip {
                            text: root.phone-model;
                        }
                    }
                    Muted {
                        text: "关掉窗口不影响使用，后台在托盘里继续工作。";
                        color: Theme.fg2;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Muted {
                            text: "配置文件夹：" + root.folder;
                            color: Theme.fg2;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            GhostButton {
                                small: true;
                                text: "打开";
                                has-icon: true;
                                icon: @image-url("../icons/folder.svg");
                                clicked => {
                                    root.open-folder();
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        AboutSlint { }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: start;
            Card {
                width: 560px;
                VerticalLayout {
                    CardHead {
                        title: "更新";
                        icon: @image-url("../icons/refresh.svg");
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        VerticalLayout {
                            alignment: center;
                            Chip {
                                text: root.update-status;
                                tone: root.update-tone;
                                dot: root.update-available;
                            }
                        }
                    }
                    SettingRow {
                        label: root.update-available ? "新版本已经发布" : "检查更新";
                        note: root.update-note;
                        VerticalLayout {
                            alignment: center;
                            if root.update-available: PrimaryButton {
                                text: "查看更新";
                                clicked => {
                                    root.show-update();
                                }
                            }
                            if !root.update-available: GhostButton {
                                small: true;
                                text: root.update-checking ? "正在检查…" : "检查更新";
                                enabled: !root.update-checking;
                                has-icon: true;
                                icon: @image-url("../icons/refresh.svg");
                                clicked => {
                                    root.check-update();
                                }
                            }
                        }
                    }
                    SettingRow {
                        label: "自动检查更新";
                        note: "有新版本时提醒你，不会自动安装";
                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                checked <=> root.update-auto;
                                toggled => {
                                    root.update-auto-changed(root.update-auto);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ───────────────────────── 侧边栏 ─────────────────────────

component NavItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <string> badge;
    in property <bool> badge-lime: false;
    in property <bool> selected;
    callback clicked();
    height: 36px;
    border-radius: 10px;
    background: !root.selected && area.has-hover ? Theme.hover : transparent;
    animate background { duration: 150ms; }
    Icon {
        x: 10px;
        size: 17px;
        source: root.icon;
        tint: root.selected ? Theme.ink-fg : Theme.fg2;
        animate tint { duration: 250ms; }
    }
    Text {
        x: 37px;
        height: parent.height;
        text: root.text;
        color: root.selected ? Theme.ink-fg : Theme.fg2;
        font-size: 13.5px;
        vertical-alignment: center;
        animate color { duration: 250ms; }
    }
    if root.badge != "": Rectangle {
        x: parent.width - self.width - 8px;
        y: (parent.height - 20px) / 2;
        height: 20px;
        width: Math.max(20px, badge-text.preferred-width + 12px);
        border-radius: 6px;
        background: root.selected ? (Theme.dark ? #00000022 : #ffffff33) : root.badge-lime ? Theme.lime : Theme.tone-bg(0);
        badge-text := Text {
            width: parent.width;
            height: parent.height;
            text: root.badge;
            color: root.selected ? Theme.ink-fg : root.badge-lime ? Theme.lime-fg : Theme.tone-fg(0);
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// 一组导航：黑色选中块顺滑地滑到点中的那一项；选中的不在这组时选中块淡出
component NavGroup inherits Rectangle {
    in property <[{ text: string, icon: image, badge: string, lime: bool }]> items;
    in property <int> first;
    in-out property <int> nav;
    property <bool> here: root.nav >= root.first && root.nav < root.first + root.items.length;
    height: root.items.length * 38px - 2px;
    Rectangle {
        y: Math.max(0, Math.min(root.items.length - 1, root.nav - root.first)) * 38px;
        height: 36px;
        border-radius: 10px;
        background: Theme.ink;
        opacity: root.here ? 1 : 0;
        animate y { duration: Motion.normal; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        animate opacity { duration: 180ms; }
    }
    for it[i] in root.items: NavItem {
        y: i * 38px;
        width: root.width;
        text: it.text;
        icon: it.icon;
        badge: it.badge;
        badge-lime: it.lime;
        selected: root.nav == root.first + i;
        clicked => {
            root.nav = root.first + i;
        }
    }
}

// ───────────────────────── 对话框 ─────────────────────────

// 改网格：先选好再应用（所有页面的模块都会跟着变大变小），下面是第一页在新网格里的样子
component GridDialog inherits DialogCard {
    in property <int> columns;
    in property <int> rows;
    in property <[ModuleItem]> modules;
    pure callback problem(int, int) -> string;
    callback apply(int, int);
    callback cancel();
    property <int> c: root.columns;
    property <int> r: root.rows;
    property <string> issue: root.problem(root.c, root.r);
    card-width: 500px;
    card-height: 430px;
    dismiss => {
        root.cancel();
    }
    VerticalLayout {
        padding: 22px;
        spacing: 14px;
        Text {
            text: "改网格";
            color: Theme.fg;
            font-size: 16px;
            font-weight: 700;
        }
        Muted {
            text: "所有页面共用网格，格子越多，模块越小。";
            font-size: 12.5px;
        }
        HorizontalLayout {
            spacing: 20px;
            PhonePreview {
                width: 132px;
                height: 236px;
                modules: root.modules;
                columns: root.c;
                rows: root.r;
            }
            VerticalLayout {
                spacing: 12px;
                alignment: start;
                horizontal-stretch: 1;
                min-width: 0px;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text {
                        width: 28px;
                        text: "列";
                        color: Theme.mut;
                        font-size: 12.5px;
                        vertical-alignment: center;
                    }
                    Stepper {
                        text: root.c + " 列";
                        text-width: 64px;
                        minus => {
                            root.c = Math.max(2, root.c - 1);
                        }
                        plus => {
                            root.c = Math.min(8, root.c + 1);
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text {
                        width: 28px;
                        text: "行";
                        color: Theme.mut;
                        font-size: 12.5px;
                        vertical-alignment: center;
                    }
                    Stepper {
                        text: root.r + " 行";
                        text-width: 64px;
                        minus => {
                            root.r = Math.max(3, root.r - 1);
                        }
                        plus => {
                            root.r = Math.min(16, root.r + 1);
                        }
                    }
                }
                Muted {
                    text: root.issue != "" ? root.issue : root.c == root.columns && root.r == root.rows ? "现在是 " + root.columns + " 列 × " + root.rows + " 行，可选 2～8 列、3～16 行。" : "从 " + root.columns + " 列 × " + root.rows + " 行改成 " + root.c + " 列 × " + root.r + " 行。改完可以撤销。";
                    color: root.issue != "" ? Theme.red : Theme.mut;
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
        HorizontalLayout {
            spacing: 10px;
            alignment: end;
            GhostButton {
                text: "取消";
                clicked => {
                    root.cancel();
                }
            }
            PrimaryButton {
                text: "应用";
                enabled: root.issue == "" && (root.c != root.columns || root.r != root.rows);
                clicked => {
                    root.apply(root.c, root.r);
                }
            }
        }
    }
}

// 导入遥控器映射：先预览每个键和它的动作，勾选后确认
component ImportDialog inherits DialogCard {
    in property <string> source;
    in property <string> page;
    in property <[ImportRow]> rows;
    in property <int> count;
    in property <bool> as-profile;
    in property <string> profile-name;
    in property <string> current-profile;
    callback toggle(int);
    callback as-profile-changed(bool);
    callback confirm();
    callback cancel();
    card-width: 860px;
    card-height: 660px;
    // 点遮罩不关（会丢掉勾选），Esc 关
    dismissable: false;
    dismiss => {
        root.cancel();
    }
    VerticalLayout {
        CardHead {
            title: "导入遥控器映射";
            icon: @image-url("../icons/import.svg");
            VerticalLayout {
                alignment: center;
                Chip {
                    text: root.source;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 10px;
            Muted {
                text: "勾选要导入的键，确认后新建一页「" + root.page + "」。只读取，不改遥控器软件的数据。";
                font-size: 12.5px;
                horizontal-stretch: 1;
            }
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 10px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Switch {
                    checked: root.as-profile;
                    toggled(on) => {
                        root.as-profile-changed(on);
                    }
                }
            }
            Text {
                text: root.as-profile ? "导入成新方案「" + root.profile-name + "」并切过去（其余按键沿用当前方案的映射）" : "不新建方案，写进当前方案「" + root.current-profile + "」";
                color: Theme.fg;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                min-width: 0px;
            }
        }
        Rectangle {
            height: 34px;
            background: Theme.soft;
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.line;
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line;
            }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                Rectangle {
                    width: 38px;
                }
                for title[ti] in ["按键", "单击", "双击", "长按", "按住时"]: Text {
                    horizontal-stretch: ti == 0 ? 1.2 : ti == 4 ? 0.8 : 1;
                    min-width: 0px;
                    preferred-width: 0px;
                    text: title;
                    color: Theme.mut;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
        Flickable {
            vertical-stretch: 1;
            content-height: root.rows.length * 52px;
            for row[i] in root.rows: Rectangle {
                y: i * 52px;
                height: 52px;
                opacity: row.checked ? 1 : 0.55;
                animate opacity { duration: 150ms; }
                if i > 0: Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.line;
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Switch {
                            checked: row.checked;
                            toggled => {
                                root.toggle(i);
                            }
                        }
                    }
                    HorizontalLayout {
                        horizontal-stretch: 1.2;
                        min-width: 0px;
                        preferred-width: 0px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            KeyTile {
                                size: 30px;
                                icon: row.icon;
                                glyph: row.glyph;
                                tone: row.tone;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: row.label;
                                color: Theme.fg;
                                font-size: 13px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            if row.note != "": Text {
                                text: row.note;
                                color: Theme.mut;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                    }
                    for cell in [row.click, row.double, row.long]: HorizontalLayout {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            KeyCap {
                                text: cell;
                            }
                        }
                    }
                    HorizontalLayout {
                        horizontal-stretch: 0.8;
                        min-width: 0px;
                        preferred-width: 0px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Chip {
                                text: row.hold;
                                tone: row.configured ? 3 : 0;
                            }
                        }
                    }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.line;
        }
        HorizontalLayout {
            padding: 14px;
            spacing: 10px;
            alignment: end;
            GhostButton {
                text: "取消";
                clicked => {
                    root.cancel();
                }
            }
            PrimaryButton {
                text: "导入 " + root.count + " 个键";
                enabled: root.count > 0;
                clicked => {
                    root.confirm();
                }
            }
        }
    }
}

// 手机信息浮层里的一行
component InfoLine inherits HorizontalLayout {
    in property <string> key;
    in property <string> value;
    in property <color> value-color: Theme.fg;
    height: 30px;
    spacing: 12px;
    Text {
        width: 64px;
        text: root.key;
        color: Theme.mut;
        font-size: 12.5px;
        vertical-alignment: center;
    }
    Text {
        text: root.value;
        color: root.value-color;
        font-size: 12.5px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
        min-width: 0px;
    }
}

// ───────────────────────── 使用教程 ─────────────────────────
//
// 第一次打开时自动出来，首页右上角「使用教程」能再看。左边是会动的插图，右边是说明；
// 连手机那三步实时显示电脑这边的情况（后台、蓝牙、配对、连上没有）。
// 插图只用位置、大小、透明度、颜色做动画：软件渲染器不会旋转、缩放、画阴影，裁剪也不管圆角，所以东西别贴着圆角画

// 插图的时间曲线（毫秒 → 0~1）
global Tween {
    // t 在 a~b 之间走到哪了
    public pure function seg(t: float, a: float, b: float) -> float {
        return Math.clamp((t - a) / (b - a), 0, 1);
    }
    // 先快后慢
    public pure function decel(p: float) -> float {
        return 1 - (1 - p) * (1 - p) * (1 - p);
    }
    // 慢、快、慢
    public pure function smooth(p: float) -> float {
        return p < 0.5 ? 4 * p * p * p : 1 - 4 * (1 - p) * (1 - p) * (1 - p);
    }
    // 弹出来：稍微冲过头再落回去
    public pure function pop(p: float) -> float {
        return 1 + 2.7 * (p - 1) * (p - 1) * (p - 1) + 1.7 * (p - 1) * (p - 1);
    }
    // 一来一回：0 → 1 → 0
    public pure function wave(p: float) -> float {
        return 0.5 - 0.5 * Math.cos(p * 360deg);
    }
    public pure function lerp(a: length, b: length, p: float) -> length {
        return a + (b - a) * p;
    }
}

// 插图的一幅：翻到这一页时淡入，翻走时淡出。
// since：这一幅出现以后过了多少毫秒，里面的动作都按它算；看不见时停在 0（不读 animation-tick，不占 CPU）
component Stage inherits Rectangle {
    in property <bool> active;
    property <bool> live: root.active || root.opacity > 0.01;
    property <duration> start;
    out property <float> since: root.live ? (animation-tick() - root.start) / 1ms : 0;
    opacity: root.active ? 1 : 0;
    visible: self.opacity > 0.01;
    animate opacity {
        duration: root.active ? 380ms : 160ms;
        delay: root.active ? 100ms : 0ms;
        easing: ease-out;
    }
    init => {
        root.start = animation-tick();
    }
    changed active => {
        if (root.active) {
            root.start = animation-tick();
        }
    }
}

// 插图里的手指：半透明的圆点，按下去时缩一点、深一点
component Finger inherits Rectangle {
    in property <length> cx;
    in property <length> cy;
    in property <float> press;
    width: 30px - 5px * root.press;
    height: self.width;
    x: root.cx - self.width / 2;
    y: root.cy - self.height / 2;
    border-radius: self.width / 2;
    background: (Theme.dark ? #ffffff : #1a1a1a).with-alpha(0.26 + 0.2 * root.press);
    border-width: 2px;
    border-color: #ffffffd8;
}

// 点下去时漾开的一圈
component Ripple inherits Rectangle {
    in property <float> p;
    in property <length> cx;
    in property <length> cy;
    in property <color> tint: Theme.lime-dot;
    width: 24px + 40px * root.p;
    height: self.width;
    x: root.cx - self.width / 2;
    y: root.cy - self.height / 2;
    border-radius: self.width / 2;
    border-width: 2px;
    border-color: root.tint.with-alpha(0.75 * (1 - root.p));
    visible: root.p > 0 && root.p < 1;
}

// 插图里的鼠标箭头，(tip-x, tip-y) 是箭头尖
component Pointer inherits Path {
    in property <length> tip-x;
    in property <length> tip-y;
    x: root.tip-x - 1px;
    y: root.tip-y - 1px;
    width: 15px;
    height: 21px;
    viewbox-width: 15;
    viewbox-height: 21;
    commands: "M 1 1 L 1 17 L 5 13.3 L 8 19.8 L 10.8 18.6 L 7.9 12.3 L 13.3 12.3 Z";
    fill: #ffffff;
    stroke: #141414;
    stroke-width: 1.2px;
}

// 插图里的手机：黑边框、圆角屏幕。里面的东西按屏幕的左上角摆
component MiniPhone inherits Rectangle {
    border-radius: 26px;
    border-width: 5px;
    border-color: Theme.dark ? #3d3d42 : #1f1f21;
    background: Theme.phone-bg;
    Rectangle {
        x: 5px;
        y: 5px;
        width: root.width - 10px;
        height: root.height - 10px;
        @children
    }
    // 前摄像头
    Rectangle {
        x: (root.width - 7px) / 2;
        y: 11px;
        width: 7px;
        height: 7px;
        border-radius: 3.5px;
        background: Theme.dark ? #3d3d42 : #1f1f21;
    }
}

// 插图里的笔记本电脑：屏幕（黑边框）加底座。里面的东西按屏幕里面的左上角摆
component MiniLaptop inherits Rectangle {
    in property <length> screen-width;
    in property <length> screen-height;
    width: root.screen-width + 30px;
    height: root.screen-height + 10px;
    Rectangle {
        x: 15px;
        y: 0;
        width: root.screen-width;
        height: root.screen-height;
        border-radius: 10px;
        border-width: 6px;
        border-color: Theme.dark ? #3d3d42 : #1f1f21;
        background: Theme.win;
        Rectangle {
            x: 6px;
            y: 6px;
            width: parent.width - 12px;
            height: parent.height - 12px;
            @children
        }
    }
    // 底座
    Rectangle {
        x: 0;
        y: root.screen-height;
        width: root.width;
        height: 10px;
        border-radius: 5px;
        background: Theme.dark ? #4a4a50 : #cfcfca;
        Rectangle {
            x: (parent.width - 40px) / 2;
            y: 0;
            width: 40px;
            height: 4px;
            border-radius: 2px;
            background: Theme.dark ? #3a3a3f : #b8b8b2;
        }
    }
}

// 插图里手机上的蒜鸟：顶栏、触控板、一排按键（keys）、语音按钮，按自己的大小摆。
// listening：按住语音键说话时 0 → 1（语音按钮变绿，出现声波）
component MiniApp inherits Rectangle {
    in property <bool> online: true;
    // 顶栏右边的字
    in property <string> status-text: root.online ? "已连接" : "未连接";
    in property <bool> keys: true;
    in property <float> listening;
    in property <float> since;
    out property <length> pad-y: 48px;
    out property <length> pad-h: root.height * (root.keys ? 0.42 : 0.44);
    out property <length> mic-y: root.pad-y + root.pad-h + (root.keys ? 58px : 10px);
    // 顶栏
    Image {
        x: 12px;
        y: 21px;
        width: 18px;
        height: 18px;
        source: @image-url("../../assets/logo.svg");
    }
    Text {
        x: 34px;
        y: 22px;
        text: "蒜鸟";
        color: Theme.phone-fg;
        font-size: 11px;
        font-weight: 700;
    }
    Rectangle {
        x: state-text.x - 10px;
        y: 28px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: root.online ? Theme.green : Theme.phone-mut;
        animate background { duration: 300ms; }
    }
    state-text := Text {
        x: root.width - 12px - self.width;
        y: 23px;
        text: root.status-text;
        color: Theme.phone-mut;
        font-size: 9px;
    }
    // 触控板
    Rectangle {
        x: 8px;
        y: root.pad-y;
        width: root.width - 16px;
        height: root.pad-h;
        border-radius: 14px;
        background: Theme.phone-tile;
        border-width: 1px;
        border-color: Theme.phone-line;
        Text {
            text: "触控板";
            color: Theme.phone-mut;
            font-size: 9.5px;
        }
    }
    // 一排按键
    if root.keys: Rectangle {
        x: 8px;
        y: root.pad-y + root.pad-h + 8px;
        width: root.width - 16px;
        height: 42px;
        for key[i] in [
            { icon: @image-url("../icons/copy.svg"), tone: 3 },
            { icon: @image-url("../icons/paste.svg"), tone: 2 },
            { icon: @image-url("../icons/enter.svg"), tone: 0 },
        ]: Rectangle {
            x: i * (parent.width + 8px) / 3;
            width: (parent.width - 16px) / 3;
            height: parent.height;
            border-radius: 12px;
            // 灰色键在手机底色上看不出来，画成和手机上一样的白底细边
            background: key.tone == 0 ? Theme.phone-tile : Theme.tone-bg(key.tone);
            border-width: key.tone == 0 ? 1px : 0px;
            border-color: Theme.phone-line;
            Image {
                width: 16px;
                height: 16px;
                source: key.icon;
                colorize: key.tone == 0 ? Theme.phone-fg : Theme.tone-fg(key.tone);
            }
        }
    }
    // 语音按钮：按住时变绿，出现声波
    Rectangle {
        x: 8px;
        y: root.mic-y;
        width: root.width - 16px;
        height: 42px;
        border-radius: 21px;
        background: Theme.lime-dot.mix(Theme.phone-fg, root.listening);
        Rectangle {
            opacity: 1 - root.listening;
            HorizontalLayout {
                alignment: center;
                spacing: 5px;
                VerticalLayout {
                    alignment: center;
                    Image {
                        width: 13px;
                        height: 13px;
                        source: @image-url("../icons/mic.svg");
                        colorize: Theme.phone-bg;
                    }
                }
                Text {
                    text: "按住说话";
                    color: Theme.phone-bg;
                    font-size: 10px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
        for b in 5: Rectangle {
            x: parent.width / 2 - 21px + b * 9px;
            width: 4px;
            height: 4px + 16px * Tween.wave(Math.mod(root.since + b * 170, 640) / 640);
            border-radius: 2px;
            background: Theme.lime-fg;
            opacity: root.listening;
        }
    }
}

// 欢迎页小鸟旁边的泡泡：弹出来以后轻轻上下浮
component Orbit inherits Rectangle {
    in property <float> since;
    in property <float> delay;
    in property <image> icon;
    in property <int> tone;
    in property <length> cx;
    in property <length> cy;
    property <float> p: Tween.seg(root.since, root.delay, root.delay + 600);
    width: 54px;
    height: 54px;
    x: root.cx - 27px;
    y: root.cy - 27px + (1 - Tween.pop(root.p)) * 16px + Math.sin((root.since / 3000 + root.delay / 1000) * 360deg) * 4px;
    opacity: root.p;
    border-radius: 27px;
    background: Theme.tone-bg(root.tone);
    border-width: 3px;
    border-color: Theme.win;
    Image {
        width: 22px;
        height: 22px;
        source: root.icon;
        colorize: Theme.tone-fg(root.tone);
    }
}

// 一闪一闪的小星星
component Twinkle inherits Image {
    in property <float> since;
    in property <float> phase;
    in property <length> cx;
    in property <length> cy;
    width: 16px;
    height: 16px;
    x: root.cx - 8px;
    y: root.cy - 8px;
    source: @image-url("../icons/sparkle.svg");
    colorize: Theme.lime-dot;
    opacity: Tween.wave(Math.mod(root.since / 2400 + root.phase, 1));
}

// 「映射」插图下面的卡片：这个动作做什么。正在演示的那张显示出来，动作做完时边框亮一下
component MapCard inherits Rectangle {
    in property <bool> on;
    in property <float> flash;
    in property <string> label;
    width: 250px;
    height: 104px;
    opacity: root.on ? 1 : 0;
    visible: self.opacity > 0.01;
    animate opacity {
        duration: root.on ? 320ms : 160ms;
        delay: root.on ? 120ms : 0ms;
        easing: ease-out;
    }
    Rectangle {
        y: root.on ? 0px : 10px;
        width: root.width;
        height: root.height;
        border-radius: 16px;
        background: Theme.win;
        border-width: 1.5px;
        border-color: Theme.line2.mix(Theme.lime-dot, 1 - root.flash);
        animate y { duration: 480ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        Text {
            x: 16px;
            y: 14px;
            text: root.label;
            color: Theme.mut;
            font-size: 11px;
            font-weight: 600;
        }
        @children
    }
}

// 欢迎页、最后一页的插图：小鸟在光晕里轻轻浮着，旁边是触控板、按键、话筒三个泡泡；最后一页再打个勾、撒彩纸
component HelloStage inherits Stage {
    in property <bool> finale;
    property <length> mid-x: root.width / 2;
    property <length> mid-y: root.height * 0.44;
    property <float> enter: Tween.decel(Tween.seg(root.since, 0, 900));
    property <float> bob: Math.sin(root.since / 2800 * 360deg);
    property <color> glow-a: Theme.lime.with-alpha(Theme.dark ? 0.3 : 1);
    property <color> glow-b: Theme.lime.with-alpha(Theme.dark ? 0.14 : 0.55);
    pure function confetti(n: int) -> color {
        if (Math.mod(n, 5) == 0) {
            return #84cc16;
        }
        if (Math.mod(n, 5) == 1) {
            return #f59e0b;
        }
        if (Math.mod(n, 5) == 2) {
            return #60a5fa;
        }
        if (Math.mod(n, 5) == 3) {
            return #f472b6;
        }
        return #a78bfa;
    }
    // 光晕：慢慢地一明一暗
    Rectangle {
        x: root.mid-x - 140px;
        y: root.mid-y - 140px;
        width: 280px;
        height: 280px;
        border-radius: 140px;
        background: @radial-gradient(circle, root.glow-a 0%, root.glow-b 40%, Theme.lime.with-alpha(0) 70%);
        opacity: root.enter * (0.75 + 0.25 * Tween.wave(Math.mod(root.since, 4200) / 4200));
    }
    // 两圈细线，一前一后往外扩
    for k in 2: Rectangle {
        property <float> p: Math.mod(root.since + k * 2000, 4000) / 4000;
        width: 170px + 140px * self.p;
        height: self.width;
        x: root.mid-x - self.width / 2;
        y: root.mid-y - self.height / 2;
        border-radius: self.width / 2;
        border-width: 1.5px;
        border-color: Theme.lime-dot.with-alpha(0.45 * (1 - self.p) * root.enter);
    }
    // 小鸟
    Image {
        x: root.mid-x - 78px;
        y: root.mid-y - 78px + (1 - root.enter) * 24px + root.bob * 5px;
        width: 156px;
        height: 156px;
        opacity: root.enter;
        source: @image-url("../../assets/logo.svg");
    }
    // 三个泡泡：触控板、快捷键、语音
    Orbit {
        since: root.since;
        delay: 350;
        icon: @image-url("../icons/pad.svg");
        tone: 1;
        cx: root.mid-x - 112px;
        cy: root.mid-y - 74px;
    }
    Orbit {
        since: root.since;
        delay: 520;
        icon: @image-url("../icons/kbd.svg");
        tone: 3;
        cx: root.mid-x + 116px;
        cy: root.mid-y - 18px;
    }
    Orbit {
        since: root.since;
        delay: 690;
        icon: @image-url("../icons/mic.svg");
        tone: 2;
        cx: root.mid-x - 84px;
        cy: root.mid-y + 104px;
    }
    Twinkle {
        since: root.since;
        phase: 0;
        cx: root.mid-x + 70px;
        cy: root.mid-y - 112px;
    }
    Twinkle {
        since: root.since;
        phase: 0.33;
        cx: root.mid-x + 96px;
        cy: root.mid-y + 92px;
    }
    Twinkle {
        since: root.since;
        phase: 0.66;
        cx: root.mid-x - 138px;
        cy: root.mid-y + 14px;
    }
    // 最后一页：打个勾，撒彩纸
    if root.finale: Rectangle {
        property <float> p: Tween.seg(root.since, 700, 1200);
        x: root.mid-x + 34px;
        y: root.mid-y + 30px + (1 - Tween.pop(self.p)) * 14px + root.bob * 5px;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background: Theme.ink;
        border-width: 3px;
        border-color: Theme.win;
        opacity: self.p;
        Image {
            width: 22px;
            height: 22px;
            source: @image-url("../icons/check.svg");
            colorize: Theme.ink-fg;
        }
    }
    if root.finale: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        for n in 22: Rectangle {
            property <float> seed: Math.mod(n * 0.618034, 1);
            property <float> speed: 0.045 + Math.mod(n * 0.371, 1) * 0.05;
            x: 18px + (root.width - 44px) * self.seed + Math.sin((root.since / 1300 + n) * 60deg) * 9px;
            y: Math.mod(root.since * self.speed + self.seed * 640, 660) * 1px - 50px;
            width: Math.mod(n, 3) == 0 ? 8px : 5px;
            height: Math.mod(n, 3) == 0 ? 8px : 11px;
            border-radius: Math.mod(n, 3) == 0 ? 4px : 1.5px;
            background: root.confetti(n);
            opacity: Tween.seg(root.since, 300, 900) * 0.9;
        }
    }
}

// 「第 1 步」的插图：在手机桌面上点开蒜鸟，打开后是触控板、按键和语音按钮
component AppStage inherits Stage {
    property <float> t: Math.mod(root.since, 4800);
    property <length> phone-w: 168px;
    property <length> phone-h: 328px;
    property <length> phone-x: (root.width - root.phone-w) / 2;
    property <length> phone-y: (root.height - root.phone-h) / 2 - 6px;
    property <length> scr-w: root.phone-w - 10px;
    property <length> scr-h: root.phone-h - 10px;
    // 蒜鸟图标（屏幕里）：桌面第二排中间
    property <length> icon-x: (root.scr-w - 36px) / 2;
    property <length> icon-y: 104px;
    property <float> come: Tween.smooth(Tween.seg(root.t, 250, 1150));
    property <float> press: Tween.wave(Tween.seg(root.t, 1150, 1450));
    property <float> leave: Tween.smooth(Tween.seg(root.t, 1650, 2250));
    property <float> open: Tween.decel(Tween.seg(root.t, 1350, 1950));
    property <float> shut: Tween.seg(root.t, 4200, 4650);
    MiniPhone {
        x: root.phone-x;
        y: root.phone-y;
        width: root.phone-w;
        height: root.phone-h;
        // 状态栏
        Text {
            x: 16px;
            y: 6px;
            text: "9:41";
            color: Theme.phone-fg;
            font-size: 9.5px;
            font-weight: 700;
        }
        Rectangle {
            x: root.scr-w - 34px;
            y: 9px;
            width: 17px;
            height: 9px;
            border-radius: 2.5px;
            border-width: 1px;
            border-color: Theme.phone-fg.with-alpha(0.5);
            Rectangle {
                x: 2px;
                y: 2px;
                width: 10px;
                height: 5px;
                border-radius: 1px;
                background: Theme.phone-fg;
            }
        }
        // 桌面：三排图标，第二排中间是蒜鸟
        for app[i] in [
            { name: "clock", tone: 2 },
            { name: "music", tone: 3 },
            { name: "globe", tone: 4 },
            { name: "layers", tone: 0 },
            { name: "", tone: 1 },
            { name: "text", tone: 2 },
            { name: "mouse", tone: 4 },
            { name: "kbd", tone: 3 },
            { name: "app", tone: 0 },
        ]: Rectangle {
            x: root.icon-x + (Math.mod(i, 3) - 1) * 46px;
            y: 46px + Math.floor(i / 3) * 58px;
            width: 36px;
            height: 36px;
            border-radius: 11px;
            background: app.name == "" ? Theme.lime : app.tone == 0 ? Theme.phone-tile : Theme.tone-bg(app.tone);
            border-width: app.name != "" && app.tone == 0 ? 1px : 0px;
            border-color: Theme.phone-line;
            if app.name != "": Image {
                width: 17px;
                height: 17px;
                source: Icons.get(app.name);
                colorize: app.tone == 0 ? Theme.phone-fg : Theme.tone-fg(app.tone);
            }
            if app.name == "": Image {
                width: 30px;
                height: 30px;
                source: @image-url("../../assets/logo.svg");
            }
            // 图标下面的名字（画成一道灰线；蒜鸟的写出来）
            if app.name != "": Rectangle {
                x: 7px;
                y: 41px;
                width: 22px;
                height: 4px;
                border-radius: 2px;
                background: Theme.phone-line;
            }
        }
        Text {
            x: root.icon-x + 18px - self.width / 2;
            y: root.icon-y + 39px;
            text: "蒜鸟";
            color: Theme.phone-fg;
            font-size: 8.5px;
        }
        // 底下的常用栏
        Rectangle {
            x: 10px;
            y: root.scr-h - 62px;
            width: root.scr-w - 20px;
            height: 50px;
            border-radius: 17px;
            background: Theme.phone-tile;
            for d[i] in [{ name: "globe", tone: 4 }, { name: "text", tone: 3 }, { name: "music", tone: 2 }]: Rectangle {
                x: (parent.width - 34px) / 2 + (i - 1) * 44px;
                y: 8px;
                width: 34px;
                height: 34px;
                border-radius: 10px;
                background: Theme.tone-bg(d.tone);
                Image {
                    width: 16px;
                    height: 16px;
                    source: Icons.get(d.name);
                    colorize: Theme.tone-fg(d.tone);
                }
            }
        }
        // 点开：从图标那里放大到整个屏幕
        Rectangle {
            x: root.icon-x * (1 - root.open);
            y: root.icon-y * (1 - root.open);
            width: 36px + (root.scr-w - 36px) * root.open;
            height: 36px + (root.scr-h - 36px) * root.open;
            border-radius: 11px + 10px * root.open;
            background: Theme.phone-bg.mix(Theme.lime, root.open);
            opacity: 1 - root.shut;
            visible: root.open > 0 && root.shut < 1;
        }
        MiniApp {
            x: 0;
            y: 0;
            width: root.scr-w;
            height: root.scr-h;
            since: root.since;
            opacity: Tween.seg(root.open, 0.6, 1) * (1 - root.shut);
            visible: self.opacity > 0.01;
        }
    }
    Ripple {
        cx: root.phone-x + 5px + root.icon-x + 18px;
        cy: root.phone-y + 5px + root.icon-y + 18px;
        p: Tween.seg(root.t, 1200, 1800);
    }
    Finger {
        cx: Tween.lerp(root.phone-x + root.phone-w + 30px, root.phone-x + 5px + root.icon-x + 18px, root.come) + root.leave * 70px;
        cy: Tween.lerp(root.phone-y + root.phone-h - 20px, root.phone-y + 5px + root.icon-y + 18px, root.come) + root.leave * 150px;
        press: root.press;
        opacity: Tween.seg(root.t, 150, 450) * (1 - Tween.seg(root.t, 1750, 2200));
    }
}

// 「第 2 步」的插图：电脑的「添加设备」里点手机 → 两边核对同一串数字、点配对 → 两边都显示已配对
component PairStage inherits Stage {
    property <float> t: Math.mod(root.since, 7000);
    // 三段：找手机、核对数字、配好了
    property <float> a: Tween.seg(root.t, 0, 300) * (1 - Tween.seg(root.t, 2350, 2650));
    property <float> b: Tween.seg(root.t, 2500, 2800) * (1 - Tween.seg(root.t, 4250, 4550));
    property <float> c: Tween.seg(root.t, 4400, 4700) * (1 - Tween.seg(root.t, 6500, 6900));
    // 电脑：屏幕里面的左上角 (scr-x, scr-y)，宽 scr-w
    property <length> lap-w: 228px;
    property <length> lap-h: 140px;
    property <length> lap-x: (root.width - root.lap-w - 30px) / 2;
    property <length> lap-y: root.height * 0.08;
    property <length> scr-x: root.lap-x + 21px;
    property <length> scr-y: root.lap-y + 6px;
    property <length> scr-w: root.lap-w - 12px;
    // 手机
    property <length> phone-w: 118px;
    property <length> phone-h: 226px;
    property <length> phone-x: (root.width - root.phone-w) / 2;
    property <length> phone-y: root.height - root.phone-h - root.height * 0.07;
    property <length> app-w: root.phone-w - 10px;
    // 鼠标先点「我的手机」，再点「连接」
    property <float> aim: Tween.smooth(Tween.seg(root.t, 1100, 1850));
    property <float> aim2: Tween.smooth(Tween.seg(root.t, 2900, 3500));
    property <float> picked: Tween.seg(root.t, 2000, 2150);
    // 手机上的手指点「配对」
    property <float> come: Tween.smooth(Tween.seg(root.t, 2800, 3300));
    property <float> press: Tween.wave(Tween.seg(root.t, 3300, 3550));
    property <float> link: Tween.decel(Tween.seg(root.t, 4450, 4900)) * (1 - Tween.seg(root.t, 6500, 6900));
    MiniLaptop {
        x: root.lap-x;
        y: root.lap-y;
        screen-width: root.lap-w;
        screen-height: root.lap-h;
        // 找手机
        Rectangle {
            opacity: root.a;
            visible: self.opacity > 0.01;
            Text {
                x: 12px;
                y: 10px;
                text: "添加设备";
                color: Theme.fg;
                font-size: 11px;
                font-weight: 700;
            }
            Text {
                x: 12px;
                y: 27px;
                text: "选择要添加的设备";
                color: Theme.mut;
                font-size: 8.5px;
            }
            for row[i] in [
                { icon: @image-url("../icons/phone.svg"), name: "我的手机" },
                { icon: @image-url("../icons/music.svg"), name: "无线耳机" },
            ]: Rectangle {
                x: 10px;
                y: 46px + i * 36px;
                width: parent.width - 20px;
                height: 30px;
                border-radius: 8px;
                background: i == 0 ? Theme.soft.mix(Theme.lime, 1 - root.picked) : Theme.soft;
                opacity: Tween.seg(root.t, 500 + i * 300, 800 + i * 300);
                Image {
                    x: 9px;
                    width: 13px;
                    height: 13px;
                    source: row.icon;
                    colorize: Theme.fg2;
                }
                Text {
                    x: 29px;
                    text: row.name;
                    color: Theme.fg;
                    font-size: 10px;
                }
            }
        }
        // 核对数字
        Rectangle {
            opacity: root.b;
            visible: self.opacity > 0.01;
            Text {
                y: 12px;
                width: parent.width;
                horizontal-alignment: center;
                text: "核对两边的数字是否一样";
                color: Theme.mut;
                font-size: 8.5px;
            }
            Text {
                y: 28px;
                width: parent.width;
                horizontal-alignment: center;
                text: "385 216";
                color: Theme.fg;
                font-size: 24px;
                font-weight: 700;
            }
            Rectangle {
                x: parent.width / 2 - 66px;
                y: 84px;
                width: 60px;
                height: 26px;
                border-radius: 13px;
                background: Theme.ink;
                Text {
                    text: "连接";
                    color: Theme.ink-fg;
                    font-size: 10px;
                    font-weight: 600;
                }
            }
            Rectangle {
                x: parent.width / 2 + 6px;
                y: 84px;
                width: 60px;
                height: 26px;
                border-radius: 13px;
                background: Theme.soft;
                border-width: 1px;
                border-color: Theme.line2;
                Text {
                    text: "取消";
                    color: Theme.fg2;
                    font-size: 10px;
                }
            }
        }
        // 配好了
        Rectangle {
            opacity: root.c;
            visible: self.opacity > 0.01;
            Rectangle {
                x: (parent.width - 38px) / 2;
                y: 24px + (1 - Tween.pop(Tween.seg(root.t, 4450, 4900))) * 10px;
                width: 38px;
                height: 38px;
                border-radius: 19px;
                background: Theme.lime;
                Image {
                    width: 20px;
                    height: 20px;
                    source: @image-url("../icons/check.svg");
                    colorize: Theme.lime-fg;
                }
            }
            Text {
                y: 72px;
                width: parent.width;
                horizontal-alignment: center;
                text: "已配对";
                color: Theme.fg;
                font-size: 12px;
                font-weight: 700;
            }
            Text {
                y: 90px;
                width: parent.width;
                horizontal-alignment: center;
                text: "我的手机";
                color: Theme.mut;
                font-size: 9px;
            }
        }
    }
    // 中间的连线：没配好时一串小点一闪一闪，配好了变成一条绿线
    for k in 5: Rectangle {
        property <length> top: root.lap-y + root.lap-h + 20px;
        property <length> span: root.phone-y - 10px - self.top;
        x: root.width / 2 - 3px;
        y: self.top + self.span * (k + 0.5) / 5 - 3px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.mut;
        opacity: (0.25 + 0.75 * Tween.wave(Math.mod(root.since / 1200 - k * 0.2 + 1, 1))) * (1 - root.link);
    }
    Rectangle {
        x: root.width / 2 - 2px;
        y: root.lap-y + root.lap-h + 20px;
        width: 4px;
        height: (root.phone-y - 10px - self.y) * root.link;
        border-radius: 2px;
        background: Theme.lime-dot;
    }
    MiniPhone {
        x: root.phone-x;
        y: root.phone-y;
        width: root.phone-w;
        height: root.phone-h;
        // 手机停在蓝牙设置里，等电脑来找
        Rectangle {
            opacity: root.a;
            visible: self.opacity > 0.01;
            Text {
                x: 12px;
                y: 24px;
                text: "蓝牙";
                color: Theme.phone-fg;
                font-size: 12px;
                font-weight: 700;
            }
            Rectangle {
                x: parent.width - 36px;
                y: 26px;
                width: 24px;
                height: 14px;
                border-radius: 7px;
                background: Theme.green;
                Rectangle {
                    x: 12px;
                    y: 2px;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: #ffffff;
                }
            }
            for k in 2: Rectangle {
                property <float> p: Math.mod(root.since + k * 900, 1800) / 1800;
                width: 44px + 56px * self.p;
                height: self.width;
                x: (root.app-w - self.width) / 2;
                y: 104px - self.height / 2;
                border-radius: self.width / 2;
                border-width: 1.5px;
                border-color: Theme.lime-dot.with-alpha(0.6 * (1 - self.p));
            }
            Rectangle {
                x: (root.app-w - 44px) / 2;
                y: 82px;
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: Theme.phone-tile;
                border-width: 1px;
                border-color: Theme.phone-line;
                Image {
                    width: 20px;
                    height: 20px;
                    source: @image-url("../icons/bluetooth.svg");
                    colorize: Theme.phone-fg;
                }
            }
            Text {
                y: 146px;
                width: parent.width;
                horizontal-alignment: center;
                text: "停在这一页";
                color: Theme.phone-mut;
                font-size: 9px;
            }
        }
        // 弹出配对请求
        Rectangle {
            opacity: root.b;
            visible: self.opacity > 0.01;
            Rectangle {
                x: 8px;
                y: 60px;
                width: parent.width - 16px;
                height: 112px;
                border-radius: 14px;
                background: Theme.phone-tile;
                border-width: 1px;
                border-color: Theme.phone-line;
                Text {
                    y: 12px;
                    width: parent.width;
                    horizontal-alignment: center;
                    text: "配对请求";
                    color: Theme.phone-mut;
                    font-size: 8.5px;
                }
                Text {
                    y: 28px;
                    width: parent.width;
                    horizontal-alignment: center;
                    text: "385 216";
                    color: Theme.phone-fg;
                    font-size: 16px;
                    font-weight: 700;
                }
                Rectangle {
                    x: 10px;
                    y: 76px;
                    width: parent.width - 20px;
                    height: 26px;
                    border-radius: 13px;
                    background: Theme.phone-fg;
                    Text {
                        text: "配对";
                        color: Theme.phone-bg;
                        font-size: 10px;
                        font-weight: 600;
                    }
                }
            }
        }
        // 配好了
        Rectangle {
            opacity: root.c;
            visible: self.opacity > 0.01;
            Rectangle {
                x: (parent.width - 36px) / 2;
                y: 80px + (1 - Tween.pop(Tween.seg(root.t, 4500, 4950))) * 10px;
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: Theme.lime;
                Image {
                    width: 18px;
                    height: 18px;
                    source: @image-url("../icons/check.svg");
                    colorize: Theme.lime-fg;
                }
            }
            Text {
                y: 126px;
                width: parent.width;
                horizontal-alignment: center;
                text: "已配对";
                color: Theme.phone-fg;
                font-size: 11px;
                font-weight: 700;
            }
        }
    }
    Ripple {
        cx: root.scr-x + 108px;
        cy: root.scr-y + 61px;
        p: Tween.seg(root.t, 1950, 2400);
    }
    Ripple {
        cx: root.scr-x + root.scr-w / 2 - 36px;
        cy: root.scr-y + 97px;
        p: Tween.seg(root.t, 3550, 4000);
    }
    Ripple {
        cx: root.phone-x + 5px + root.app-w / 2;
        cy: root.phone-y + 5px + 149px;
        p: Tween.seg(root.t, 3350, 3800);
    }
    Finger {
        cx: Tween.lerp(root.phone-x + root.phone-w + 30px, root.phone-x + 5px + root.app-w / 2, root.come) + Tween.seg(root.t, 3700, 4100) * 60px;
        cy: Tween.lerp(root.phone-y + root.phone-h + 10px, root.phone-y + 5px + 149px, root.come) + Tween.seg(root.t, 3700, 4100) * 90px;
        press: root.press;
        opacity: Tween.seg(root.t, 2700, 2950) * (1 - Tween.seg(root.t, 3700, 4050));
    }
    Pointer {
        tip-x: Tween.lerp(Tween.lerp(root.scr-x + 180px, root.scr-x + 108px, root.aim), root.scr-x + root.scr-w / 2 - 36px, root.aim2);
        tip-y: Tween.lerp(Tween.lerp(root.scr-y + 118px, root.scr-y + 61px, root.aim), root.scr-y + 97px, root.aim2);
        opacity: Tween.seg(root.t, 800, 1100) * (1 - Tween.seg(root.t, 4100, 4400));
    }
}

// 插图里的一张照片（要传的文件）：浅绿底、黑边、小山和太阳，size 是宽
component TutPhoto inherits Rectangle {
    in property <length> size: 20px;
    width: root.size;
    height: root.size * 0.8;
    border-radius: root.size * 0.14;
    background: Theme.lime;
    border-width: Math.max(1.2px, root.size * 0.07);
    border-color: #141414;
    Path {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        viewbox-width: 100;
        viewbox-height: 80;
        commands: "M 14 64 L 40 35.2 L 58 52.8 L 70 43.2 L 86 64 Z";
        fill: #141414;
    }
    Rectangle {
        x: root.width * 0.72 - self.width / 2;
        y: root.height * 0.3 - self.height / 2;
        width: root.size * 0.16;
        height: self.width;
        border-radius: self.width / 2;
        background: #141414;
    }
}

// 「选一种连接方式」插图里的一条路（竖着，电脑在上、手机在下）：
// 没选是一串灰点；选中（on）变成黑实线、圆标外一圈绿、标签变绿；没选的那条（fade）整体变淡；
// off：网断了，圆标变灰、划一道斜杠。p 是路上那张照片走到哪了（0 手机 → 1 电脑），vis 是它的透明度
component ChoiceLane inherits Rectangle {
    in property <length> cx;
    in property <length> top;
    in property <length> bottom;
    in property <image> icon;
    in property <string> label;
    in property <bool> label-left;
    in property <float> on;
    in property <float> fade;
    in property <float> off;
    in property <float> p;
    in property <float> vis;
    property <length> cy: (root.top + root.bottom) / 2;
    property <length> r: 24px;
    property <color> grey: Theme.dark ? #4a4a50 : #c9c9c4;
    opacity: 1 - 0.78 * root.fade;
    for k in 11: Rectangle {
        property <length> dy: root.top + (root.bottom - root.top) * k / 10;
        x: root.cx - 2px;
        y: self.dy - 2px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: root.off > 0.5 ? Theme.line2 : (Theme.dark ? #5a5a60 : #b9b9b4);
        opacity: Math.abs(self.dy - root.cy) < root.r * 1.2 ? 0 : 1 - root.on;
    }
    // 选中：实线从电脑、手机两头往圆标长
    Rectangle {
        x: root.cx - 1.25px;
        y: root.top;
        width: 2.5px;
        height: (root.cy - root.r * 1.05 - root.top) * root.on;
        border-radius: 1.25px;
        background: Theme.ink;
    }
    Rectangle {
        x: root.cx - 1.25px;
        height: (root.bottom - root.cy - root.r * 1.05) * root.on;
        y: root.bottom - self.height;
        width: 2.5px;
        border-radius: 1.25px;
        background: Theme.ink;
    }
    Rectangle {
        x: root.cx - root.r;
        y: root.cy - root.r;
        width: root.r * 2;
        height: root.r * 2;
        border-radius: root.r;
        border-width: 2px;
        border-color: Theme.lime-dot.mix(root.grey, root.on);
        background: Theme.win.with-alpha(0.6);
        opacity: 1 - root.off;
    }
    Rectangle {
        x: root.cx - 17px;
        y: root.cy - 17px;
        width: 34px;
        height: 34px;
        border-radius: 17px;
        background: (Theme.dark ? #3a3a3f : #d4d4cf).mix(Theme.ink, root.off);
        Image {
            width: 17px;
            height: 17px;
            source: root.icon;
            colorize: Theme.ink-fg;
        }
    }
    Path {
        x: root.cx - root.r * 0.62;
        y: root.cy - root.r * 0.62;
        width: root.r * 1.24;
        height: root.r * 1.24;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M 0 0 L 10 10";
        stroke: Theme.ink;
        stroke-width: 2.5px;
        opacity: root.off;
    }
    // 标签：蓝牙挂在左边，局域网挂在右边
    Rectangle {
        height: 18px;
        width: lane-label.preferred-width + 14px;
        x: root.label-left ? root.cx - root.r * 1.3 - self.width : root.cx + root.r * 1.3;
        y: root.cy - 9px;
        border-radius: 9px;
        background: Theme.lime.mix(Theme.win, root.on);
        border-width: 1px;
        border-color: Theme.line2.with-alpha(1 - root.on);
        lane-label := Text {
            text: root.label;
            color: Theme.lime-fg.mix(Theme.mut, root.on);
            font-size: 10px;
            font-weight: 700;
        }
    }
    TutPhoto {
        size: 21px;
        x: root.cx - self.width / 2;
        y: root.bottom + (root.top - root.bottom) * root.p - self.height / 2;
        opacity: root.vis;
        visible: self.opacity > 0.01;
    }
}

// 「选一种连接方式」那页的插图：电脑在上、手机在下，中间两条路（左蓝牙、右局域网）。
// 还没选：两张照片同时出发，局域网的先到；接着网断了，蓝牙那张照样慢慢送到。
// 选了一种：没选的那条变淡，选中的变实线，照片在上面一张张送到电脑的「下载 › 蒜鸟」里
component ChooseStage inherits Stage {
    // 0 还没选 1 蓝牙 2 局域网
    in property <int> way;
    property <bool> on: root.active || root.opacity > 0.01;
    // 换了选择就从头放
    property <duration> mark;
    changed way => {
        root.mark = animation-tick();
    }
    property <float> el: root.on ? Math.min(root.since, (animation-tick() - root.mark) / 1ms) : 0;
    property <float> t0: Math.mod(root.el, 7400);
    property <float> t1: Math.mod(root.el, 3400);
    property <float> t2: Math.mod(root.el, 2400);
    property <float> back0: 1 - Tween.seg(root.t0, 6900, 7300);
    property <float> back1: 1 - Tween.seg(root.t1, 3000, 3300);
    property <float> back2: 1 - Tween.seg(root.t2, 2000, 2300);
    property <float> bt-on: root.way == 1 ? 1 : 0;
    property <float> lan-on: root.way == 2 ? 1 : 0;
    animate bt-on, lan-on { duration: 420ms; easing: ease-out; }
    // 蓝牙那张：走得慢
    property <float> bt-p: root.way == 0 ? Tween.seg(root.t0, 600, 5000) : root.way == 1 ? Tween.smooth(Tween.seg(root.t1, 300, 2500)) : 0;
    property <float> bt-vis: root.way == 0 ? Tween.seg(root.t0, 100, 400) * (1 - Tween.seg(root.t0, 4900, 5050)) : root.way == 1 ? Tween.seg(root.t1, 100, 300) * (1 - Tween.seg(root.t1, 2400, 2550)) : 0;
    property <float> bt-got: root.way == 0 ? Tween.seg(root.t0, 4950, 5150) * root.back0 : root.way == 1 ? Tween.seg(root.t1, 2450, 2650) * root.back1 : 0;
    property <float> bt-pop: root.way == 0 ? Tween.pop(Tween.seg(root.t0, 5050, 5350)) * root.back0 : root.way == 1 ? Tween.pop(Tween.seg(root.t1, 2550, 2850)) * root.back1 : 0;
    // 局域网那张：走得快
    property <float> lan-p: root.way == 0 ? Tween.decel(Tween.seg(root.t0, 600, 1500)) : root.way == 2 ? Tween.decel(Tween.seg(root.t2, 300, 1100)) : 0;
    property <float> lan-vis: root.way == 0 ? Tween.seg(root.t0, 100, 400) * (1 - Tween.seg(root.t0, 1450, 1600)) : root.way == 2 ? Tween.seg(root.t2, 100, 300) * (1 - Tween.seg(root.t2, 1050, 1200)) : 0;
    property <float> lan-got: root.way == 0 ? Tween.seg(root.t0, 1450, 1650) * root.back0 : root.way == 2 ? Tween.seg(root.t2, 1100, 1300) * root.back2 : 0;
    property <float> lan-pop: root.way == 0 ? Tween.pop(Tween.seg(root.t0, 1550, 1850)) * root.back0 : root.way == 2 ? Tween.pop(Tween.seg(root.t2, 1200, 1500)) * root.back2 : 0;
    // 网断了（只在还没选时演）
    property <float> lan-off: root.way == 0 ? Tween.seg(root.t0, 2300, 2600) * (1 - Tween.seg(root.t0, 6600, 6900)) : 0;
    property <length> oy: (root.height - 576px) / 2;
    MiniLaptop {
        x: 68px;
        y: root.oy + 93px;
        screen-width: 174px;
        screen-height: 118px;
        // 屏幕里面 162 × 106（@children 里的 parent 是整台电脑，所以写死）
        Rectangle {
            x: 4px;
            y: 4px;
            width: 154px;
            height: 98px;
            border-radius: 5px;
            background: Theme.dark ? Theme.soft : #efefec;
        }
        // 「下载 › 蒜鸟」：两个格子，左边收局域网那张，右边收蓝牙那张
        Rectangle {
            x: 23px;
            y: 14px;
            width: 115px;
            height: 78px;
            border-radius: 5px;
            background: Theme.win;
            border-width: 1px;
            border-color: Theme.line2;
            Text {
                x: 9px;
                y: 8px;
                text: "下载 › 蒜鸟";
                color: Theme.fg;
                font-size: 9px;
                font-weight: 700;
            }
            for slot[i] in [root.lan-got, root.bt-got]: Rectangle {
                x: 9px + i * 55px;
                y: 28px;
                width: 41px;
                height: 39px;
                Rectangle {
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: Theme.line2;
                    opacity: 1 - slot;
                }
                TutPhoto {
                    size: 35px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    opacity: slot;
                    visible: self.opacity > 0.01;
                }
                badge := Rectangle {
                    property <float> pop: i == 0 ? root.lan-pop : root.bt-pop;
                    width: 16px * self.pop;
                    height: self.width;
                    x: parent.width * 0.95 - self.width / 2;
                    y: parent.height * 0.1 - self.height / 2;
                    border-radius: self.width / 2;
                    background: Theme.lime-dot;
                    visible: self.pop > 0.01;
                    Image {
                        width: 10px * Math.min(badge.pop, 1);
                        height: self.width;
                        source: @image-url("../icons/check.svg");
                        colorize: #141414;
                    }
                }
            }
        }
    }
    ChoiceLane {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        cx: 133px;
        top: root.oy + 233px;
        bottom: root.oy + 365px;
        icon: @image-url("../icons/bluetooth.svg");
        label: "蓝牙";
        label-left: true;
        on: root.bt-on;
        fade: root.lan-on;
        p: root.bt-p;
        vis: root.bt-vis;
    }
    ChoiceLane {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        cx: 207px;
        top: root.oy + 233px;
        bottom: root.oy + 365px;
        icon: @image-url("../icons/wifi.svg");
        label: "局域网";
        label-left: false;
        on: root.lan-on;
        fade: root.bt-on;
        off: root.lan-off;
        p: root.lan-p;
        vis: root.lan-vis;
    }
    // 手机：屏幕是蒜鸟（简化）。屏幕里面 86 × 165（@children 里的 parent 是整部手机，所以写死）
    MiniPhone {
        x: 122px;
        y: root.oy + 375px;
        width: 96px;
        height: 175px;
        border-radius: 20px;
        Text {
            x: 9px;
            y: 10px;
            text: "蒜鸟";
            color: Theme.phone-fg;
            font-size: 9px;
            font-weight: 800;
        }
        Rectangle {
            x: 6px;
            y: 28px;
            width: 74px;
            height: 66px;
            border-radius: 8px;
            background: Theme.phone-tile;
            Text {
                text: "触控板";
                color: Theme.phone-mut;
                font-size: 7.5px;
            }
        }
        for k in 6: Rectangle {
            x: 6px + Math.mod(k, 3) * 26px;
            y: 102px + Math.floor(k / 3) * 23px;
            width: 22px;
            height: 18px;
            border-radius: 5px;
            background: Theme.phone-tile;
        }
    }
}

// 「扫码走局域网」那页的插图：电脑上出二维码，手机上蒜鸟的扫码界面对准、扫描线扫过，认出来打勾，
// 手机换成蒜鸟、顶上写「局域网」；中间小点变成绿线，Wi-Fi 标志外面一圈绿、旁边挂「局域网」
component LanStage inherits Stage {
    property <float> t: Math.mod(root.since, 7000);
    property <float> back: 1 - Tween.seg(root.t, 6500, 6900);
    property <float> qr-in: Tween.decel(Tween.seg(root.t, 200, 700));
    property <float> aim: Tween.smooth(Tween.seg(root.t, 900, 1500)) * root.back;
    property <float> sweep: Tween.seg(root.t, 1500, 3000);
    property <float> found: Tween.seg(root.t, 3000, 3150) * root.back;
    property <float> app: Tween.smooth(Tween.seg(root.t, 3600, 3950)) * root.back;
    property <float> link: Tween.decel(Tween.seg(root.t, 4000, 4450)) * root.back;
    property <float> bound: Tween.seg(root.t, 4100, 4300) * root.back;
    // 电脑：屏幕里面的左上角 (scr-x, scr-y)，和配对那页一样大
    property <length> lap-w: 228px;
    property <length> lap-h: 140px;
    property <length> lap-x: (root.width - root.lap-w - 30px) / 2;
    property <length> lap-y: root.height * 0.08;
    // 手机
    property <length> phone-w: 118px;
    property <length> phone-h: 226px;
    property <length> phone-x: (root.width - root.phone-w) / 2;
    property <length> phone-y: root.height - root.phone-h - root.height * 0.07;
    property <length> app-w: root.phone-w - 10px;
    property <length> app-h: root.phone-h - 10px;
    // 中间 Wi-Fi 标志的圆心
    property <length> mid-y: (root.lap-y + root.lap-h + 10px + root.phone-y) / 2;
    // 取景框
    property <length> vf: 64px;
    property <length> vf-x: (root.app-w - root.vf) / 2;
    property <length> vf-y: 62px;
    property <color> corner: root.found > 0.5 ? Theme.lime-dot : #ffffff;
    MiniLaptop {
        x: root.lap-x;
        y: root.lap-y;
        screen-width: root.lap-w;
        screen-height: root.lap-h;
        Text {
            x: 12px;
            y: 10px;
            text: "扫码连接手机";
            color: Theme.fg;
            font-size: 11px;
            font-weight: 700;
        }
        Rectangle {
            x: 12px;
            y: 30px;
            width: 86px;
            height: 86px;
            border-radius: 4px;
            background: #ffffff;
            border-width: 1px;
            border-color: Theme.line2;
            opacity: 0.4 + 0.6 * root.qr-in * Math.max(root.back, 0.4);
            Image {
                x: 5px;
                y: 5px;
                width: 76px;
                height: 76px;
                source: @image-url("../icons/qr-sample.svg");
                colorize: #141414;
            }
            // 绑好了：二维码上盖一层白，中间打勾
            Rectangle {
                background: #ffffff.with-alpha(0.82 * root.bound);
                border-radius: 4px;
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 38px * Tween.pop(Tween.seg(root.t, 4100, 4450)) * root.back;
                height: self.width;
                border-radius: self.width / 2;
                background: Theme.lime;
                visible: root.bound > 0.01;
                Image {
                    width: 20px;
                    height: 20px;
                    source: @image-url("../icons/check.svg");
                    colorize: Theme.lime-fg;
                    opacity: Tween.seg(root.t, 4250, 4450);
                }
            }
        }
        for k in 3: Rectangle {
            x: 112px;
            y: 44px + k * 16px;
            width: k == 2 ? 56px : 84px;
            height: 7px;
            border-radius: 3.5px;
            background: Theme.line2;
        }
        Text {
            x: 112px;
            y: 98px;
            text: "已绑定";
            color: Theme.lime-fg;
            font-size: 11px;
            font-weight: 700;
            opacity: root.bound;
        }
    }
    // 中间：没连上是一串小点一闪一闪、Wi-Fi 标志一圈圈往外扩；连上变成绿线，标志外面一圈绿、旁边挂「局域网」
    for k in 6: Rectangle {
        property <length> top: root.lap-y + root.lap-h + 20px;
        property <length> span: root.phone-y - 10px - self.top;
        x: root.width / 2 - 3px;
        y: self.top + self.span * (k + 0.5) / 6 - 3px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.mut;
        opacity: (0.25 + 0.75 * Tween.wave(Math.mod(root.since / 1200 - k * 0.2 + 1, 1))) * (1 - root.link);
    }
    Rectangle {
        x: root.width / 2 - 2px;
        y: root.lap-y + root.lap-h + 20px;
        width: 4px;
        height: (root.phone-y - 10px - self.y) * root.link;
        border-radius: 2px;
        background: Theme.lime-dot;
    }
    for k in 2: Rectangle {
        property <float> p: Math.mod(root.since + k * 700, 1400) / 1400;
        width: 44px + 30px * self.p;
        height: self.width;
        x: (root.width - self.width) / 2;
        y: root.mid-y - self.height / 2;
        border-radius: self.width / 2;
        border-width: 1.5px;
        border-color: Theme.mut.with-alpha(0.55 * (1 - self.p) * (1 - root.link));
    }
    Rectangle {
        width: 44px + 10px * root.link;
        height: self.width;
        x: (root.width - self.width) / 2;
        y: root.mid-y - self.height / 2;
        border-radius: self.width / 2;
        border-width: 2.5px;
        border-color: Theme.lime-dot.with-alpha(root.link);
        background: Theme.soft.with-alpha(root.link);
    }
    Rectangle {
        x: (root.width - 44px) / 2;
        y: root.mid-y - 22px;
        width: 44px;
        height: 44px;
        border-radius: 22px;
        background: Theme.ink;
        Image {
            width: 22px;
            height: 22px;
            source: @image-url("../icons/wifi.svg");
            colorize: Theme.ink-fg;
        }
    }
    Rectangle {
        x: root.width / 2 + 34px + (1 - root.link) * 6px;
        y: root.mid-y - 11px;
        width: lan-label.preferred-width + 18px;
        height: 22px;
        border-radius: 11px;
        background: Theme.lime;
        opacity: root.link;
        lan-label := Text {
            text: "局域网";
            color: Theme.lime-fg;
            font-size: 11px;
            font-weight: 700;
        }
    }
    MiniPhone {
        x: root.phone-x;
        y: root.phone-y;
        width: root.phone-w;
        height: root.phone-h;
        // 扫码界面
        Rectangle {
            border-radius: 21px;
            background: #262624;
            opacity: 1 - root.app;
            visible: self.opacity > 0.01;
            Text {
                y: 22px;
                width: parent.width;
                horizontal-alignment: center;
                text: "扫码";
                color: #ffffff;
                font-size: 11px;
                font-weight: 700;
            }
            // 对准了：取景框里出现二维码（从大、偏一点到正好放进框里）
            Rectangle {
                width: Tween.lerp(84px, 54px, root.aim);
                height: self.width;
                x: root.vf-x + (root.vf - self.width) / 2 + (1 - root.aim) * 16px;
                y: root.vf-y + (root.vf - self.height) / 2 - (1 - root.aim) * 10px;
                border-radius: 3px;
                background: #ffffff;
                opacity: root.aim;
                visible: self.opacity > 0.01;
                Image {
                    x: parent.width * 0.06;
                    y: parent.height * 0.06;
                    width: parent.width * 0.88;
                    height: parent.height * 0.88;
                    source: @image-url("../icons/qr-sample.svg");
                    colorize: #262624;
                }
            }
            // 取景框的四个角
            for cn[i] in [
                { x: 0, y: 0 }, { x: 1, y: 0 }, { x: 0, y: 1 }, { x: 1, y: 1 },
            ]: Rectangle {
                x: root.vf-x + cn.x * (root.vf - 14px);
                y: root.vf-y + cn.y * (root.vf - 14px);
                width: 14px;
                height: 14px;
                Rectangle {
                    y: cn.y * 11.5px;
                    width: 14px;
                    height: 2.5px;
                    border-radius: 1.25px;
                    background: root.corner;
                }
                Rectangle {
                    x: cn.x * 11.5px;
                    width: 2.5px;
                    height: 14px;
                    border-radius: 1.25px;
                    background: root.corner;
                }
            }
            // 扫描线：对准以后从上往下扫两遍，认出来就停
            Rectangle {
                property <length> line-y: root.vf-y + 4px + (root.vf - 8px) * Math.mod(root.sweep * 2, 1);
                x: root.vf-x + 4px;
                y: self.line-y - 16px;
                width: root.vf - 8px;
                height: 16px;
                background: @linear-gradient(180deg, Theme.lime-dot.with-alpha(0) 0%, Theme.lime-dot.with-alpha(0.4) 100%);
                opacity: root.sweep > 0 && root.found < 1 ? 1 - root.found : 0;
            }
            Rectangle {
                x: root.vf-x + 3px;
                y: root.vf-y + 4px + (root.vf - 8px) * Math.mod(root.sweep * 2, 1) - 1px;
                width: root.vf - 6px;
                height: 2.5px;
                border-radius: 1.25px;
                background: Theme.lime-dot;
                opacity: root.sweep > 0 && root.found < 1 ? 1 - root.found : 0;
            }
            // 认出来了：中间一个绿圈打勾
            Rectangle {
                width: 30px * Tween.pop(Tween.seg(root.t, 3000, 3350)) * root.back;
                height: self.width;
                x: root.vf-x + (root.vf - self.width) / 2;
                y: root.vf-y + (root.vf - self.height) / 2;
                border-radius: self.width / 2;
                background: Theme.lime-dot;
                visible: root.found > 0.01;
                Image {
                    width: 16px;
                    height: 16px;
                    source: @image-url("../icons/check.svg");
                    colorize: #141414;
                    opacity: Tween.seg(root.t, 3100, 3300);
                }
            }
            Text {
                y: root.app-h - 40px;
                width: parent.width;
                horizontal-alignment: center;
                text: root.found > 0.5 ? "正在连接…" : "对准电脑上的二维码";
                color: #cfcfca;
                font-size: 8.5px;
            }
        }
        // 认出来以后换成蒜鸟：顶上先写「连接中」，连上写「局域网」
        MiniApp {
            x: 0;
            y: 0;
            width: root.app-w;
            height: root.app-h;
            since: root.since;
            online: root.link > 0.5;
            status-text: root.link > 0.5 ? "局域网" : "连接中";
            opacity: root.app;
            visible: self.opacity > 0.01;
        }
    }
}

// 「让手机扫码配对」那页的插图：电脑上出二维码，手机扫码界面对准、扫描线扫过；手机底下弹出系统的「蓝牙配对请求」，
// 手指点「配对」，电脑上挂出「自动同意」；配好了手机换成蒜鸟、顶上写「蓝牙」，中间小点变成绿线、二维码打勾
component ScanPairStage inherits Stage {
    property <float> t: Math.mod(root.since, 7600);
    property <float> back: 1 - Tween.seg(root.t, 7100, 7500);
    property <float> qr-in: Tween.decel(Tween.seg(root.t, 200, 700));
    property <float> aim: Tween.smooth(Tween.seg(root.t, 900, 1500)) * root.back;
    property <float> sweep: Tween.seg(root.t, 1500, 2600);
    property <float> found: Tween.seg(root.t, 2600, 2750) * root.back;
    property <float> prompt: Tween.decel(Tween.seg(root.t, 2900, 3300)) * root.back;
    property <float> tap: Tween.seg(root.t, 3900, 4300);
    property <float> agree: Tween.smooth(Tween.seg(root.t, 4000, 4300)) * root.back;
    property <float> app: Tween.smooth(Tween.seg(root.t, 4700, 5050)) * root.back;
    property <float> link: Tween.decel(Tween.seg(root.t, 5100, 5550)) * root.back;
    property <float> bound: Tween.seg(root.t, 5200, 5400) * root.back;
    // 电脑、手机的位置和局域网那页一样
    property <length> lap-w: 228px;
    property <length> lap-h: 140px;
    property <length> lap-x: (root.width - root.lap-w - 30px) / 2;
    property <length> lap-y: root.height * 0.08;
    property <length> phone-w: 118px;
    property <length> phone-h: 226px;
    property <length> phone-x: (root.width - root.phone-w) / 2;
    property <length> phone-y: root.height - root.phone-h - root.height * 0.07;
    property <length> app-w: root.phone-w - 10px;
    property <length> app-h: root.phone-h - 10px;
    property <length> mid-y: (root.lap-y + root.lap-h + 10px + root.phone-y) / 2;
    property <length> vf: 64px;
    property <length> vf-x: (root.app-w - root.vf) / 2;
    property <length> vf-y: 62px;
    property <color> corner: root.found > 0.5 ? Theme.lime-dot : #ffffff;
    // 系统的配对框
    property <length> sheet-h: 96px;
    MiniLaptop {
        x: root.lap-x;
        y: root.lap-y;
        screen-width: root.lap-w;
        screen-height: root.lap-h;
        Text {
            x: 12px;
            y: 10px;
            text: "扫码连接手机";
            color: Theme.fg;
            font-size: 11px;
            font-weight: 700;
        }
        Rectangle {
            x: 12px;
            y: 30px;
            width: 86px;
            height: 86px;
            border-radius: 4px;
            background: #ffffff;
            border-width: 1px;
            border-color: Theme.line2;
            opacity: 0.4 + 0.6 * root.qr-in * Math.max(root.back, 0.4);
            Image {
                x: 5px;
                y: 5px;
                width: 76px;
                height: 76px;
                source: @image-url("../icons/qr-sample.svg");
                colorize: #141414;
            }
            Rectangle {
                background: #ffffff.with-alpha(0.82 * root.bound);
                border-radius: 4px;
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 38px * Tween.pop(Tween.seg(root.t, 5200, 5550)) * root.back;
                height: self.width;
                border-radius: self.width / 2;
                background: Theme.lime;
                visible: root.bound > 0.01;
                Image {
                    width: 20px;
                    height: 20px;
                    source: @image-url("../icons/check.svg");
                    colorize: Theme.lime-fg;
                    opacity: Tween.seg(root.t, 5350, 5550);
                }
            }
        }
        for k in 3: Rectangle {
            x: 112px;
            y: 44px + k * 16px;
            width: k == 2 ? 56px : 84px;
            height: 7px;
            border-radius: 3.5px;
            background: Theme.line2;
            opacity: 1 - root.bound;
        }
        // 手机点了「配对」：电脑这边挂出「自动同意」
        Rectangle {
            x: 112px + (1 - root.agree) * 6px;
            y: 94px;
            width: agree-row.preferred-width + 14px;
            height: 18px;
            border-radius: 9px;
            background: Theme.lime;
            opacity: root.agree * (1 - root.bound);
            agree-row := HorizontalLayout {
                padding-left: 7px;
                padding-right: 7px;
                spacing: 3px;
                alignment: center;
                Image {
                    y: (parent.height - self.height) / 2;
                    width: 9px;
                    height: 9px;
                    source: @image-url("../icons/check.svg");
                    colorize: Theme.lime-fg;
                }
                Text {
                    text: "自动同意";
                    color: Theme.lime-fg;
                    font-size: 9px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            x: 112px;
            y: 50px;
            width: 90px;
            text: "已用蓝牙\n配对";
            color: Theme.lime-fg;
            font-size: 11px;
            font-weight: 700;
            opacity: root.bound;
        }
    }
    // 中间：没连上是一串小点一闪一闪、蓝牙标志一圈圈往外扩；连上变成绿线，标志外面一圈绿、旁边挂「蓝牙」
    for k in 6: Rectangle {
        property <length> top: root.lap-y + root.lap-h + 20px;
        property <length> span: root.phone-y - 10px - self.top;
        x: root.width / 2 - 3px;
        y: self.top + self.span * (k + 0.5) / 6 - 3px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.mut;
        opacity: (0.25 + 0.75 * Tween.wave(Math.mod(root.since / 1200 - k * 0.2 + 1, 1))) * (1 - root.link);
    }
    Rectangle {
        x: root.width / 2 - 2px;
        y: root.lap-y + root.lap-h + 20px;
        width: 4px;
        height: (root.phone-y - 10px - self.y) * root.link;
        border-radius: 2px;
        background: Theme.lime-dot;
    }
    for k in 2: Rectangle {
        property <float> p: Math.mod(root.since + k * 700, 1400) / 1400;
        width: 44px + 30px * self.p;
        height: self.width;
        x: (root.width - self.width) / 2;
        y: root.mid-y - self.height / 2;
        border-radius: self.width / 2;
        border-width: 1.5px;
        border-color: Theme.mut.with-alpha(0.55 * (1 - self.p) * (1 - root.link));
    }
    Rectangle {
        width: 44px + 10px * root.link;
        height: self.width;
        x: (root.width - self.width) / 2;
        y: root.mid-y - self.height / 2;
        border-radius: self.width / 2;
        border-width: 2.5px;
        border-color: Theme.lime-dot.with-alpha(root.link);
        background: Theme.soft.with-alpha(root.link);
    }
    Rectangle {
        x: (root.width - 44px) / 2;
        y: root.mid-y - 22px;
        width: 44px;
        height: 44px;
        border-radius: 22px;
        background: Theme.ink;
        Image {
            width: 22px;
            height: 22px;
            source: @image-url("../icons/bluetooth.svg");
            colorize: Theme.ink-fg;
        }
    }
    Rectangle {
        x: root.width / 2 + 34px + (1 - root.link) * 6px;
        y: root.mid-y - 11px;
        width: bt-label.preferred-width + 18px;
        height: 22px;
        border-radius: 11px;
        background: Theme.lime;
        opacity: root.link;
        bt-label := Text {
            text: "蓝牙";
            color: Theme.lime-fg;
            font-size: 11px;
            font-weight: 700;
        }
    }
    MiniPhone {
        x: root.phone-x;
        y: root.phone-y;
        width: root.phone-w;
        height: root.phone-h;
        // 扫码界面
        Rectangle {
            border-radius: 21px;
            background: #262624;
            clip: true;
            opacity: 1 - root.app;
            visible: self.opacity > 0.01;
            Text {
                y: 22px;
                width: parent.width;
                horizontal-alignment: center;
                text: "扫码配对";
                color: #ffffff;
                font-size: 11px;
                font-weight: 700;
            }
            Rectangle {
                width: Tween.lerp(84px, 54px, root.aim);
                height: self.width;
                x: root.vf-x + (root.vf - self.width) / 2 + (1 - root.aim) * 16px;
                y: root.vf-y + (root.vf - self.height) / 2 - (1 - root.aim) * 10px;
                border-radius: 3px;
                background: #ffffff;
                opacity: root.aim;
                visible: self.opacity > 0.01;
                Image {
                    x: parent.width * 0.06;
                    y: parent.height * 0.06;
                    width: parent.width * 0.88;
                    height: parent.height * 0.88;
                    source: @image-url("../icons/qr-sample.svg");
                    colorize: #262624;
                }
            }
            for cn[i] in [
                { x: 0, y: 0 }, { x: 1, y: 0 }, { x: 0, y: 1 }, { x: 1, y: 1 },
            ]: Rectangle {
                x: root.vf-x + cn.x * (root.vf - 14px);
                y: root.vf-y + cn.y * (root.vf - 14px);
                width: 14px;
                height: 14px;
                Rectangle {
                    y: cn.y * 11.5px;
                    width: 14px;
                    height: 2.5px;
                    border-radius: 1.25px;
                    background: root.corner;
                }
                Rectangle {
                    x: cn.x * 11.5px;
                    width: 2.5px;
                    height: 14px;
                    border-radius: 1.25px;
                    background: root.corner;
                }
            }
            Rectangle {
                property <length> line-y: root.vf-y + 4px + (root.vf - 8px) * Math.mod(root.sweep * 2, 1);
                x: root.vf-x + 4px;
                y: self.line-y - 16px;
                width: root.vf - 8px;
                height: 16px;
                background: @linear-gradient(180deg, Theme.lime-dot.with-alpha(0) 0%, Theme.lime-dot.with-alpha(0.4) 100%);
                opacity: root.sweep > 0 && root.found < 1 ? 1 - root.found : 0;
            }
            Rectangle {
                x: root.vf-x + 3px;
                y: root.vf-y + 4px + (root.vf - 8px) * Math.mod(root.sweep * 2, 1) - 1px;
                width: root.vf - 6px;
                height: 2.5px;
                border-radius: 1.25px;
                background: Theme.lime-dot;
                opacity: root.sweep > 0 && root.found < 1 ? 1 - root.found : 0;
            }
            Text {
                y: root.app-h - 40px;
                width: parent.width;
                horizontal-alignment: center;
                text: "对准电脑上的二维码";
                color: #cfcfca;
                font-size: 8.5px;
                opacity: 1 - root.prompt;
            }
            // 系统弹的「蓝牙配对请求」：从底下滑上来，手指点「配对」
            Rectangle {
                x: 5px;
                y: root.app-h - 5px - root.sheet-h * root.prompt;
                width: root.app-w - 10px;
                height: root.sheet-h;
                border-radius: 14px;
                background: #ffffff;
                visible: root.prompt > 0.01;
                Text {
                    y: 10px;
                    width: parent.width;
                    horizontal-alignment: center;
                    text: "蓝牙配对请求";
                    color: #141414;
                    font-size: 8.5px;
                    font-weight: 700;
                }
                Text {
                    y: 24px;
                    width: parent.width;
                    horizontal-alignment: center;
                    text: "PC-20260715VSWE";
                    color: #8a8a85;
                    font-size: 6px;
                }
                Text {
                    y: 36px;
                    width: parent.width;
                    horizontal-alignment: center;
                    text: "385 216";
                    color: #141414;
                    font-size: 14px;
                    font-weight: 700;
                }
                Rectangle {
                    x: 8px;
                    y: parent.height - 30px;
                    width: (parent.width - 22px) / 2;
                    height: 20px;
                    border-radius: 10px;
                    background: #ecece8;
                    Text {
                        text: "取消";
                        color: #555550;
                        font-size: 7.5px;
                    }
                }
                ok := Rectangle {
                    x: parent.width / 2 + 3px;
                    y: parent.height - 30px;
                    width: (parent.width - 22px) / 2;
                    height: 20px;
                    border-radius: 10px;
                    background: #141414;
                    Text {
                        text: "配对";
                        color: #ffffff;
                        font-size: 7.5px;
                        font-weight: 700;
                    }
                }
                // 手指点下去：一个圈从按钮中间扩开、变淡
                Rectangle {
                    width: 14px + 22px * root.tap;
                    height: self.width;
                    x: ok.x + ok.width / 2 - self.width / 2;
                    y: ok.y + ok.height / 2 - self.height / 2;
                    border-radius: self.width / 2;
                    border-width: 2px;
                    border-color: Theme.lime-dot.with-alpha(root.tap > 0 && root.tap < 1 ? 1 - root.tap : 0);
                    background: Theme.lime-dot.with-alpha(root.tap > 0 && root.tap < 1 ? 0.35 * (1 - root.tap) : 0);
                }
            }
        }
        // 配好了换成蒜鸟：顶上先写「连接中」，连上写「蓝牙」
        MiniApp {
            x: 0;
            y: 0;
            width: root.app-w;
            height: root.app-h;
            since: root.since;
            online: root.link > 0.5;
            status-text: root.link > 0.5 ? "蓝牙" : "连接中";
            opacity: root.app;
            visible: self.opacity > 0.01;
        }
    }
}

// 「第 3 步」的插图：手机上打开「选择电脑」，点这台电脑，顶上显示「已连接」
component PickStage inherits Stage {
    in property <string> computer;
    property <float> t: Math.mod(root.since, 5400);
    property <length> phone-w: 178px;
    property <length> phone-h: 348px;
    property <length> phone-x: (root.width - root.phone-w) / 2;
    property <length> phone-y: (root.height - root.phone-h) / 2 - 6px;
    property <length> scr-w: root.phone-w - 10px;
    property <length> scr-h: root.phone-h - 10px;
    // 「选择电脑」：从底下浮上来，选好了沉下去
    property <float> sheet: Tween.decel(Tween.seg(root.t, 250, 800)) * (1 - Tween.smooth(Tween.seg(root.t, 2350, 2800)));
    property <length> card-h: 200px;
    property <length> card-y: root.scr-h - 8px - root.card-h + (1 - root.sheet) * 28px;
    // 第一行的中心（插图里）
    property <length> row-x: root.phone-x + 5px + root.scr-w / 2;
    property <length> row-y: root.phone-y + 5px + root.scr-h - 8px - root.card-h + 79px;
    property <float> come: Tween.smooth(Tween.seg(root.t, 800, 1450));
    property <float> press: Tween.wave(Tween.seg(root.t, 1450, 1700));
    property <float> leave: Tween.smooth(Tween.seg(root.t, 1800, 2300));
    property <float> picked: Tween.seg(root.t, 1550, 1750) * (1 - Tween.seg(root.t, 4900, 5300));
    property <float> linked: Tween.seg(root.t, 2650, 2950) * (1 - Tween.seg(root.t, 4900, 5300));
    MiniPhone {
        x: root.phone-x;
        y: root.phone-y;
        width: root.phone-w;
        height: root.phone-h;
        MiniApp {
            x: 0;
            y: 0;
            width: root.scr-w;
            height: root.scr-h;
            since: root.since;
            online: root.linked > 0.5;
        }
        // 连上了：在触控板上方弹出来
        Rectangle {
            property <float> p: Tween.pop(Tween.seg(root.t, 2650, 3100));
            x: (root.scr-w - self.width) / 2;
            y: 62px + (1 - self.p) * 10px;
            width: Math.min(root.scr-w - 20px, linked-row.preferred-width);
            height: 26px;
            border-radius: 13px;
            background: Theme.ink;
            opacity: root.linked;
            visible: self.opacity > 0.01;
            linked-row := HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 5px;
                VerticalLayout {
                    alignment: center;
                    Image {
                        width: 11px;
                        height: 11px;
                        source: @image-url("../icons/check.svg");
                        colorize: Theme.ink-fg;
                    }
                }
                Text {
                    text: "已连接 · " + root.computer;
                    color: Theme.ink-fg;
                    font-size: 9.5px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: 0px;
                }
            }
        }
        // 遮罩
        Rectangle {
            width: root.scr-w;
            height: root.scr-h;
            border-radius: 21px;
            background: #000000.with-alpha(0.3 * root.sheet);
            visible: root.sheet > 0;
        }
        // 「选择电脑」
        Rectangle {
            x: 6px;
            y: root.card-y;
            width: root.scr-w - 12px;
            height: root.card-h;
            border-radius: 18px;
            background: Theme.phone-tile;
            opacity: Math.min(1, root.sheet * 1.6);
            visible: root.sheet > 0;
            Rectangle {
                x: (parent.width - 26px) / 2;
                y: 7px;
                width: 26px;
                height: 4px;
                border-radius: 2px;
                background: Theme.phone-line;
            }
            Text {
                x: 14px;
                y: 18px;
                text: "选择电脑";
                color: Theme.phone-fg;
                font-size: 12.5px;
                font-weight: 700;
            }
            Text {
                x: 14px;
                y: 37px;
                text: "和这部手机配对过的电脑";
                color: Theme.phone-mut;
                font-size: 8.5px;
            }
            for row[i] in [root.computer, "办公室的电脑"]: Rectangle {
                x: 8px;
                y: 58px + i * 48px;
                width: parent.width - 16px;
                height: 42px;
                border-radius: 12px;
                background: i == 0 ? Theme.phone-bg.mix(Theme.lime, 1 - root.picked) : Theme.phone-bg;
                Rectangle {
                    x: 7px;
                    width: 28px;
                    height: 28px;
                    border-radius: 9px;
                    background: Theme.phone-tile;
                    // 小显示器
                    Rectangle {
                        y: 8px;
                        width: 14px;
                        height: 10px;
                        border-radius: 2px;
                        border-width: 1.5px;
                        border-color: Theme.phone-fg;
                    }
                    Rectangle {
                        y: 20px;
                        width: 7px;
                        height: 1.5px;
                        background: Theme.phone-fg;
                    }
                }
                Text {
                    x: 43px;
                    y: 7px;
                    width: parent.width - 43px - 24px;
                    text: row;
                    color: i == 0 ? Theme.phone-fg.mix(Theme.lime-fg, 1 - root.picked) : Theme.phone-fg;
                    font-size: 10.5px;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    x: 43px;
                    y: 23px;
                    text: "电脑";
                    color: i == 0 ? Theme.phone-mut.mix(Theme.lime-fg, 1 - root.picked) : Theme.phone-mut;
                    font-size: 8.5px;
                }
                if i == 0: Image {
                    x: parent.width - 21px;
                    width: 13px;
                    height: 13px;
                    source: @image-url("../icons/check.svg");
                    colorize: Theme.lime-fg;
                    opacity: root.picked;
                }
            }
            Text {
                x: 14px;
                y: 166px;
                text: "去蓝牙设置配对新电脑";
                color: Theme.phone-mut;
                font-size: 8.5px;
            }
        }
    }
    Ripple {
        cx: root.row-x;
        cy: root.row-y;
        p: Tween.seg(root.t, 1500, 2000);
    }
    Finger {
        cx: Tween.lerp(root.phone-x + root.phone-w + 26px, root.row-x, root.come) + root.leave * 60px;
        cy: Tween.lerp(root.phone-y + root.phone-h + 10px, root.row-y, root.come) + root.leave * 120px;
        press: root.press;
        opacity: Tween.seg(root.t, 650, 900) * (1 - Tween.seg(root.t, 1800, 2200));
    }
}

// 「布局」的插图：把一个新按键拖到手机上的空格子，松手就放好了，自动保存
component LayoutStage inherits Stage {
    property <float> t: Math.mod(root.since, 5800);
    property <length> phone-w: 166px;
    property <length> phone-h: 324px;
    property <length> phone-x: (root.width - root.phone-w) / 2 - 24px;
    property <length> phone-y: (root.height - root.phone-h) / 2 - 18px;
    property <length> scr-x: root.phone-x + 5px;
    property <length> scr-y: root.phone-y + 5px;
    // 屏幕上的格子：4 列 6 排
    property <length> cell-w: (root.phone-w - 10px - 20px - 18px) / 4;
    property <length> cell-h: 40px;
    // 新按键：一开始在手机右边，拖到第 3 列第 4 排
    property <length> from-x: root.phone-x + root.phone-w + 22px;
    property <length> from-y: root.scr-y + root.row-y(3) - 20px;
    property <length> to-x: root.scr-x + root.col-x(2);
    property <length> to-y: root.scr-y + root.row-y(3);
    property <float> aim: Tween.smooth(Tween.seg(root.t, 300, 900));
    property <float> grab: Tween.seg(root.t, 950, 1100);
    property <float> drag: Tween.smooth(Tween.seg(root.t, 1100, 2300));
    property <float> drop: Tween.seg(root.t, 2300, 2450);
    property <float> away: Tween.smooth(Tween.seg(root.t, 2500, 3100));
    property <float> saved: Tween.seg(root.t, 2550, 2850) * (1 - Tween.seg(root.t, 4800, 5100));
    property <float> reset: Tween.seg(root.t, 5200, 5600);
    property <float> lift: root.grab * (1 - root.drop);
    // 第 c 列、第 r 排格子的左上角（屏幕里）
    pure function col-x(c: int) -> length {
        return 10px + c * (root.cell-w + 6px);
    }
    pure function row-y(r: int) -> length {
        return 34px + r * (root.cell-h + 6px);
    }
    MiniPhone {
        x: root.phone-x;
        y: root.phone-y;
        width: root.phone-w;
        height: root.phone-h;
        // 触控板：前三排
        Rectangle {
            x: root.col-x(0);
            y: root.row-y(0);
            width: 4 * root.cell-w + 18px;
            height: 3 * root.cell-h + 12px;
            border-radius: 12px;
            background: Theme.phone-tile;
            border-width: 1px;
            border-color: Theme.phone-line;
            Text {
                text: "触控板";
                color: Theme.phone-mut;
                font-size: 9.5px;
            }
        }
        // 第 4、5 排的按键（第 4 排右边两格空着）
        for key in [
            { c: 0, r: 3, icon: "enter", tone: 0 },
            { c: 1, r: 3, icon: "del", tone: 2 },
            { c: 0, r: 4, icon: "left", tone: 0 },
            { c: 1, r: 4, icon: "up", tone: 0 },
            { c: 2, r: 4, icon: "down", tone: 0 },
            { c: 3, r: 4, icon: "right", tone: 0 },
        ]: Rectangle {
            x: root.col-x(key.c);
            y: root.row-y(key.r);
            width: root.cell-w;
            height: root.cell-h;
            border-radius: 9px;
            background: key.tone == 0 ? Theme.phone-tile : Theme.tone-bg(key.tone);
            border-width: key.tone == 0 ? 1px : 0px;
            border-color: Theme.phone-line;
            Image {
                width: 13px;
                height: 13px;
                source: Icons.get(key.icon);
                colorize: key.tone == 0 ? Theme.phone-fg : Theme.tone-fg(key.tone);
            }
        }
        for c in [2, 3]: Rectangle {
            x: root.col-x(c);
            y: root.row-y(3);
            width: root.cell-w;
            height: root.cell-h;
            border-radius: 9px;
            border-width: 1px;
            border-color: Theme.phone-line;
        }
        // 语音按钮：最后一排
        Rectangle {
            x: root.col-x(0);
            y: root.row-y(5);
            width: 4 * root.cell-w + 18px;
            height: root.cell-h;
            border-radius: root.cell-h / 2;
            background: Theme.phone-fg;
            Image {
                width: 14px;
                height: 14px;
                source: @image-url("../icons/mic.svg");
                colorize: Theme.phone-bg;
            }
        }
    }
    // 右边：新按键
    Rectangle {
        x: root.from-x - 9px;
        y: root.from-y - 26px;
        width: root.cell-w + 18px;
        height: root.cell-h + 36px;
        border-radius: 12px;
        background: Theme.win;
        border-width: 1px;
        border-color: Theme.line2;
        Text {
            y: 8px;
            width: parent.width;
            horizontal-alignment: center;
            text: "新按键";
            color: Theme.mut;
            font-size: 9px;
        }
    }
    // 拖到空格子上方时，格子亮起来
    Rectangle {
        x: root.to-x - 2px;
        y: root.to-y - 2px;
        width: root.cell-w + 4px;
        height: root.cell-h + 4px;
        border-radius: 11px;
        border-width: 2px;
        border-color: Theme.lime-dot;
        background: Theme.lime.with-alpha(0.5);
        opacity: Tween.seg(root.t, 1700, 2100) * (1 - root.drop);
    }
    // 拖着的按键
    Rectangle {
        x: Tween.lerp(root.from-x, root.to-x, root.drag);
        y: Tween.lerp(root.from-y, root.to-y, root.drag) - 5px * root.lift;
        width: root.cell-w;
        height: root.cell-h;
        border-radius: 9px;
        background: Theme.tone-bg(3);
        border-width: 2px;
        border-color: Theme.lime-dot.with-alpha(root.lift);
        opacity: Tween.seg(root.t, 0, 300) * (1 - root.reset);
        Image {
            y: 8px;
            width: 13px;
            height: 13px;
            source: @image-url("../icons/copy.svg");
            colorize: Theme.tone-fg(3);
        }
        Text {
            y: 24px;
            text: "复制";
            color: Theme.tone-fg(3);
            font-size: 8px;
            font-weight: 600;
        }
    }
    Pointer {
        tip-x: root.aim < 1 ? Tween.lerp(root.from-x + 70px, root.from-x + 18px, root.aim) : Tween.lerp(root.from-x, root.to-x, root.drag) + 18px + root.away * 46px;
        tip-y: root.aim < 1 ? Tween.lerp(root.from-y + 120px, root.from-y + 24px, root.aim) : Tween.lerp(root.from-y, root.to-y, root.drag) + 24px - 5px * root.lift + root.away * 60px;
        opacity: Tween.seg(root.t, 150, 400) * (1 - Tween.seg(root.t, 2800, 3100));
    }
    // 自动保存了
    Rectangle {
        x: (root.width - self.width) / 2;
        y: root.phone-y + root.phone-h + 16px + (1 - root.saved) * 8px;
        width: saved-row.preferred-width;
        height: 30px;
        border-radius: 15px;
        background: Theme.ink;
        opacity: root.saved;
        visible: self.opacity > 0.01;
        saved-row := HorizontalLayout {
            padding-left: 12px;
            padding-right: 14px;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Image {
                    width: 13px;
                    height: 13px;
                    source: @image-url("../icons/check.svg");
                    colorize: Theme.ink-fg;
                }
            }
            Text {
                text: "已自动保存，手机上马上就变";
                color: Theme.ink-fg;
                font-size: 10.5px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
}

// 「映射」的插图：同一个键，单击、双击、长按各做一件事
component MapStage inherits Stage {
    property <float> t: Math.mod(root.since, 7500);
    // 现在演示第几种：0 单击、1 双击、2 长按，各 2.5 秒
    property <int> k: Math.min(2, Math.floor(root.t / 2500));
    property <float> u: Math.mod(root.t, 2500);
    property <length> mid: root.width / 2;
    property <length> key-s: 118px;
    property <length> key-y: (root.height - 308px) / 2 - 10px;
    property <length> tabs-y: root.key-y + root.key-s + 30px;
    property <length> card-y: root.tabs-y + 36px + 20px;
    property <float> press: root.k == 0 ? Tween.wave(Tween.seg(root.u, 500, 800))
        : root.k == 1 ? Tween.wave(Tween.seg(root.u, 450, 680)) + Tween.wave(Tween.seg(root.u, 760, 990))
        : Tween.seg(root.u, 450, 600) * (1 - Tween.seg(root.u, 1750, 1900));
    property <float> hold: root.k == 2 ? Tween.seg(root.u, 550, 1700) * (1 - Tween.seg(root.u, 1750, 1950)) : 0;
    // 动作做完了：下面的卡片边框亮一下
    property <float> done-at: root.k == 0 ? 800 : root.k == 1 ? 990 : 1700;
    property <float> flash: root.u > root.done-at ? 1 - Tween.seg(root.u, root.done-at, root.done-at + 900) : 0;
    // 大按键
    Rectangle {
        x: root.mid - root.key-s / 2;
        y: root.key-y + root.press * 3px;
        width: root.key-s;
        height: root.key-s;
        border-radius: 32px;
        background: Theme.tone-bg(3);
        border-width: 1px;
        border-color: Theme.tone-fg(3).with-alpha(0.15 + 0.25 * root.press);
        Image {
            y: 28px;
            width: 36px;
            height: 36px;
            source: @image-url("../icons/copy.svg");
            colorize: Theme.tone-fg(3);
        }
        Text {
            y: 72px;
            text: "复制";
            color: Theme.tone-fg(3);
            font-size: 14px;
            font-weight: 700;
        }
        // 长按：底下的进度条
        Rectangle {
            x: 22px;
            y: parent.height - 16px;
            width: parent.width - 44px;
            height: 5px;
            border-radius: 2.5px;
            background: Theme.tone-fg(3).with-alpha(0.18);
            opacity: root.k == 2 ? 1 : 0;
            animate opacity { duration: 250ms; }
            Rectangle {
                x: 0;
                width: parent.width * root.hold;
                height: parent.height;
                border-radius: 2.5px;
                background: Theme.tone-fg(3);
            }
        }
    }
    // 手指按在键的右下角，别挡住「复制」两个字
    Ripple {
        cx: root.mid + 36px;
        cy: root.key-y + 80px;
        p: root.k == 0 ? Tween.seg(root.u, 550, 1100) : root.k == 1 ? Tween.seg(root.u, 480, 950) : 0;
    }
    Ripple {
        cx: root.mid + 36px;
        cy: root.key-y + 80px;
        p: root.k == 1 ? Tween.seg(root.u, 790, 1260) : 0;
    }
    Finger {
        cx: root.mid + 36px;
        cy: root.key-y + 80px - 4px * (1 - Math.min(1, root.press));
        press: Math.min(1, root.press);
        opacity: Tween.seg(root.since, 200, 500);
    }
    // 单击、双击、长按
    Rectangle {
        x: root.mid - 117px;
        y: root.tabs-y;
        width: 234px;
        height: 36px;
        border-radius: 12px;
        background: Theme.win;
        border-width: 1px;
        border-color: Theme.line2;
        Rectangle {
            x: 3px + root.k * 76px;
            y: 3px;
            width: 76px;
            height: 30px;
            border-radius: 9px;
            background: Theme.ink;
            animate x { duration: 420ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        }
        for name[i] in ["单击", "双击", "长按"]: Text {
            x: 3px + i * 76px;
            width: 76px;
            height: 36px;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: name;
            color: root.k == i ? Theme.ink-fg : Theme.fg2;
            font-size: 12px;
            font-weight: 600;
            animate color { duration: 300ms; }
        }
    }
    MapCard {
        x: root.mid - 125px;
        y: root.card-y;
        on: root.k == 0;
        flash: root.k == 0 ? root.flash : 0;
        label: "按快捷键";
        HorizontalLayout {
            x: 16px;
            y: 38px;
            width: parent.width - 32px;
            height: 24px;
            spacing: 6px;
            alignment: start;
            KeyCap {
                text: "Ctrl";
            }
            Text {
                text: "+";
                color: Theme.mut;
                font-size: 12px;
                vertical-alignment: center;
            }
            KeyCap {
                text: "C";
            }
        }
        Text {
            x: 16px;
            y: 74px;
            text: "复制选中的内容";
            color: Theme.fg2;
            font-size: 11.5px;
        }
    }
    MapCard {
        x: root.mid - 125px;
        y: root.card-y;
        on: root.k == 1;
        flash: root.k == 1 ? root.flash : 0;
        label: "输入文字";
        Rectangle {
            x: 16px;
            y: 36px;
            width: parent.width - 32px;
            height: 28px;
            border-radius: 9px;
            background: Theme.soft;
            Text {
                x: 10px;
                text: "收到，我马上处理！";
                color: Theme.fg;
                font-size: 12px;
            }
        }
        Text {
            x: 16px;
            y: 74px;
            text: "一按就打出这段话";
            color: Theme.fg2;
            font-size: 11.5px;
        }
    }
    MapCard {
        x: root.mid - 125px;
        y: root.card-y;
        on: root.k == 2;
        flash: root.k == 2 ? root.flash : 0;
        label: "打开程序";
        Rectangle {
            x: 16px;
            y: 36px;
            width: 30px;
            height: 30px;
            border-radius: 9px;
            background: Theme.tone-bg(4);
            Image {
                width: 15px;
                height: 15px;
                source: @image-url("../icons/app.svg");
                colorize: Theme.tone-fg(4);
            }
        }
        Text {
            x: 56px;
            y: 36px;
            text: "计算器";
            color: Theme.fg;
            font-size: 12.5px;
            font-weight: 600;
        }
        Text {
            x: 56px;
            y: 53px;
            text: "calc.exe";
            color: Theme.mut;
            font-size: 10px;
        }
        Text {
            x: 16px;
            y: 74px;
            text: "长按一下就打开";
            color: Theme.fg2;
            font-size: 11.5px;
        }
    }
}

// 「在手机上用」的插图：手指在触控板上滑，电脑上的鼠标跟着走，轻点一下点进输入框；再按住语音键说话，字打到电脑上
component UseStage inherits Stage {
    property <float> t: Math.mod(root.since, 8600);
    // 电脑：屏幕里面的左上角 (scr-x, scr-y)
    property <length> lap-w: 240px;
    property <length> lap-h: 150px;
    property <length> lap-x: (root.width - root.lap-w - 30px) / 2;
    property <length> lap-y: root.height * 0.06;
    property <length> scr-x: root.lap-x + 21px;
    property <length> scr-y: root.lap-y + 6px;
    property <length> scr-w: root.lap-w - 12px;
    // 手机：屏幕的左上角 (app-x, app-y)
    property <length> phone-w: 128px;
    property <length> phone-h: 248px;
    property <length> phone-x: (root.width - root.phone-w) / 2;
    property <length> phone-y: root.height - root.phone-h - root.height * 0.06;
    property <length> app-x: root.phone-x + 5px;
    property <length> app-y: root.phone-y + 5px;
    property <length> app-w: root.phone-w - 10px;
    property <float> move: Tween.smooth(Tween.seg(root.t, 300, 2300));
    property <float> tap: Tween.wave(Tween.seg(root.t, 2450, 2700));
    property <float> focused: Tween.seg(root.t, 2550, 2750) * (1 - Tween.seg(root.t, 8000, 8400));
    property <float> to-mic: Tween.smooth(Tween.seg(root.t, 2900, 3500));
    property <float> listen: Tween.seg(root.t, 3500, 3700) * (1 - Tween.seg(root.t, 6400, 6600));
    property <float> typed: Tween.seg(root.t, 3900, 6300);
    property <float> lift: Tween.smooth(Tween.seg(root.t, 6500, 7000));
    property <float> clear: Tween.seg(root.t, 8000, 8400);
    // 手指在触控板上走的路（手机屏幕里）：从左上到右下，中间往上拱一点
    property <length> f-x: Tween.lerp(22px, root.app-w - 26px, root.move);
    property <length> f-y: Tween.lerp(app.pad-y + 16px, app.pad-y + app.pad-h - 16px, root.move) - Math.sin(root.move * 180deg) * 14px;
    // 电脑上的鼠标走的路（电脑屏幕里）：方向和手指一样，走得更远
    property <length> m-x: Tween.lerp(40px, 118px, root.move);
    property <length> m-y: Tween.lerp(30px, 113px, root.move) - Math.sin(root.move * 180deg) * 30px;
    MiniLaptop {
        x: root.lap-x;
        y: root.lap-y;
        screen-width: root.lap-w;
        screen-height: root.lap-h;
        // 一个聊天窗口（放进 MiniLaptop 的东西，parent 是整台电脑，不是屏幕，宽度按 scr-w 算）
        Rectangle {
            x: 0;
            y: 0;
            width: root.scr-w;
            height: 18px;
            border-radius: 4px;
            background: Theme.soft;
            for i in 3: Rectangle {
                x: 8px + i * 9px;
                y: 6px;
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.line2;
            }
        }
        Rectangle {
            x: 10px;
            y: 28px;
            width: incoming.preferred-width + 18px;
            height: 22px;
            border-radius: 11px;
            background: Theme.soft;
            incoming := Text {
                text: "会议定在什么时候？";
                color: Theme.fg2;
                font-size: 9px;
            }
        }
        // 输入框：轻点以后亮起来，说的话一个字一个字打进去
        Rectangle {
            x: 10px;
            y: 100px;
            width: root.scr-w - 20px;
            height: 26px;
            border-radius: 8px;
            background: Theme.win;
            border-width: 1px;
            border-color: Theme.line2.mix(Theme.fg, 1 - root.focused);
            Rectangle {
                x: 8px;
                y: 0;
                width: typed-text.width * Math.floor(root.typed * 12) / 12;
                height: parent.height;
                clip: true;
                typed-text := Text {
                    x: 0;
                    text: "明天上午十点，三楼会议室";
                    color: Theme.fg;
                    font-size: 10px;
                    opacity: 1 - root.clear;
                }
            }
            Rectangle {
                x: 9px + typed-text.width * Math.floor(root.typed * 12) / 12;
                width: 1.5px;
                height: 12px;
                background: Theme.fg;
                opacity: root.focused * (1 - root.clear) * (Math.mod(root.since, 1000) < 520 ? 1 : 0);
            }
        }
    }
    // 中间：蓝牙连着
    Rectangle {
        x: (root.width - 30px) / 2;
        y: (root.lap-y + root.lap-h + 10px + root.phone-y) / 2 - 15px;
        width: 30px;
        height: 30px;
        border-radius: 15px;
        background: Theme.lime;
        Image {
            width: 15px;
            height: 15px;
            source: @image-url("../icons/bluetooth.svg");
            colorize: Theme.lime-fg;
        }
    }
    MiniPhone {
        x: root.phone-x;
        y: root.phone-y;
        width: root.phone-w;
        height: root.phone-h;
        app := MiniApp {
            x: 0;
            y: 0;
            width: root.app-w;
            height: root.phone-h - 10px;
            keys: false;
            since: root.since;
            listening: root.listen;
        }
    }
    Ripple {
        cx: root.scr-x + root.m-x;
        cy: root.scr-y + root.m-y;
        p: Tween.seg(root.t, 2500, 2950);
    }
    Pointer {
        tip-x: root.scr-x + root.m-x;
        tip-y: root.scr-y + root.m-y;
        opacity: Tween.seg(root.t, 100, 300);
    }
    Ripple {
        cx: root.app-x + root.f-x;
        cy: root.app-y + root.f-y;
        p: Tween.seg(root.t, 2500, 2950);
    }
    Finger {
        cx: Tween.lerp(root.app-x + root.f-x, root.app-x + root.app-w / 2, root.to-mic) + root.lift * 50px;
        cy: Tween.lerp(root.app-y + root.f-y, root.app-y + app.mic-y + 21px, root.to-mic) + root.lift * 80px;
        press: Math.max(root.tap, root.listen);
        opacity: Tween.seg(root.t, 100, 300) * (1 - Tween.seg(root.t, 6600, 7000));
    }
}

// 「后台」的插图：点 × 关掉窗口，它缩回托盘里的小鸟，小鸟还亮着；右键小鸟能「退出」
component TrayStage inherits Stage {
    property <float> t: Math.mod(root.since, 7200);
    // 任务栏
    property <length> bar-x: 14px;
    property <length> bar-w: root.width - 28px;
    property <length> bar-y: root.height - 84px;
    // 托盘里小鸟的中心
    property <length> bird-x: root.bar-x + root.bar-w - 66px;
    property <length> bird-y: root.bar-y + 23px;
    // 窗口
    property <length> win-w: 248px;
    property <length> win-h: 172px;
    property <length> win-x: (root.width - root.win-w) / 2;
    property <length> win-y: root.height * 0.2;
    // 关闭按钮的中心
    property <length> close-x: root.win-x + root.win-w - 16px;
    property <length> close-y: root.win-y + 15px;
    // 右键菜单
    property <length> menu-w: 116px;
    property <length> menu-x: Math.min(root.bird-x - root.menu-w / 2, root.width - root.menu-w - 12px);
    property <length> menu-y: root.bird-y - 30px - 72px;
    property <float> appear: Tween.decel(Tween.seg(root.t, 0, 450));
    property <float> aim: Tween.smooth(Tween.seg(root.t, 500, 1300));
    property <float> fly: Tween.smooth(Tween.seg(root.t, 1500, 2250));
    property <float> glow: Tween.seg(root.t, 2100, 2450) * (1 - Tween.seg(root.t, 6600, 7000));
    property <float> tip: Tween.seg(root.t, 2350, 2650) * (1 - Tween.seg(root.t, 3500, 3800));
    property <float> aim2: Tween.smooth(Tween.seg(root.t, 3200, 3900));
    property <float> menu: Tween.decel(Tween.seg(root.t, 4050, 4300)) * (1 - Tween.seg(root.t, 6100, 6400));
    property <float> aim3: Tween.smooth(Tween.seg(root.t, 4500, 4900));
    property <float> hover: Tween.seg(root.t, 4800, 4950) * (1 - Tween.seg(root.t, 6100, 6400));
    // 蒜鸟的窗口：点 × 以后缩小、飞进托盘
    Rectangle {
        x: Tween.lerp(root.win-x, root.bird-x - 11px, root.fly);
        y: Tween.lerp(root.win-y, root.bird-y - 11px, root.fly);
        width: Tween.lerp(root.win-w, 22px, root.fly);
        height: Tween.lerp(root.win-h, 22px, root.fly);
        border-radius: 12px - 4px * root.fly;
        background: Theme.win;
        border-width: 1px;
        border-color: Theme.line2;
        opacity: root.appear * (1 - Tween.seg(root.fly, 0.55, 1));
        visible: self.opacity > 0.01;
        clip: true;
        Rectangle {
            x: 0;
            y: 0;
            width: root.win-w;
            height: root.win-h;
            opacity: 1 - Tween.seg(root.fly, 0, 0.35);
            Image {
                x: 10px;
                y: 8px;
                width: 14px;
                height: 14px;
                source: @image-url("../../assets/logo.svg");
            }
            Text {
                x: 29px;
                y: 8px;
                text: "蒜鸟";
                color: Theme.fg;
                font-size: 10px;
                font-weight: 700;
            }
            for icon[i] in [@image-url("../icons/win-min.svg"), @image-url("../icons/win-max.svg"), @image-url("../icons/win-close.svg")]: Image {
                x: root.win-w - 61px + i * 20px;
                y: 10px;
                width: 10px;
                height: 10px;
                source: icon;
                colorize: Theme.fg2;
            }
            // 侧边栏
            Rectangle {
                x: 8px;
                y: 30px;
                width: 54px;
                height: root.win-h - 38px;
                border-radius: 8px;
                background: Theme.soft;
                for i in 4: Rectangle {
                    x: 7px;
                    y: 9px + i * 16px;
                    width: 40px;
                    height: 9px;
                    border-radius: 4.5px;
                    background: i == 0 ? Theme.lime : Theme.line2;
                }
            }
            // 首页的两张卡片
            Rectangle {
                x: 70px;
                y: 30px;
                width: root.win-w - 78px;
                height: 56px;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.line;
                Rectangle {
                    x: 10px;
                    y: 12px;
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.green;
                }
                Text {
                    x: 21px;
                    y: 7px;
                    text: "已连接";
                    color: Theme.fg;
                    font-size: 9.5px;
                    font-weight: 700;
                }
                Rectangle {
                    x: 10px;
                    y: 28px;
                    width: parent.width - 40px;
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.line2;
                }
                Rectangle {
                    x: 10px;
                    y: 40px;
                    width: parent.width - 70px;
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.line;
                }
            }
            Rectangle {
                x: 70px;
                y: 94px;
                width: root.win-w - 78px;
                height: root.win-h - 102px;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.line;
                for i in 3: Rectangle {
                    x: 10px;
                    y: 12px + i * 15px;
                    width: parent.width - 20px - i * 24px;
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.line2;
                }
            }
        }
    }
    // 任务栏
    Rectangle {
        x: root.bar-x;
        y: root.bar-y;
        width: root.bar-w;
        height: 46px;
        border-radius: 14px;
        background: Theme.win;
        border-width: 1px;
        border-color: Theme.line2;
        // 开始按钮
        for i in 4: Rectangle {
            x: 16px + Math.mod(i, 2) * 8px;
            y: 15px + Math.floor(i / 2) * 8px;
            width: 7px;
            height: 7px;
            border-radius: 1.5px;
            background: #3b82f6;
        }
        for app[i] in [{ name: "globe", tone: 4 }, { name: "text", tone: 2 }, { name: "music", tone: 3 }]: Rectangle {
            x: 44px + i * 30px;
            y: 11px;
            width: 24px;
            height: 24px;
            border-radius: 7px;
            background: Theme.tone-bg(app.tone);
            Image {
                width: 12px;
                height: 12px;
                source: Icons.get(app.name);
                colorize: Theme.tone-fg(app.tone);
            }
        }
        Image {
            x: root.bird-x - root.bar-x - 40px;
            y: 17px;
            width: 12px;
            height: 12px;
            source: @image-url("../icons/up.svg");
            colorize: Theme.mut;
        }
        Text {
            x: root.bird-x - root.bar-x + 20px;
            y: 16px;
            text: "10:24";
            color: Theme.fg2;
            font-size: 10px;
        }
    }
    // 托盘里的小鸟：后台在跑（亮一圈）
    Rectangle {
        x: root.bird-x - 18px;
        y: root.bird-y - 18px;
        width: 36px;
        height: 36px;
        border-radius: 18px;
        background: Theme.lime;
        opacity: root.glow;
    }
    Rectangle {
        property <float> p: Math.mod(root.since, 1600) / 1600;
        width: 36px + 26px * self.p;
        height: self.width;
        x: root.bird-x - self.width / 2;
        y: root.bird-y - self.height / 2;
        border-radius: self.width / 2;
        border-width: 1.5px;
        border-color: Theme.lime-dot.with-alpha(0.6 * (1 - self.p) * root.glow);
    }
    Image {
        x: root.bird-x - 11px;
        y: root.bird-y - 11px;
        width: 22px;
        height: 22px;
        source: @image-url("../../assets/logo.svg");
    }
    // 提示：蒜鸟还在后台
    Rectangle {
        x: Math.min(root.bird-x - self.width / 2, root.width - self.width - 10px);
        y: root.bird-y - 30px - 30px + (1 - root.tip) * 6px;
        width: tip-row.preferred-width;
        height: 30px;
        border-radius: 10px;
        background: Theme.ink;
        opacity: root.tip;
        visible: self.opacity > 0.01;
        tip-row := HorizontalLayout {
            padding-left: 11px;
            padding-right: 12px;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.green;
                }
            }
            Text {
                text: "蒜鸟 · 后台运行中";
                color: Theme.ink-fg;
                font-size: 10px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
    // 右键菜单
    Rectangle {
        x: root.menu-x;
        y: root.menu-y + (1 - root.menu) * 8px;
        width: root.menu-w;
        height: 72px;
        border-radius: 10px;
        background: Theme.win;
        border-width: 1px;
        border-color: Theme.line2;
        opacity: root.menu;
        visible: self.opacity > 0.01;
        Rectangle {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: 30px;
            border-radius: 7px;
            Text {
                x: 10px;
                text: "打开蒜鸟";
                color: Theme.fg;
                font-size: 10.5px;
            }
        }
        Rectangle {
            x: 4px;
            y: 38px;
            width: parent.width - 8px;
            height: 30px;
            border-radius: 7px;
            background: Theme.line.with-alpha(root.hover);
            Text {
                x: 10px;
                text: "退出";
                color: Theme.fg;
                font-size: 10.5px;
            }
        }
    }
    Ripple {
        cx: root.close-x;
        cy: root.close-y;
        p: Tween.seg(root.t, 1350, 1800);
    }
    Ripple {
        cx: root.bird-x;
        cy: root.bird-y;
        p: Tween.seg(root.t, 3950, 4400);
    }
    Pointer {
        tip-x: Tween.lerp(Tween.lerp(Tween.lerp(root.win-x + root.win-w * 0.6, root.close-x, root.aim), root.bird-x + 2px, root.aim2), root.menu-x + 40px, root.aim3);
        tip-y: Tween.lerp(Tween.lerp(Tween.lerp(root.win-y + root.win-h + 60px, root.close-y, root.aim), root.bird-y + 2px, root.aim2), root.menu-y + 53px, root.aim3);
        opacity: Tween.seg(root.t, 300, 550) * (1 - Tween.seg(root.t, 6200, 6600));
    }
}

// 教程正文：14px，能折行
component TutText inherits WrapText {
    font-size: 14px;
}

// 教程里带序号的一步
component TutStep inherits HorizontalLayout {
    in property <string> number;
    in property <string> text;
    spacing: 10px;
    VerticalLayout {
        alignment: start;
        Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: Theme.ink;
            Text {
                text: root.number;
                color: Theme.ink-fg;
                font-size: 12px;
                font-weight: 700;
            }
        }
    }
    TutText {
        text: root.text;
        horizontal-stretch: 1;
    }
}

// 教程里的一行：彩色图标块 + 标题 + 一句说明
component TutFeature inherits HorizontalLayout {
    in property <image> icon;
    in property <int> tone;
    in property <string> title;
    in property <string> note;
    spacing: 12px;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 36px;
            height: 36px;
            border-radius: 11px;
            background: Theme.tone-bg(root.tone);
            Image {
                width: 18px;
                height: 18px;
                source: root.icon;
                colorize: Theme.tone-fg(root.tone);
            }
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        horizontal-stretch: 1;
        min-width: 0px;
        Text {
            text: root.title;
            color: Theme.fg;
            font-size: 14px;
            font-weight: 600;
        }
        if root.note != "": Muted {
            text: root.note;
            font-size: 12.5px;
        }
    }
}

// 教程里的一块浅底：实时状态、开关
// 页底一行：灰字引子 + 粗体可点的链接（「扫不了码？改用系统蓝牙配对 ›」）
component TutLink inherits HorizontalLayout {
    in property <string> lead;
    in property <string> link;
    callback clicked();
    alignment: start;
    spacing: 2px;
    Text {
        text: root.lead;
        color: Theme.mut;
        font-size: 13px;
        vertical-alignment: center;
    }
    Rectangle {
        width: link-text.preferred-width + 4px;
        height: 24px;
        border-radius: 6px;
        background: link-area.has-hover ? Theme.hover : transparent;
        link-text := Text {
            text: root.link;
            color: Theme.fg;
            font-size: 13px;
            font-weight: 700;
            vertical-alignment: center;
        }
        link-area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }
}

component TutBox inherits Rectangle {
    background: Theme.soft;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.line;
    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 5px;
        padding-bottom: 5px;
        @children
    }
}

// 教程「选一种连接方式」的一张卡片：点了就选中（黑框、右上角打勾），不翻页
component TutChoice inherits Rectangle {
    in property <image> icon;
    in property <string> name;
    in property <string> tag;
    in property <string> line1;
    in property <string> line2;
    in property <bool> selected;
    callback clicked();
    height: 115px;
    border-radius: 12px;
    background: root.selected ? Theme.win : area.has-hover ? Theme.hover : Theme.soft;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.ink : Theme.line;
    animate background, border-color { duration: 180ms; }
    Rectangle {
        x: 12px;
        y: 12px;
        width: 31px;
        height: 31px;
        border-radius: 15.5px;
        background: root.selected ? Theme.ink : Theme.win;
        border-width: root.selected ? 0px : 1px;
        border-color: Theme.line2;
        animate background { duration: 180ms; }
        Image {
            width: 16px;
            height: 16px;
            source: root.icon;
            colorize: root.selected ? Theme.ink-fg : Theme.fg;
        }
    }
    HorizontalLayout {
        x: 52px;
        y: 12px;
        height: 31px;
        spacing: 7px;
        alignment: start;
        Text {
            text: root.name;
            color: Theme.fg;
            font-size: 15px;
            font-weight: 700;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Chip {
                text: root.tag;
                tone: 1;
                height: 19px;
            }
        }
    }
    // 右上角：没选是空圈，选中是浅绿圈打勾
    Rectangle {
        x: parent.width - 28px;
        y: 15px;
        width: 17px;
        height: 17px;
        border-radius: 8.5px;
        background: root.selected ? Theme.lime : Theme.win;
        border-width: root.selected ? 0px : 1.5px;
        border-color: Theme.line2;
        if root.selected: Image {
            width: 11px;
            height: 11px;
            source: @image-url("../icons/check.svg");
            colorize: Theme.lime-fg;
        }
    }
    Text {
        x: 13px;
        y: 57px;
        width: parent.width - 26px;
        text: root.line1;
        color: Theme.fg2;
        font-size: 12.5px;
        overflow: elide;
    }
    Text {
        x: 13px;
        y: 79px;
        width: parent.width - 26px;
        text: root.line2;
        color: Theme.mut;
        font-size: 12.5px;
        overflow: elide;
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// 教程右边的一页：翻到时从翻页的方向滑进来、淡入，翻走时往另一边滑走、淡出
component TutorialPage inherits Rectangle {
    in property <int> index;
    in property <int> current;
    in property <string> eyebrow;
    in property <string> title;
    property <bool> on: root.index == root.current;
    opacity: root.on ? 1 : 0;
    visible: self.opacity > 0.01;
    animate opacity {
        duration: root.on ? 360ms : 140ms;
        delay: root.on ? 110ms : 0ms;
        easing: ease-out;
    }
    Rectangle {
        x: root.on ? 0px : root.index > root.current ? 30px : -30px;
        width: root.width;
        height: root.height;
        animate x { duration: 560ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        VerticalLayout {
            alignment: start;
            spacing: 12px;
            if root.eyebrow != "": HorizontalLayout {
                alignment: start;
                Chip {
                    text: root.eyebrow;
                    tone: 1;
                }
            }
            Text {
                text: root.title;
                color: Theme.fg;
                font-size: 24px;
                font-weight: 700;
                wrap: word-wrap;
                min-width: 0px;
                height: self.preferred-height;
            }
            Rectangle {
                height: 2px;
            }
            @children
        }
    }
}

// 使用教程：盖住整个窗口。左边插图，右边说明，底下是页码圆点和上一步、下一步。
// first-run：第一次打开时自动出来的，右上角是「跳过」，最后一页的按钮是「开始使用」。
// ← → 翻页，回车下一步，Esc 关；点遮罩不关（第一次用的人容易点错）
component TutorialDialog inherits Rectangle {
    in property <bool> first-run;
    in property <int> start-page;
    in property <bool> core-running;
    in property <bool> connected;
    in property <string> device;
    in property <string> computer-name;
    in property <int> check-bluetooth: -1;
    in property <int> check-paired: -1;
    in property <string> bluetooth-note;
    in property <string> paired-note;
    // 扫码绑定过的手机、现在是不是走局域网连着、是不是用蓝牙连着
    in property <[LanPhoneRow]> lan-phones;
    in property <bool> lan-online;
    in property <bool> bt-online;
    in-out property <bool> autostart;
    callback start-core();
    callback open-bluetooth-settings();
    callback recheck();
    callback autostart-changed(bool);
    // 「显示二维码」：打开扫码绑定手机的窗口（盖在教程上面）
    callback lan-pair();
    // 关掉了（淡出以后）；报告最远看到第几页（页的编号见下面，托盘页是 10）
    callback closed(int);
    // 页的编号（固定，不管走哪条路）：0 欢迎 · 1 手机上也装好蒜鸟 · 2 选一种连接方式 ·
    // 3 让手机扫码配对（走蓝牙时）· 4 蓝牙配对 · 5 在手机上选这台电脑（这两页是蓝牙的备选：扫不了码时）·
    // 6 让手机扫一下二维码（只在走局域网时出现）· 7 布局 · 8 映射 · 9 手机上怎么用 · 10 托盘、开机自启 · 11 准备好了
    // way：第 2 页选的连接方式，0 还没选 1 蓝牙 2 局域网。只走选中的那条路：跳过的页不显示，
    // 圆点只按要走的页数算（还没选时按蓝牙那条算）；上一步、点圆点、← → 都按这条路走。
    // manual：蓝牙走备选（系统蓝牙里配对 + 手机上选电脑，4、5 两页），不走扫码配对（3）
    property <int> way;
    property <bool> manual;
    property <int> count: 12;
    property <int> steps: root.way != 2 && root.manual ? 10 : 9;
    property <int> current: root.start-page;
    property <int> furthest: root.start-page;
    property <bool> shown;
    property <bool> closing;
    // 点了「重新检查」：按钮显示「检查中…」一会儿
    property <bool> checking;
    property <bool> open: root.shown && !root.closing;
    property <length> art-w: 340px;
    property <length> text-x: root.art-w + 48px;
    // 页 → 这条路上的第几步（圆点）
    pure function step-of(page: int) -> int {
        return root.way == 2 ? (page <= 2 ? page : page - 3)
            : root.manual ? (page <= 2 ? page : page <= 5 ? page - 1 : page - 2)
            : (page <= 3 ? page : page - 3);
    }
    // 这条路上的第几步 → 页
    pure function page-of(step: int) -> int {
        return root.way == 2 ? (step <= 2 ? step : step + 3)
            : root.manual ? (step <= 2 ? step : step <= 4 ? step + 1 : step + 2)
            : (step <= 3 ? step : step + 3);
    }
    // 扫码配对 ↔ 系统蓝牙配对：换路，停在新路的配对页
    function use-manual(on: bool) {
        root.manual = on;
        root.go(on ? 4 : 3);
    }
    function go(page: int) {
        if (page >= 0 && page < root.count) {
            root.current = page;
            root.furthest = Math.max(root.furthest, page);
        }
    }
    function go-step(step: int) {
        if (step >= 0 && step < root.steps) {
            root.go(root.page-of(step));
        }
    }
    function next() {
        // 选连接方式那页：没选就不往下翻
        if (root.current == 2 && root.way == 0) {
            return;
        }
        if (root.step-of(root.current) < root.steps - 1) {
            root.go-step(root.step-of(root.current) + 1);
        } else {
            root.closing = true;
        }
    }
    background: (Theme.dark ? #000000b0 : #14141460).with-alpha(root.open ? (Theme.dark ? 0.69 : 0.38) : 0);
    animate background { duration: 220ms; easing: ease-out; }
    init => {
        // 从首页重新打开：局域网连着、或者扫码绑定过手机，就先选好局域网
        if (!root.first-run && (root.lan-online || root.lan-phones.length > 0)) {
            root.way = 2;
        }
        // 直接打开到只有一条路才有的页（--tutorial N）：选上那条路
        if (root.start-page >= 3 && root.start-page <= 5) {
            root.way = 1;
            root.manual = root.start-page != 3;
        }
        if (root.start-page == 6) {
            root.way = 2;
        }
        root.shown = true;
        keys.focus();
    }
    // 淡出完了再真关
    Timer {
        interval: 220ms;
        running: root.closing;
        triggered => {
            root.closed(root.furthest);
        }
    }
    Timer {
        interval: 1200ms;
        running: root.checking;
        triggered => {
            root.checking = false;
        }
    }
    keys := FocusScope {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.closing = true;
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.go-step(root.step-of(root.current) - 1);
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.Return) {
                root.next();
                return accept;
            }
            return reject;
        }
        TouchArea { }
        card := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + (root.open ? 0px : 14px);
            width: Math.min(880px, parent.width - 60px);
            height: Math.min(600px, parent.height - 60px);
            opacity: root.open ? 1 : 0;
            animate opacity { duration: 220ms; easing: ease-out; }
            animate y { duration: 380ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
            background: Theme.win;
            border-radius: 18px;
            border-width: 1px;
            border-color: Theme.line2;
            TouchArea { }
            // 左边的插图
            Rectangle {
                x: 12px;
                y: 12px;
                width: root.art-w;
                height: parent.height - 24px;
                border-radius: 13px;
                background: @linear-gradient(170deg, Theme.soft 35%, Theme.lime.with-alpha(Theme.dark ? 0.08 : 0.32) 100%);
                clip: true;
                HelloStage {
                    active: root.current == 0;
                }
                AppStage {
                    active: root.current == 1;
                }
                ChooseStage {
                    active: root.current == 2;
                    way: root.way;
                }
                ScanPairStage {
                    active: root.current == 3;
                }
                PairStage {
                    active: root.current == 4;
                }
                PickStage {
                    active: root.current == 5;
                    computer: root.computer-name;
                }
                LanStage {
                    active: root.current == 6;
                }
                LayoutStage {
                    active: root.current == 7;
                }
                MapStage {
                    active: root.current == 8;
                }
                UseStage {
                    active: root.current == 9;
                }
                TrayStage {
                    active: root.current == 10;
                }
                HelloStage {
                    active: root.current == 11;
                    finale: true;
                }
            }
            // 右上角：第一次是「跳过」，以后是关闭
            HorizontalLayout {
                x: root.text-x;
                y: 14px;
                width: parent.width - root.text-x - 14px;
                height: 30px;
                alignment: end;
                if root.first-run: GhostButton {
                    small: true;
                    text: "跳过";
                    clicked => {
                        root.closing = true;
                    }
                }
                if !root.first-run: IconButton {
                    icon: @image-url("../icons/x.svg");
                    clicked => {
                        root.closing = true;
                    }
                }
            }
            // 说明
            Rectangle {
                x: root.text-x;
                y: 58px;
                width: parent.width - root.text-x - 40px;
                height: parent.height - 58px - 84px;
                TutorialPage {
                    index: 0;
                    current: root.current;
                    title: "欢迎使用蒜鸟";
                    TutText {
                        text: "蒜鸟能把手机变成这台电脑的触控板、快捷键和语音输入。手机和电脑用蓝牙或同一个网络连在一起，不用数据线。";
                    }
                    Rectangle {
                        height: 2px;
                    }
                    TutFeature {
                        icon: @image-url("../icons/pad.svg");
                        tone: 1;
                        title: "触控板";
                        note: "手指一滑，鼠标就跟着动";
                    }
                    TutFeature {
                        icon: @image-url("../icons/kbd.svg");
                        tone: 3;
                        title: "快捷键";
                        note: "复制、粘贴、撤销……一个键一按就行";
                    }
                    TutFeature {
                        icon: @image-url("../icons/mic.svg");
                        tone: 2;
                        title: "语音输入";
                        note: "按住说话，字直接打到电脑上";
                    }
                    Rectangle {
                        height: 2px;
                    }
                    Muted {
                        text: "跟着往下走，一两分钟就能连好、学会。";
                        font-size: 13px;
                    }
                }
                TutorialPage {
                    index: 1;
                    current: root.current;
                    eyebrow: "连接手机 · 第 1 步";
                    title: "手机上也装好蒜鸟";
                    TutText {
                        text: "蒜鸟分两半：电脑上的这个程序，和手机上的蒜鸟 App。两边都装好、都打开，才能连在一起。";
                    }
                    TutFeature {
                        icon: @image-url("../icons/phone.svg");
                        tone: 1;
                        title: "手机：装好并打开蒜鸟 App";
                        note: "安卓手机，第一次打开会带你连电脑";
                    }
                    TutFeature {
                        icon: @image-url("../icons/app.svg");
                        tone: 0;
                        title: "电脑：后台在托盘里运行";
                        note: "任务栏右下角的小鸟就是它，平时不用管";
                    }
                    Rectangle {
                        height: 4px;
                    }
                    TutBox {
                        HorizontalLayout {
                            spacing: 12px;
                            CheckRow {
                                horizontal-stretch: 1;
                                state: root.core-running ? 1 : 0;
                                title: root.core-running ? "电脑这边准备好了" : "电脑上的后台没在运行";
                                note: root.core-running ? "后台正在运行，等手机来连" : "后台不运行，手机就连不上来";
                            }
                            if !root.core-running: VerticalLayout {
                                alignment: center;
                                PrimaryButton {
                                    text: "启动后台";
                                    clicked => {
                                        root.start-core();
                                    }
                                }
                            }
                        }
                    }
                }
                TutorialPage {
                    index: 2;
                    current: root.current;
                    eyebrow: "连接手机 · 第 2 步";
                    title: "选一种连接方式";
                    TutText {
                        text: "两种都能用。先选一种连上，另一种以后也能加。";
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        TutChoice {
                            horizontal-stretch: 1;
                            icon: @image-url("../icons/bluetooth.svg");
                            name: "蓝牙";
                            tag: "稳定";
                            line1: "不用网络，在哪都能连";
                            line2: "传文件慢些，大照片会压缩";
                            selected: root.way == 1;
                            clicked => {
                                root.way = 1;
                            }
                        }
                        TutChoice {
                            horizontal-stretch: 1;
                            icon: @image-url("../icons/wifi.svg");
                            name: "局域网";
                            tag: "更快";
                            line1: "和手机连着同一个 Wi-Fi 时用";
                            line2: "延迟更低，传文件快得多";
                            selected: root.way == 2;
                            clicked => {
                                root.way = 2;
                            }
                        }
                    }
                    if root.way != 0: Text {
                        text: root.way == 1 ? "接下来：显示二维码，让手机扫一下配上蓝牙" : "接下来：显示二维码，让手机扫一下";
                        color: Theme.fg;
                        font-size: 13.5px;
                        font-weight: 700;
                    }
                    Muted {
                        text: "拿不准就选蓝牙。手机上的教程也选同一种。";
                        font-size: 13px;
                    }
                }
                TutorialPage {
                    index: 3;
                    current: root.current;
                    eyebrow: "连接手机 · 第 3 步";
                    title: "让手机扫码配对";
                    TutText {
                        text: "不用去蓝牙设置里搜设备、核对数字，扫一次就行。";
                    }
                    TutStep {
                        number: "1";
                        text: "电脑：点下面的「显示二维码」。";
                    }
                    TutStep {
                        number: "2";
                        text: "手机：打开蒜鸟，点「···」→「选择电脑」→「扫码配对新电脑」，对准二维码。";
                    }
                    TutStep {
                        number: "3";
                        text: "手机上弹出「配对」，点一下。电脑这边自动同意，不用点。";
                    }
                    TutBox {
                        CheckRow {
                            state: root.check-bluetooth;
                            title: root.check-bluetooth == 1 ? "电脑蓝牙已打开" : root.check-bluetooth == 0 ? "电脑蓝牙没开" : "正在检查电脑蓝牙…";
                            note: root.bluetooth-note;
                        }
                        CheckRow {
                            state: root.bt-online || root.check-paired == 1 ? 1 : root.check-paired;
                            title: root.bt-online ? "已经连上了" : root.check-paired == 1 ? "已经和手机配对" : root.check-paired == 0 ? "还没和手机配对" : "正在检查配对…";
                            note: root.bt-online ? (root.device != "" ? root.device + " · 用蓝牙连着" : "用蓝牙连着") : root.check-paired == 1 ? "手机上打开蒜" + "鸟就会连上" : root.check-paired == 0 ? "手机扫码配好，这里就会打勾" : "";
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        GhostButton {
                            text: "显示二维码";
                            has-icon: true;
                            icon: @image-url("../icons/qr.svg");
                            clicked => {
                                root.lan-pair();
                            }
                        }
                        GhostButton {
                            text: root.checking ? "检查中…" : "重新检查";
                            enabled: !root.checking;
                            clicked => {
                                root.checking = true;
                                root.recheck();
                            }
                        }
                    }
                    TutLink {
                        lead: "扫不了码？";
                        link: "改用系统蓝牙配对 ›";
                        clicked => {
                            root.use-manual(true);
                        }
                    }
                }
                TutorialPage {
                    index: 4;
                    current: root.current;
                    eyebrow: "连接手机 · 第 3 步";
                    title: "把手机和电脑蓝牙配对";
                    TutText {
                        text: "配对只要做一次，以后就不用再配了。";
                    }
                    TutStep {
                        number: "1";
                        text: "手机：打开蓝牙设置，停在那一页别退出，电脑才找得到它。";
                    }
                    TutStep {
                        number: "2";
                        text: "电脑：点下面的「打开蓝牙设置」→「添加设备」→「蓝牙」，在列表里点你的手机。";
                    }
                    TutStep {
                        number: "3";
                        text: "两边会弹出同一串数字。核对一样后，两边都点「配对」或「连接」。";
                    }
                    TutBox {
                        CheckRow {
                            state: root.check-bluetooth;
                            title: root.check-bluetooth == 1 ? "电脑蓝牙已打开" : root.check-bluetooth == 0 ? "电脑蓝牙没开" : "正在检查电脑蓝牙…";
                            note: root.bluetooth-note;
                        }
                        CheckRow {
                            state: root.check-paired;
                            title: root.check-paired == 1 ? "已经和手机配对" : root.check-paired == 0 ? "还没和手机配对" : "正在检查配对…";
                            note: root.paired-note;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        GhostButton {
                            text: "打开蓝牙设置";
                            has-icon: true;
                            icon: @image-url("../icons/bluetooth.svg");
                            clicked => {
                                root.open-bluetooth-settings();
                            }
                        }
                        GhostButton {
                            text: root.checking ? "检查中…" : "重新检查";
                            enabled: !root.checking;
                            clicked => {
                                root.checking = true;
                                root.recheck();
                            }
                        }
                    }
                    TutLink {
                        lead: "想省事：";
                        link: "改回扫码配对 ›";
                        clicked => {
                            root.use-manual(false);
                        }
                    }
                }
                TutorialPage {
                    index: 5;
                    current: root.current;
                    eyebrow: "连接手机 · 第 4 步";
                    title: "在手机上选这台电脑";
                    TutText {
                        text: "打开手机上的蒜鸟，在「选择电脑」里点这台电脑：";
                    }
                    TutBox {
                        HorizontalLayout {
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    border-radius: 12px;
                                    background: Theme.lime;
                                    Image {
                                        width: 20px;
                                        height: 20px;
                                        source: @image-url("../icons/bluetooth.svg");
                                        colorize: Theme.lime-fg;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                Text {
                                    text: root.computer-name;
                                    color: Theme.fg;
                                    font-size: 17px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                Text {
                                    text: "这台电脑在蓝牙里的名字";
                                    color: Theme.mut;
                                    font-size: 12px;
                                }
                            }
                        }
                    }
                    TutText {
                        text: "选好以后，只要两边的蒜鸟都开着，下次会自动连上，不用再选。";
                    }
                    TutBox {
                        CheckRow {
                            state: root.connected ? 1 : -1;
                            title: root.connected ? "已经连上了" : "等手机来连…";
                            note: root.connected ? (root.device != "" ? "手机：" + root.device : "") : "手机上选好这台电脑，这里就会打勾";
                        }
                    }
                }
                TutorialPage {
                    index: 6;
                    current: root.current;
                    eyebrow: "连接手机 · 第 3 步";
                    title: "让手机扫一下二维码";
                    TutText {
                        text: "扫一次就行，以后手机和电脑在同一个网络里，打开蒜鸟就会自动连上。";
                    }
                    TutStep {
                        number: "1";
                        text: "电脑：点下面的「显示二维码」。";
                    }
                    TutStep {
                        number: "2";
                        text: "手机：打开蒜鸟，点右上角「···」→「扫码连接电脑」，对准二维码。";
                    }
                    TutBox {
                        CheckRow {
                            state: root.lan-phones.length > 0 ? 1 : -1;
                            title: root.lan-phones.length > 0 ? "已有 " + root.lan-phones.length + " 部手机扫码绑定" : "还没有手机扫码绑定";
                            note: root.lan-phones.length == 0 ? "手机扫到二维码，这里就会打勾" : root.lan-online ? (root.device != "" ? root.device : root.lan-phones[0].name) + " · 正在用局域网连接" : root.lan-phones[0].name + " · 在同一个网络里会自动连上";
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        GhostButton {
                            text: "显示二维码";
                            has-icon: true;
                            icon: @image-url("../icons/qr.svg");
                            clicked => {
                                root.lan-pair();
                            }
                        }
                    }
                    Muted {
                        text: "连不上？看看两边是不是同一个网络，或者回上一步选蓝牙。";
                        font-size: 13px;
                    }
                }
                TutorialPage {
                    index: 7;
                    current: root.current;
                    eyebrow: "在电脑上调 · 布局";
                    title: "手机上摆什么，在「布局」里定";
                    TutText {
                        text: "手机屏幕分成一个个小格子，上面可以摆触控板、按键、语音按钮和语音输入框。";
                    }
                    TutFeature {
                        icon: @image-url("../icons/move.svg");
                        tone: 1;
                        title: "拖动换位置";
                        note: "拖到别的模块上，两个就互换";
                    }
                    TutFeature {
                        icon: @image-url("../icons/grid.svg");
                        tone: 3;
                        title: "拖边和角改大小";
                        note: "按住 Alt 拖，可以不对齐格子";
                    }
                    TutFeature {
                        icon: @image-url("../icons/plus.svg");
                        tone: 2;
                        title: "添加按键";
                        note: "点顶上的「添加按键」，随时加新键";
                    }
                    Muted {
                        text: "改完自动保存，手机上马上就变。在手机上点右上角「···」→「调整布局」也能调。";
                        font-size: 13px;
                    }
                }
                TutorialPage {
                    index: 8;
                    current: root.current;
                    eyebrow: "在电脑上调 · 映射";
                    title: "每个键做什么，在「映射」里定";
                    TutText {
                        text: "在「映射」里选一个键，它的单击、双击、长按可以各做一件事，比如：";
                    }
                    TutFeature {
                        icon: @image-url("../icons/kbd.svg");
                        tone: 3;
                        title: "按快捷键";
                        note: "Ctrl + C 复制、Ctrl + V 粘贴、Alt + Tab 切窗口";
                    }
                    TutFeature {
                        icon: @image-url("../icons/text.svg");
                        tone: 4;
                        title: "输入一段文字";
                        note: "常用的回复、地址，一按就打出来";
                    }
                    TutFeature {
                        icon: @image-url("../icons/globe.svg");
                        tone: 2;
                        title: "打开网页、程序";
                        note: "还能把好几步串起来，按顺序一次做完";
                    }
                    Muted {
                        text: "删除、方向键这类键，「按住时」选「连发」，按住就一直删。不知道怎么配？点映射页的「预设」，一键套用。";
                        font-size: 13px;
                    }
                }
                TutorialPage {
                    index: 9;
                    current: root.current;
                    eyebrow: "在手机上用";
                    title: "手机上怎么用";
                    TutFeature {
                        icon: @image-url("../icons/move.svg");
                        tone: 1;
                        title: "单指滑动";
                        note: "移动鼠标";
                    }
                    TutFeature {
                        icon: @image-url("../icons/mouse.svg");
                        tone: 0;
                        title: "单指轻点 · 双指轻点";
                        note: "鼠标左键 · 右键";
                    }
                    TutFeature {
                        icon: @image-url("../icons/wheel.svg");
                        tone: 3;
                        title: "双指滑动";
                        note: "滚动页面，松手还会顺着滑一段";
                    }
                    TutFeature {
                        icon: @image-url("../icons/pad.svg");
                        tone: 4;
                        title: "轻点一下，马上按住拖";
                        note: "拖动窗口、选中文字";
                    }
                    TutFeature {
                        icon: @image-url("../icons/mic.svg");
                        tone: 2;
                        title: "按住语音键说话";
                        note: "说的话变成字，打在电脑光标处";
                    }
                }
                TutorialPage {
                    index: 10;
                    current: root.current;
                    eyebrow: "小提示";
                    title: "关掉这个窗口，蒜鸟照样工作";
                    TutText {
                        text: "真正干活的是任务栏右下角托盘里的小鸟（后台）。这个窗口只是用来改设置的，关掉它，手机照样能用。";
                    }
                    TutText {
                        text: "想彻底退出：在托盘的小鸟上点右键，选「退出」。";
                    }
                    Rectangle {
                        height: 2px;
                    }
                    TutBox {
                        HorizontalLayout {
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 36px;
                                    height: 36px;
                                    border-radius: 11px;
                                    background: Theme.tone-bg(4);
                                    Image {
                                        width: 18px;
                                        height: 18px;
                                        source: @image-url("../icons/power.svg");
                                        colorize: Theme.tone-fg(4);
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                Text {
                                    text: "开机时自动启动后台";
                                    color: Theme.fg;
                                    font-size: 14px;
                                    font-weight: 600;
                                }
                                Muted {
                                    text: "建议打开：电脑一开机，手机就能直接连";
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    checked <=> root.autostart;
                                    toggled => {
                                        root.autostart-changed(root.autostart);
                                    }
                                }
                            }
                        }
                    }
                }
                TutorialPage {
                    index: 11;
                    current: root.current;
                    title: "准备好了！";
                    TutText {
                        text: "打开手机上的蒜鸟，就可以开始用了。电脑上这几个地方最常用：";
                    }
                    TutFeature {
                        icon: @image-url("../icons/home.svg");
                        tone: 0;
                        title: "首页";
                        note: "连上没有、今天按了几次，一眼就能看到";
                    }
                    TutFeature {
                        icon: @image-url("../icons/grid.svg");
                        tone: 0;
                        title: "布局";
                        note: "手机上摆什么";
                    }
                    TutFeature {
                        icon: @image-url("../icons/kbd.svg");
                        tone: 0;
                        title: "映射";
                        note: "每个键做什么";
                    }
                    TutBox {
                        CheckRow {
                            state: root.connected ? 1 : -1;
                            title: root.connected ? "手机已经连上了" : "手机还没连上";
                            note: root.connected ? "可以直接用了" : root.way == 2 ? "看看两边是不是同一个网络、手机扫过码没有" : "没关系，首页的「连接手机」会一项项帮你检查";
                        }
                    }
                    if root.way != 2: Muted {
                        text: "想更快：设置 → 扫码连接，扫一次码。";
                        font-size: 13px;
                    }
                    if root.way == 2: Muted {
                        text: "没有网也想用：再显示一次二维码，手机选「扫码配对新电脑」。";
                        font-size: 13px;
                    }
                    Muted {
                        text: "想再看一遍这个教程：点首页右上角的「使用教程」。";
                        font-size: 13px;
                    }
                }
            }
            // 底下：页码圆点（点了直接翻过去）、上一步、下一步
            HorizontalLayout {
                x: root.text-x;
                y: parent.height - 62px;
                width: parent.width - root.text-x - 28px;
                height: 36px;
                spacing: 8px;
                HorizontalLayout {
                    alignment: start;
                    // 只画要走的那条路上的页
                    for i in root.steps: dot := Rectangle {
                        property <int> page: root.page-of(i);
                        width: (self.page == root.current ? 22px : 7px) + 8px;
                        animate width { duration: 420ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                        Rectangle {
                            x: 4px;
                            width: parent.width - 8px;
                            height: 7px;
                            border-radius: 3.5px;
                            background: dot.page == root.current ? Theme.fg : dot.page <= root.furthest ? Theme.mut : Theme.line2;
                            animate background { duration: 300ms; }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.go(dot.page);
                            }
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                if root.current > 0: GhostButton {
                    text: "上一步";
                    clicked => {
                        root.go-step(root.step-of(root.current) - 1);
                    }
                }
                PrimaryButton {
                    text: root.current == 0 ? "开始" : root.current < root.count - 1 ? "下一步" : root.first-run ? "开始使用" : "完成";
                    has-icon: root.current < root.count - 1;
                    // 选连接方式那页：没选时是灰的
                    enabled: root.current != 2 || root.way != 0;
                    icon-after: true;
                    icon: @image-url("../icons/chev-right.svg");
                    clicked => {
                        root.next();
                    }
                }
            }
        }
    }
}

// ───────────────────────── 主窗口 ─────────────────────────

export component AppWindow inherits Window {
    title: "蒜鸟";
    icon: @image-url("../../assets/icon.png");
    preferred-width: 1220px;
    preferred-height: 820px;
    min-width: 1040px;
    min-height: 740px;
    default-font-family: "Microsoft YaHei UI";
    background: Theme.win;
    forward-focus: keys;

    in-out property <int> nav: 0;
    in property <string> toast;
    // 提示条右边的按钮（「撤销」「打开所在文件夹」），空的就没有
    in property <string> toast-action;
    callback toast-clicked();
    in property <string> version;
    in property <string> folder;
    // `SuanNIAO.exe --dark`：强制深色（std-widgets 的关于徽章也跟着深色）
    in property <bool> force-dark;
    changed force-dark => {
        Theme.force-dark = self.force-dark;
        if (self.force-dark) {
            Palette.color-scheme = ColorScheme.dark;
        }
    }
    // 换页时回到顶上（所有页面共用一个滚动区）
    changed nav => {
        scroll.content-y = 0;
    }
    // Windows 要窗口重画时程序把它翻一下（win::hook_main_window）：最底下盖满窗口的那层算变了，整个窗口重画
    in property <bool> repaint-all;

    // 顶栏当标题栏（win::hook_main_window）：系统的标题栏去掉了，窗口按钮画在顶栏右边。程序没接管成功时是 false，系统的标题栏还在
    in property <bool> custom-frame;
    in property <bool> window-maximized;
    in property <bool> window-active: true;
    // 鼠标在最大化按钮上、按着最大化按钮：这个按钮上的鼠标消息不经过界面（Windows 11 悬停时要弹贴靠布局），由程序告诉
    in property <bool> max-hover;
    in property <bool> max-pressed;
    callback minimize-window();
    callback toggle-maximize();
    callback close-window();
    // 三个窗口按钮一共多宽：每格 34px，关闭按钮那格一直伸到窗口右边（多 23px，和顶栏右边的留白一样）
    property <length> window-buttons-width: 34px * 3 + 23px;

    // 首页
    in property <string> greeting: "你好";
    in property <string> date-text;
    in property <bool> core-running;
    in property <bool> connected;
    in property <string> device;
    in property <string> since-text;
    in property <float> memory-mb;
    in property <int> today-presses;
    in property <int> today-voice;
    in property <[OverviewRow]> home-rows;
    in property <int> max-today;
    in property <[RecentItem]> recent;
    in property <[ModuleItem]> home-modules;
    in property <string> home-page-name;
    // 同步：0 未连接 1 已同步 2 等手机确认 3 手机没有确认
    in property <int> sync-state;
    in property <string> sync-text;
    in property <int> check-bluetooth: -1;
    in property <int> check-paired: -1;
    in property <string> bluetooth-note;
    in property <string> paired-note;
    in property <bool> ask-autostart;
    in property <string> phone-model;
    in property <string> phone-app;
    callback start-core();
    callback open-folder();
    callback autostart-answer(bool);
    callback recheck();
    // 使用教程：first-run 是第一次打开时自动出来的（「跳过」「开始使用」），tutorial-start 从第几页开始
    in-out property <bool> tutorial-open;
    in-out property <bool> tutorial-first-run;
    in-out property <int> tutorial-start;
    // 这台电脑在蓝牙里的名字（手机的「选择电脑」里列的就是它）
    in property <string> computer-name: "这台电脑";
    callback open-bluetooth-settings();
    // 教程里点「重新检查」：马上查一遍蓝牙和配对
    callback tutorial-recheck();
    // 教程关掉了；报告最远看到第几页
    callback tutorial-closed(int);
    // 配置文件读不出来：顶上的横幅
    in property <bool> config-broken;
    // 横幅的两行：读不出来的原因；坏文件另存成了什么、现在用的是什么
    in property <string> config-broken-text;
    in property <string> config-broken-note;
    in property <bool> has-backup;
    callback broken-restore();
    callback broken-default();

    // 布局
    in property <[string]> page-names;
    in property <int> page-index;
    in property <int> columns;
    in property <int> rows;
    in property <[ModuleItem]> modules;
    in property <int> selected-module: -1;
    in property <int> sel-kind;
    in-out property <string> sel-label;
    in property <float> sel-x;
    in property <float> sel-y;
    in property <float> sel-w;
    in property <float> sel-h;
    in property <int> sel-hold;
    in property <bool> sel-passthrough-ok;
    in-out property <string> page-name;
    callback select-page(int);
    callback add-page();
    callback rename-page(string);
    callback delete-page();
    callback select-module(int);
    callback drag-preview(int, int, float, float, bool) -> Ghost;
    callback place-module(int, float, float, float, float);
    callback drag-failed();
    callback add-module(int);
    callback delete-module();
    callback kind-changed(int);
    callback label-changed(string);
    callback rect-changed(float, float, float, float);
    callback nudge(int, int);
    callback sel-hold-changed(int);
    callback hold-blocked();
    callback edit-mapping();
    // 改网格
    in property <bool> grid-open;
    pure callback grid-problem(int, int) -> string;
    callback grid-open-request();
    callback grid-apply(int, int);
    callback grid-close();

    // 映射
    in property <[MapRow]> map-list;
    in property <int> map-button-count;
    in property <int> map-button-index;
    in property <int> map-trigger-index;
    in property <string> map-title;
    in property <string> map-page;
    in property <[ActionItem]> map-actions;
    in property <int> map-hold;
    in property <bool> map-passthrough-ok;
    callback map-hold-changed(int);
    callback select-button(int);
    callback toggle-page(int);
    callback search-buttons(string);
    callback select-trigger(int);
    callback trigger-blocked(int);
    callback add-action();
    callback remove-action(int);
    callback move-action(int, int);
    callback action-kind(int, int);
    callback action-choice(int, int);
    callback action-text(int, string);
    callback action-args(int, string);
    callback action-number(int, int);
    callback action-flag(int, bool);
    callback action-enabled(int, bool);
    callback browse(int);

    // 导入遥控器映射的预览
    in property <bool> import-open;
    in property <string> import-source;
    in property <string> import-page;
    in property <[ImportRow]> import-rows;
    in property <int> import-count;
    in property <bool> import-as-profile: true;
    in property <string> import-profile-name;
    callback import-toggle(int);
    callback import-confirm();
    callback import-cancel();
    callback import-as-profile-changed(bool);

    // 总开关：暂停按键
    in property <bool> mapping-enabled: true;
    callback mapping-enabled-changed(bool);

    // 撤销、重做
    in property <bool> can-undo;
    in property <bool> can-redo;
    callback undo();
    callback redo();
    // 方案
    in property <[string]> profile-names;
    in property <int> profile-index;
    in property <string> profile-name;
    callback profile-selected(int);
    callback profile-new();
    callback profile-copy();
    callback profile-rename();
    callback profile-delete();
    // 映射页工具条
    callback apply-preset(int);
    callback copy-actions();
    callback paste-actions();
    callback save-sequence();
    callback open-sequences();
    callback record-key(int, string, bool, bool, bool, bool, bool) -> int;
    // 已保存的动作序列
    in property <bool> sequences-open;
    in property <[SavedItem]> saved-items;
    in property <string> sequences-target;
    in property <int> sequences-count;
    callback sequence-save();
    callback sequence-insert(int);
    callback sequence-replace(int);
    callback sequence-rename(int);
    callback sequence-delete(int);
    callback sequences-close();
    // 确认框、起名字的对话框
    in property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-body;
    in property <string> confirm-ok;
    in property <bool> confirm-danger;
    in property <bool> confirm-notice;
    callback confirm-accept();
    callback confirm-cancel();
    in property <bool> name-open;
    in property <string> name-title;
    in property <string> name-note;
    in property <string> name-initial;
    in property <string> name-ok;
    callback name-accept(string);
    callback name-cancel();
    // 设置页：导出、导入，日志
    callback export-backup();
    callback import-config();
    callback import-remote(int);
    callback open-receive-folder();
    callback pick-receive-folder();
    callback open-logs();
    callback reset-settings(int);
    in property <bool> has-voice-box;
    // 手机电量（-1 = 不知道）
    in property <int> battery-level: -1;
    in property <bool> battery-charging;
    property <bool> battery-low: root.battery-level >= 0 && root.battery-level <= 20 && !root.battery-charging;

    // 总览（顺序和映射页的按键列表一样）
    in property <[OverviewRow]> overview;

    // 设置
    in-out property <float> sensitivity;
    in-out property <float> acceleration;
    in-out property <float> scroll-speed;
    in-out property <bool> natural-scroll;
    in-out property <bool> smoothing;
    in-out property <bool> auto-send;
    in-out property <float> send-delay;
    in-out property <bool> enter-after;
    in-out property <int> input-mode;
    in-out property <bool> clip-sync;
    // 手机发来的文件：存到哪个文件夹、收到后放不放进剪贴板
    in property <string> receive-folder;
    in-out property <bool> receive-clip;
    in-out property <int> double-click-ms;
    in-out property <int> long-press-ms;
    in-out property <int> repeat-delay-ms;
    in-out property <int> repeat-interval-ms;
    in-out property <int> long-repeat-delay-ms;
    in-out property <int> long-repeat-interval-ms;
    in-out property <float> cursor-acceleration;
    in-out property <bool> autostart;
    callback settings-changed();
    callback autostart-changed(bool);

    // 检查更新（ui/src/update.rs）：「关于」里的状态，侧边栏「关于」上的「新」字（有没跳过的新版本），更新窗口
    in property <bool> update-available;
    in property <bool> update-badge;
    in property <string> update-status;
    in property <int> update-tone;
    in property <string> update-note;
    in property <bool> update-checking;
    in-out property <bool> update-auto: true;
    // 局域网连接：二维码弹窗、设置页里绑定过的手机；link-kind 是现在走的连接（局域网 / 蓝牙 / 局域网 + 蓝牙）
    in property <bool> lan-open;
    in property <image> lan-qr;
    in property <bool> lan-qr-ready;
    in property <string> lan-addr-text;
    in property <string> lan-qr-note;
    in property <[LanPhoneRow]> lan-phones;
    in property <string> lan-error;
    in property <string> link-kind;
    // 现在走局域网连着手机（教程里扫码那页打勾用）
    in property <bool> lan-online;
    // 现在用蓝牙连着手机（教程扫码配对那页打勾用）
    in property <bool> bt-online;
    callback lan-pair();
    callback lan-close();
    callback lan-remove(string);
    in property <bool> update-open;
    changed update-open => {
        if (!self.update-open) {
            root.restore-focus();
        }
    }
    in property <string> update-version;
    in property <string> update-detail;
    in property <[string]> update-notes;
    in property <int> update-more;
    in property <string> update-phone;
    in property <int> update-stage;
    in property <float> update-progress;
    in property <string> update-progress-text;
    in property <string> update-error;
    callback check-update();
    callback show-update();
    callback update-auto-changed(bool);
    callback update-now();
    callback update-later();
    callback update-skip();
    callback update-cancel();
    callback update-page();

    // 布局页的手机画面多高：按窗口高度算，整部手机一屏放得下（顶栏、页面标题、页面标签、上下留白都扣掉）
    property <length> layout-canvas-height: Math.max(440px, Math.min(760px, root.height - 65px - (root.config-broken ? 64px : 0px) - 50px - 70px - 12px - 32px - 12px - 6px));
    // 提示条在布局页时避开手机画面
    property <length> layout-left: 28px + (root.layout-canvas-height - 62px) * 306 / 632 + 54px + 16px;

    // 对话框关掉、录快捷键结束、动作行重建以后，把键盘焦点还给主窗口（撤销重做的快捷键靠它）
    public function restore-focus() {
        keys.focus();
    }
    // 打开某个按键的映射（首页、总览里点一行）
    function open-key(index: int) {
        root.select-button(index);
        root.nav = 2;
    }

    // Windows 问鼠标在窗口的哪里（逻辑像素）：0 窗口内容，1 标题栏（拖动、双击最大化、右键出系统菜单），2 最大化按钮。
    // 顶栏和侧边栏最上面一条里，没有按钮的地方都是标题栏
    public pure function title-hit(x: length, y: length) -> int {
        if (y >= 64px) {
            return 0;
        }
        if (root.custom-frame && x >= root.width - root.window-buttons-width) {
            return x >= root.width - root.window-buttons-width + 34px && x < root.width - root.window-buttons-width + 68px ? 2 : 0;
        }
        // 对话框开着时卡片最高到离窗口顶 30px；顶栏的弹出菜单从 56px 开始
        if (y >= ((root.confirm-open || root.name-open || root.import-open || root.sequences-open || root.grid-open || root.tutorial-open || root.update-open) ? 30px : 54px)) {
            return 0;
        }
        if (root.inside(x, y, map-pill.absolute-position.x, map-pill.absolute-position.y, map-pill.width, map-pill.height)
            || root.inside(x, y, undo-redo.absolute-position.x, undo-redo.absolute-position.y, undo-redo.width, undo-redo.height)
            || root.inside(x, y, right-tools.absolute-position.x, 12px, right-tools.width, 40px)) {
            return 0;
        }
        return 1;
    }
    pure function inside(x: length, y: length, left: length, top: length, width: length, height: length) -> bool {
        return x >= left && x < left + width && y >= top && y < top + height;
    }

    // 盖满窗口、看不见的一层（两种颜色都全透明），只为 repaint-all 一翻就让整个窗口重画
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: root.repaint-all ? #ffffff00 : #00000000;
    }

    // 撤销、重做的快捷键：先经过这里（输入框里也一样）；对话框开着、正在录快捷键时不管
    keys := FocusScope {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        capture-key-pressed(event) => {
            if (root.confirm-open || root.name-open || root.import-open || root.sequences-open || root.grid-open || root.tutorial-open || root.update-open || Recorder.active) {
                return reject;
            }
            if (event.modifiers.control && !event.modifiers.alt) {
                if (event.text == "z" || event.text == "Z" || event.text == "\u{1a}") {
                    if (event.modifiers.shift) {
                        root.redo();
                    } else {
                        root.undo();
                    }
                    return accept;
                }
                if (event.text == "y" || event.text == "Y" || event.text == "\u{19}") {
                    root.redo();
                    return accept;
                }
            }
            return reject;
        }
        HorizontalLayout {
            // 侧边栏
            Rectangle {
                width: 210px;
                background: Theme.side;
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Theme.line;
                }
                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 18px;
                    padding-bottom: 16px;
                    // 小鸟、品牌字和顶栏的按钮在一条线上（中线离窗口顶 32px）；
                    // 小鸟对着下面导航的图标那一列，品牌字和导航的字左边对齐
                    HorizontalLayout {
                        padding-left: 4px;
                        padding-bottom: 26px;
                        spacing: 5px;
                        alignment: start;
                        Image {
                            source: @image-url("../../assets/logo.svg");
                            width: 28px;
                            height: 28px;
                        }
                        Wordmark { }
                        VerticalLayout {
                            alignment: end;
                            padding-bottom: 1px;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: Theme.lime-dot;
                            }
                        }
                    }
                    NavGroup {
                        first: 0;
                        nav <=> root.nav;
                        items: [
                            { text: "首页", icon: @image-url("../icons/home.svg"), badge: "", lime: false },
                            { text: "布局", icon: @image-url("../icons/grid.svg"), badge: root.page-names.length > 1 ? root.page-names.length + " 页" : "", lime: false },
                            { text: "映射", icon: @image-url("../icons/kbd.svg"), badge: "" + root.map-button-count, lime: false },
                            { text: "总览", icon: @image-url("../icons/table.svg"), badge: "", lime: false },
                        ];
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-bottom: 6px;
                        height: 46px;
                        Text {
                            text: "设备";
                            color: Theme.mut;
                            font-size: 11px;
                            font-weight: 600;
                            letter-spacing: 1px;
                            vertical-alignment: bottom;
                        }
                    }
                    for d in [
                        { name: root.connected ? root.device : "手机", state: root.connected ? (root.battery-level >= 0 ? root.battery-level + "%" + (root.battery-charging ? " 充电中" : "") : "已连接") : "未连接", color: root.connected ? Theme.green : Theme.amber, warn: root.connected && root.battery-low },
                        { name: "后台程序", state: root.core-running ? "运行中" : "未运行", color: root.core-running ? Theme.green : Theme.red, warn: false },
                    ]: HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 9px;
                        height: 32px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 7px;
                                height: 7px;
                                border-radius: 3.5px;
                                background: d.color;
                            }
                        }
                        Text {
                            text: d.name;
                            color: Theme.fg2;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                            min-width: 0px;
                        }
                        Text {
                            text: d.state;
                            color: d.warn ? Theme.low : Theme.mut;
                            font-size: 11.5px;
                            font-weight: d.warn ? 600 : 400;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                    }
                    // 后台内存：一格 2.5 MB，越少越省
                    Rectangle {
                        height: 92px;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.line;
                        background: Theme.win;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            HorizontalLayout {
                                Text {
                                    text: "后台内存";
                                    color: Theme.fg;
                                    font-size: 12.5px;
                                    font-weight: 600;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: root.core-running ? Fmt.one(root.memory-mb) + " MB" : "—";
                                    color: Theme.mut;
                                    font-size: 12.5px;
                                    font-weight: 600;
                                }
                            }
                            HorizontalLayout {
                                spacing: 2px;
                                height: 14px;
                                for s in 16: Rectangle {
                                    border-radius: 2px;
                                    background: root.core-running && s < root.memory-mb / 2.5 ? Theme.ink : Theme.line2;
                                    animate background { duration: 450ms; }
                                }
                            }
                            HorizontalLayout {
                                Text {
                                    text: !root.core-running ? "未运行" : root.memory-mb < 20 ? "很省" : "正常";
                                    color: Theme.mut;
                                    font-size: 11.5px;
                                    horizontal-stretch: 1;
                                }
                                if !root.core-running: Text {
                                    text: "启动";
                                    color: Theme.fg;
                                    font-size: 11.5px;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.start-core();
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 12px;
                    }
                    NavGroup {
                        first: 4;
                        nav <=> root.nav;
                        items: [
                            { text: "设置", icon: @image-url("../icons/gear.svg"), badge: "", lime: false },
                            { text: "关于", icon: @image-url("../icons/info.svg"), badge: root.update-badge ? "新" : "", lime: true },
                        ];
                    }
                }
            }
            // 右边：顶栏 + 页面
            Rectangle {
                horizontal-stretch: 1;
                VerticalLayout {
                    HorizontalLayout {
                        height: 64px;
                        padding-left: 28px;
                        padding-right: 24px;
                        spacing: 12px;
                        // 连接状态：设备名太长就省略
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            min-width: 0px;
                            Rectangle {
                                height: 32px;
                                max-width: 320px;
                                border-radius: 16px;
                                background: Theme.soft;
                                border-width: 1px;
                                border-color: Theme.line;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 14px;
                                    spacing: 8px;
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 7px;
                                            height: 7px;
                                            border-radius: 3.5px;
                                            background: root.connected ? Theme.green : root.core-running ? Theme.amber : Theme.red;
                                        }
                                    }
                                    Text {
                                        text: root.connected ? "已连接 · " + root.device + (root.link-kind != "" ? " · " + root.link-kind : "") : root.core-running ? "未连接" : "后台未运行";
                                        color: Theme.fg2;
                                        font-size: 12.5px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        min-width: 0px;
                                        horizontal-stretch: 1;
                                    }
                                    if root.connected && root.battery-level >= 0: Text {
                                        text: root.battery-level + "%" + (root.battery-charging ? " 充电中" : "");
                                        color: root.battery-low ? Theme.low : Theme.mut;
                                        font-size: 12px;
                                        font-weight: root.battery-low ? 600 : 400;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        // 总开关：暂停时整块变成橙色提示
                        VerticalLayout {
                            alignment: center;
                            map-pill := Rectangle {
                                horizontal-stretch: 0;
                                height: 32px;
                                border-radius: 16px;
                                background: root.mapping-enabled ? Theme.soft : Theme.tone-bg(2);
                                border-width: 1px;
                                border-color: root.mapping-enabled ? Theme.line : Theme.tone-bg(2);
                                animate background, border-color { duration: 200ms; }
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 6px;
                                    spacing: 8px;
                                    Text {
                                        text: root.mapping-enabled ? "按键映射" : "按键已暂停";
                                        color: root.mapping-enabled ? Theme.fg2 : Theme.tone-fg(2);
                                        font-size: 12.5px;
                                        font-weight: root.mapping-enabled ? 400 : 600;
                                        vertical-alignment: center;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Switch {
                                            checked: root.mapping-enabled;
                                            toggled(on) => {
                                                root.mapping-enabled-changed(on);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        // 撤销、重做（Ctrl+Z、Ctrl+Shift+Z、Ctrl+Y）
                        VerticalLayout {
                            alignment: center;
                            undo-redo := HorizontalLayout {
                                spacing: 2px;
                                IconButton {
                                    icon: @image-url("../icons/undo.svg");
                                    enabled: root.can-undo;
                                    tint: root.can-undo ? Theme.fg2 : Theme.mut;
                                    clicked => {
                                        root.undo();
                                    }
                                }
                                IconButton {
                                    icon: @image-url("../icons/redo.svg");
                                    enabled: root.can-redo;
                                    tint: root.can-redo ? Theme.fg2 : Theme.mut;
                                    clicked => {
                                        root.redo();
                                    }
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        // 右边的按钮（弹出菜单按它的右边对齐）
                        right-tools := HorizontalLayout {
                            horizontal-stretch: 0;
                            spacing: 12px;
                            if !root.core-running: VerticalLayout {
                                alignment: center;
                                GhostButton {
                                    text: "启动后台";
                                    has-icon: true;
                                    icon: @image-url("../icons/power.svg");
                                    clicked => {
                                        root.start-core();
                                    }
                                }
                            }
                            // 添加按键（设置、关于页用不上，不显示）
                            if root.nav < 4: VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    spacing: 1px;
                                    PrimaryButton {
                                        text: "添加按键";
                                        has-icon: true;
                                        icon: @image-url("../icons/plus.svg");
                                        clicked => {
                                            root.nav = 1;
                                            root.add-module(0);
                                        }
                                    }
                                    PrimaryButton {
                                        has-icon: true;
                                        icon: @image-url("../icons/chev.svg");
                                        clicked => {
                                            add-menu.show();
                                        }
                                    }
                                }
                            }
                            // 手机圆标：点开看手机的信息
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 36px;
                                    height: 36px;
                                    border-radius: 18px;
                                    background: root.connected ? Theme.lime : Theme.tone-bg(0);
                                    border-width: phone-area.has-hover ? 1.5px : 0px;
                                    border-color: Theme.mut;
                                    Icon {
                                        source: @image-url("../icons/phone.svg");
                                        tint: root.connected ? Theme.lime-fg : Theme.mut;
                                        size: 17px;
                                    }
                                    phone-area := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            phone-info.show();
                                        }
                                    }
                                }
                            }
                        }
                        // 给窗口按钮留的位置，前面一条竖线隔开（按钮画在最上面一层，对话框开着也能点，见最后的 window-buttons）
                        if root.custom-frame: HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 1px;
                                    height: 20px;
                                    background: Theme.line2;
                                }
                            }
                            Rectangle {
                                width: root.window-buttons-width - 24px;
                            }
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.line;
                    }
                    // 配置文件读不出来：醒目的横幅（不会自动改文件，等你选）
                    if root.config-broken: Rectangle {
                        height: 64px;
                        background: Theme.warn-bg;
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.warn-line;
                        }
                        HorizontalLayout {
                            padding-left: 28px;
                            padding-right: 24px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: @image-url("../icons/warn.svg");
                                    tint: Theme.warn-fg;
                                    size: 17px;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                Text {
                                    text: root.config-broken-text;
                                    color: Theme.warn-fg;
                                    font-size: 13px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.config-broken-note;
                                    color: Theme.warn-fg;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                GhostButton {
                                    small: true;
                                    text: "打开文件夹";
                                    clicked => {
                                        root.open-folder();
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                GhostButton {
                                    small: true;
                                    text: "从最近的备份恢复";
                                    enabled: root.has-backup;
                                    clicked => {
                                        root.broken-restore();
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                GhostButton {
                                    small: true;
                                    text: "用默认布局";
                                    clicked => {
                                        root.broken-default();
                                    }
                                }
                            }
                        }
                    }
                    scroll := ScrollView {
                        VerticalLayout {
                            padding-left: 28px;
                            padding-right: 28px;
                            padding-top: 22px;
                            padding-bottom: 28px;
                            if root.nav == 0: HomePage {
                                greeting: root.greeting;
                                date-text: root.date-text;
                                core-running: root.core-running;
                                connected: root.connected;
                                device: root.device;
                                since-text: root.since-text;
                                today-presses: root.today-presses;
                                today-voice: root.today-voice;
                                rows: root.home-rows;
                                max-today: root.max-today;
                                recent: root.recent;
                                home-modules: root.home-modules;
                                home-page-name: root.home-page-name;
                                columns: root.columns;
                                grid-rows: root.rows;
                                page-count: root.page-names.length;
                                battery-level: root.battery-level;
                                battery-charging: root.battery-charging;
                                profile-name: root.profile-name;
                                sync-state: root.sync-state;
                                sync-text: root.sync-text;
                                check-bluetooth: root.check-bluetooth;
                                check-paired: root.check-paired;
                                bluetooth-note: root.bluetooth-note;
                                paired-note: root.paired-note;
                                lan-phones: root.lan-phones;
                                ask-autostart: root.ask-autostart;
                                narrow: root.width < 1180px;
                                open-folder => {
                                    root.open-folder();
                                }
                                start-core => {
                                    root.start-core();
                                }
                                goto(n) => {
                                    root.nav = n;
                                }
                                open-key(i) => {
                                    // 首页的表按今天用的次数排过，下标要换回映射页的
                                    root.open-key(root.home-rows[i].index);
                                }
                                autostart-answer(on) => {
                                    root.autostart-answer(on);
                                }
                                recheck => {
                                    root.recheck();
                                }
                                lan-pair => {
                                    root.lan-pair();
                                }
                                open-tutorial => {
                                    root.tutorial-first-run = false;
                                    root.tutorial-start = 0;
                                    root.tutorial-open = true;
                                }
                            }
                            if root.nav == 1: LayoutPage {
                                page-names: root.page-names;
                                page-index: root.page-index;
                                columns: root.columns;
                                rows: root.rows;
                                modules: root.modules;
                                selected: root.selected-module;
                                sel-kind: root.sel-kind;
                                sel-label <=> root.sel-label;
                                sel-x: root.sel-x;
                                sel-y: root.sel-y;
                                sel-w: root.sel-w;
                                sel-h: root.sel-h;
                                sel-hold: root.sel-hold;
                                sel-passthrough-ok: root.sel-passthrough-ok;
                                page-name <=> root.page-name;
                                canvas-height: root.layout-canvas-height;
                                select-page(i) => {
                                    root.select-page(i);
                                }
                                add-page => {
                                    root.add-page();
                                }
                                rename-page(t) => {
                                    root.rename-page(t);
                                }
                                delete-page => {
                                    root.delete-page();
                                }
                                open-grid => {
                                    root.grid-open-request();
                                }
                                select-module(i) => {
                                    root.select-module(i);
                                }
                                drag-preview(i, e, dx, dy, free) => {
                                    return root.drag-preview(i, e, dx, dy, free);
                                }
                                place-module(i, x, y, w, h) => {
                                    root.place-module(i, x, y, w, h);
                                }
                                drag-failed => {
                                    root.drag-failed();
                                }
                                add-module(k) => {
                                    root.add-module(k);
                                }
                                delete-module => {
                                    root.delete-module();
                                }
                                kind-changed(k) => {
                                    root.kind-changed(k);
                                }
                                label-changed(t) => {
                                    root.label-changed(t);
                                }
                                rect-changed(x, y, w, h) => {
                                    root.rect-changed(x, y, w, h);
                                }
                                nudge(f, d) => {
                                    root.nudge(f, d);
                                }
                                hold-changed(i) => {
                                    root.sel-hold-changed(i);
                                }
                                hold-blocked => {
                                    root.hold-blocked();
                                }
                                edit-mapping => {
                                    root.edit-mapping();
                                }
                            }
                            if root.nav == 2: MappingPage {
                                list: root.map-list;
                                button-count: root.map-button-count;
                                rows: root.overview;
                                button-index: root.map-button-index;
                                trigger-index: root.map-trigger-index;
                                button-title: root.map-title;
                                button-page: root.map-page;
                                actions: root.map-actions;
                                hold: root.map-hold;
                                passthrough-ok: root.map-passthrough-ok;
                                narrow-actions: root.width < 1160px;
                                profile-names: root.profile-names;
                                profile-index: root.profile-index;
                                profile-selected(i) => {
                                    root.profile-selected(i);
                                }
                                profile-new => {
                                    root.profile-new();
                                }
                                profile-copy => {
                                    root.profile-copy();
                                }
                                profile-rename => {
                                    root.profile-rename();
                                }
                                profile-delete => {
                                    root.profile-delete();
                                }
                                apply-preset(k) => {
                                    root.apply-preset(k);
                                }
                                copy-actions => {
                                    root.copy-actions();
                                }
                                paste-actions => {
                                    root.paste-actions();
                                }
                                save-sequence => {
                                    root.save-sequence();
                                }
                                open-sequences => {
                                    root.open-sequences();
                                }
                                record-key(i, t, c, a, sh, m, p) => {
                                    return root.record-key(i, t, c, a, sh, m, p);
                                }
                                long-press-ms: root.long-press-ms;
                                long-repeat-delay-ms: root.long-repeat-delay-ms;
                                long-repeat-interval-ms: root.long-repeat-interval-ms;
                                repeat-delay-ms: root.repeat-delay-ms;
                                repeat-interval-ms: root.repeat-interval-ms;
                                hold-changed(i) => {
                                    root.map-hold-changed(i);
                                }
                                hold-blocked => {
                                    root.hold-blocked();
                                }
                                select-button(i) => {
                                    root.select-button(i);
                                }
                                toggle-page(i) => {
                                    root.toggle-page(i);
                                }
                                search(t) => {
                                    root.search-buttons(t);
                                }
                                select-trigger(t) => {
                                    root.select-trigger(t);
                                }
                                trigger-blocked(t) => {
                                    root.trigger-blocked(t);
                                }
                                add-action => {
                                    root.add-action();
                                }
                                remove-action(i) => {
                                    root.remove-action(i);
                                }
                                move-action(i, d) => {
                                    root.move-action(i, d);
                                }
                                action-kind(i, k) => {
                                    root.action-kind(i, k);
                                }
                                action-choice(i, c) => {
                                    root.action-choice(i, c);
                                }
                                action-text(i, t) => {
                                    root.action-text(i, t);
                                }
                                action-args(i, t) => {
                                    root.action-args(i, t);
                                }
                                action-number(i, n) => {
                                    root.action-number(i, n);
                                }
                                action-flag(i, on) => {
                                    root.action-flag(i, on);
                                }
                                action-enabled(i, on) => {
                                    root.action-enabled(i, on);
                                }
                                browse(i) => {
                                    root.browse(i);
                                }
                                goto(n) => {
                                    root.nav = n;
                                }
                            }
                            if root.nav == 3: OverviewPage {
                                rows: root.overview;
                                profile-name: root.profile-name;
                                max-today: root.max-today;
                                open-key(i) => {
                                    root.open-key(i);
                                }
                                goto(n) => {
                                    root.nav = n;
                                }
                            }
                            if root.nav == 4: SettingsPage {
                                sensitivity <=> root.sensitivity;
                                acceleration <=> root.acceleration;
                                scroll-speed <=> root.scroll-speed;
                                natural-scroll <=> root.natural-scroll;
                                smoothing <=> root.smoothing;
                                auto-send <=> root.auto-send;
                                send-delay <=> root.send-delay;
                                enter-after <=> root.enter-after;
                                input-mode <=> root.input-mode;
                                clip-sync <=> root.clip-sync;
                                receive-folder: root.receive-folder;
                                receive-clip <=> root.receive-clip;
                                open-receive-folder => {
                                    root.open-receive-folder();
                                }
                                pick-receive-folder => {
                                    root.pick-receive-folder();
                                }
                                double-click-ms <=> root.double-click-ms;
                                long-press-ms <=> root.long-press-ms;
                                repeat-delay-ms <=> root.repeat-delay-ms;
                                repeat-interval-ms <=> root.repeat-interval-ms;
                                long-repeat-delay-ms <=> root.long-repeat-delay-ms;
                                long-repeat-interval-ms <=> root.long-repeat-interval-ms;
                                cursor-acceleration <=> root.cursor-acceleration;
                                autostart <=> root.autostart;
                                core-running: root.core-running;
                                folder: root.folder;
                                has-voice-box: root.has-voice-box;
                                changed => {
                                    root.settings-changed();
                                }
                                reset(i) => {
                                    root.reset-settings(i);
                                }
                                autostart-changed(on) => {
                                    root.autostart-changed(on);
                                }
                                open-folder => {
                                    root.open-folder();
                                }
                                export-backup => {
                                    root.export-backup();
                                }
                                import-config => {
                                    root.import-config();
                                }
                                lan-phones: root.lan-phones;
                                lan-error: root.lan-error;
                                lan-pair => {
                                    root.lan-pair();
                                }
                                lan-remove(id) => {
                                    root.lan-remove(id);
                                }
                                import-remote(k) => {
                                    root.import-remote(k);
                                }
                                open-logs => {
                                    root.open-logs();
                                }
                            }
                            if root.nav == 5: AboutPage {
                                version: root.version;
                                folder: root.folder;
                                phone-app: root.phone-app;
                                phone-model: root.phone-model;
                                update-status: root.update-status;
                                update-tone: root.update-tone;
                                update-note: root.update-note;
                                update-available: root.update-available;
                                update-checking: root.update-checking;
                                update-auto <=> root.update-auto;
                                open-folder => {
                                    root.open-folder();
                                }
                                check-update => {
                                    root.check-update();
                                }
                                show-update => {
                                    root.show-update();
                                }
                                update-auto-changed(on) => {
                                    root.update-auto-changed(on);
                                }
                            }
                        }
                    }
                }
                // 提示：底部的黑色小条，淡入淡出；可以带一个按钮（撤销、打开所在文件夹）。布局页时避开手机画面
                Rectangle {
                    property <length> area-left: root.nav == 1 ? root.layout-left : 0px;
                    x: self.area-left + (parent.width - self.area-left - self.width) / 2;
                    y: parent.height - 64px + (root.toast != "" ? 0px : 8px);
                    width: Math.min(parent.width - self.area-left - 24px, toast-text.preferred-width + (root.toast-action != "" ? action-text.preferred-width + 34px : 0px) + 38px);
                    height: 38px;
                    border-radius: 19px;
                    background: Theme.ink;
                    opacity: root.toast != "" ? 1 : 0;
                    visible: self.opacity > 0.01;
                    animate opacity, y { duration: 200ms; easing: ease-out; }
                    HorizontalLayout {
                        padding-left: 19px;
                        padding-right: root.toast-action != "" ? 5px : 19px;
                        spacing: root.toast-action != "" ? 10px : 0px;
                        toast-text := Text {
                            text: root.toast;
                            color: Theme.ink-fg;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                            min-width: 0px;
                        }
                        VerticalLayout {
                            alignment: center;
                            visible: root.toast-action != "";
                            width: root.toast-action != "" ? action-text.preferred-width + 24px : 0px;
                            Rectangle {
                                height: 28px;
                                width: action-text.preferred-width + 24px;
                                border-radius: 14px;
                                background: action-area.has-hover ? Theme.ink-fg.with-alpha(0.22) : Theme.ink-fg.with-alpha(0.12);
                                animate background { duration: 150ms; }
                                action-text := Text {
                                    x: 12px;
                                    height: parent.height;
                                    text: root.toast-action;
                                    color: Theme.dark ? Theme.lime-fg : Theme.lime;
                                    font-size: 12.5px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                action-area := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.toast-clicked();
                                    }
                                }
                            }
                        }
                    }
                }
                add-menu := PopupWindow {
                    x: right-tools.x + right-tools.width - 230px;
                    y: 56px;
                    width: 200px;
                    height: 3 * 36px + 10px;
                    close-policy: PopupClosePolicy.close-on-click-outside;
                    Rectangle {
                        property <bool> shown: false;
                        init => {
                            self.shown = true;
                        }
                        opacity: self.shown ? 1 : 0;
                        y: self.shown ? 0px : -4px;
                        animate opacity, y { duration: Motion.quick; easing: ease-out; }
                        background: Theme.win;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.line2;
                        for m[i] in [
                            { kind: 1, k: "touchpad", title: "添加触控板" },
                            { kind: 3, k: "voiceButton", title: "添加语音按钮" },
                            { kind: 2, k: "voice", title: "添加语音输入框" },
                        ]: Rectangle {
                            x: 5px;
                            y: 5px + i * 36px;
                            width: parent.width - 10px;
                            height: 36px;
                            border-radius: 7px;
                            background: menu-item.has-hover ? Theme.hover : transparent;
                            HorizontalLayout {
                                padding-left: 8px;
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    KeyTile {
                                        size: 24px;
                                        kind: m.k;
                                    }
                                }
                                Text {
                                    text: m.title;
                                    color: Theme.fg;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                            }
                            menu-item := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.nav = 1;
                                    root.add-module(m.kind);
                                    add-menu.close();
                                }
                            }
                        }
                    }
                }
                // 手机信息浮层
                phone-info := PopupWindow {
                    x: right-tools.x + right-tools.width - 330px;
                    y: 56px;
                    width: 330px;
                    height: 236px;
                    close-policy: PopupClosePolicy.close-on-click-outside;
                    Rectangle {
                        property <bool> shown: false;
                        init => {
                            self.shown = true;
                        }
                        opacity: self.shown ? 1 : 0;
                        y: self.shown ? 0px : -4px;
                        animate opacity, y { duration: Motion.quick; easing: ease-out; }
                        background: Theme.win;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.line2;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: 8px;
                                padding-bottom: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 7px;
                                        height: 7px;
                                        border-radius: 3.5px;
                                        background: root.connected ? Theme.green : Theme.amber;
                                    }
                                }
                                Text {
                                    text: root.connected ? root.device : "手机未连接";
                                    color: Theme.fg;
                                    font-size: 14px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                }
                            }
                            InfoLine {
                                key: "型号";
                                value: root.phone-model != "" ? root.phone-model : "—";
                            }
                            InfoLine {
                                key: "App 版本";
                                value: root.phone-app != "" ? root.phone-app : "—";
                            }
                            InfoLine {
                                key: "电量";
                                value: root.connected && root.battery-level >= 0 ? root.battery-level + "%" + (root.battery-charging ? " · 充电中" : root.battery-low ? " · 电量低" : "") : "—";
                                value-color: root.connected && root.battery-low ? Theme.low : Theme.fg;
                            }
                            InfoLine {
                                key: "连接";
                                value: root.connected ? root.since-text : root.core-running ? "未连接" : "后台未运行";
                            }
                            InfoLine {
                                key: "同步";
                                value: root.sync-text;
                                value-color: root.sync-state == 1 ? Theme.tone-fg(4) : root.sync-state == 3 ? Theme.warn-fg : Theme.fg;
                            }
                        }
                    }
                }
            }
        }
    }

    // 使用教程：盖在主界面上面，别的对话框（确认、导入……）再盖在它上面
    if root.tutorial-open: TutorialDialog {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        first-run: root.tutorial-first-run;
        start-page: root.tutorial-start;
        core-running: root.core-running;
        connected: root.connected;
        device: root.device;
        computer-name: root.computer-name;
        check-bluetooth: root.check-bluetooth;
        check-paired: root.check-paired;
        bluetooth-note: root.bluetooth-note;
        paired-note: root.paired-note;
        lan-phones: root.lan-phones;
        lan-online: root.lan-online;
        bt-online: root.bt-online;
        autostart <=> root.autostart;
        lan-pair => {
            root.lan-pair();
        }
        start-core => {
            root.start-core();
        }
        open-bluetooth-settings => {
            root.open-bluetooth-settings();
        }
        recheck => {
            root.tutorial-recheck();
        }
        autostart-changed(on) => {
            root.autostart-changed(on);
        }
        closed(page) => {
            root.tutorial-open = false;
            root.tutorial-closed(page);
            root.restore-focus();
        }
    }

    if root.import-open: ImportDialog {
        source: root.import-source;
        page: root.import-page;
        rows: root.import-rows;
        count: root.import-count;
        as-profile: root.import-as-profile;
        profile-name: root.import-profile-name;
        current-profile: root.profile-name;
        toggle(i) => {
            root.import-toggle(i);
        }
        as-profile-changed(on) => {
            root.import-as-profile-changed(on);
        }
        confirm => {
            root.import-confirm();
        }
        cancel => {
            root.import-cancel();
        }
    }
    if root.grid-open: GridDialog {
        columns: root.columns;
        rows: root.rows;
        modules: root.modules;
        problem(c, r) => {
            return root.grid-problem(c, r);
        }
        apply(c, r) => {
            root.grid-apply(c, r);
        }
        cancel => {
            root.grid-close();
        }
    }
    if root.sequences-open: SequencesDialog {
        items: root.saved-items;
        target: root.sequences-target;
        current-count: root.sequences-count;
        save => {
            root.sequence-save();
        }
        insert(i) => {
            root.sequence-insert(i);
        }
        replace(i) => {
            root.sequence-replace(i);
        }
        rename(i) => {
            root.sequence-rename(i);
        }
        remove(i) => {
            root.sequence-delete(i);
        }
        close => {
            root.sequences-close();
        }
    }
    if root.update-open: UpdateDialog {
        current: root.version;
        version: root.update-version;
        detail: root.update-detail;
        notes: root.update-notes;
        more: root.update-more;
        phone: root.update-phone;
        stage: root.update-stage;
        progress: root.update-progress;
        progress-text: root.update-progress-text;
        error: root.update-error;
        update-now => {
            root.update-now();
        }
        later => {
            root.update-later();
        }
        skip => {
            root.update-skip();
        }
        cancel-download => {
            root.update-cancel();
        }
        open-page => {
            root.update-page();
        }
    }
    if root.lan-open: LanDialog {
        qr: root.lan-qr;
        ready: root.lan-qr-ready;
        addr-text: root.lan-addr-text;
        note: root.lan-qr-note;
        close => {
            root.lan-close();
        }
    }
    if root.name-open: NameDialog {
        title: root.name-title;
        note: root.name-note;
        initial: root.name-initial;
        ok-text: root.name-ok;
        accept(t) => {
            root.name-accept(t);
        }
        cancel => {
            root.name-cancel();
        }
    }
    if root.confirm-open: ConfirmDialog {
        title: root.confirm-title;
        body: root.confirm-body;
        ok-text: root.confirm-ok;
        danger: root.confirm-danger;
        notice: root.confirm-notice;
        accept => {
            root.confirm-accept();
        }
        cancel => {
            root.confirm-cancel();
        }
    }

    // 窗口按钮：在顶栏右边（顶栏里留了位置），画在最上面一层，对话框开着也能点。
    // 最大化按钮的鼠标消息不经过这里（程序告诉 Windows 那里是最大化按钮），这里的 TouchArea 只在没接管时用得上
    window-buttons := Rectangle {
        visible: root.custom-frame;
        x: root.width - root.window-buttons-width;
        y: 0;
        width: root.window-buttons-width;
        height: 64px;
        TitleButton {
            x: 0;
            height: parent.height;
            icon: @image-url("../icons/win-min.svg");
            active: root.window-active;
            clicked => {
                root.minimize-window();
            }
        }
        TitleButton {
            x: 34px;
            height: parent.height;
            icon: root.window-maximized ? @image-url("../icons/win-restore.svg") : @image-url("../icons/win-max.svg");
            active: root.window-active;
            outside-hover: root.max-hover;
            outside-pressed: root.max-pressed;
            clicked => {
                root.toggle-maximize();
            }
        }
        TitleButton {
            x: 68px;
            height: parent.height;
            extra-right: root.window-buttons-width - 34px * 3;
            icon: @image-url("../icons/win-close.svg");
            danger: true;
            active: root.window-active;
            clicked => {
                root.close-window();
            }
        }
    }
}

// ───────────────────────── 安装界面 ─────────────────────────

// 安装界面左边的步骤：黑色块顺滑地移到正在做的那一步，做完的打勾
component SetupSteps inherits Rectangle {
    in property <[{ text: string, icon: image }]> items;
    in property <int> current;
    height: root.items.length * 38px - 2px;
    Rectangle {
        y: Math.max(0, Math.min(root.items.length - 1, root.current)) * 38px;
        height: 36px;
        border-radius: 10px;
        background: Theme.ink;
        animate y { duration: Motion.normal; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }
    for it[i] in root.items: step := Rectangle {
        property <bool> selected: i == root.current;
        property <bool> done: i < root.current;
        y: i * 38px;
        height: 36px;
        Icon {
            x: 10px;
            size: 17px;
            source: step.done ? @image-url("../icons/check.svg") : it.icon;
            tint: step.selected ? Theme.ink-fg : step.done ? Theme.lime-dot : Theme.mut;
            animate tint { duration: 250ms; }
        }
        Text {
            x: 37px;
            height: parent.height;
            text: it.text;
            color: step.selected ? Theme.ink-fg : step.done ? Theme.fg2 : Theme.mut;
            font-size: 13.5px;
            vertical-alignment: center;
            animate color { duration: 250ms; }
        }
    }
}

// 装好了（青柠色圆里一个勾）、出错了（橙色圆里一个感叹号）：出现时勾轻轻放大
component ResultMark inherits Rectangle {
    in property <bool> warn: false;
    property <bool> shown: false;
    width: 56px;
    height: 56px;
    border-radius: 28px;
    background: root.warn ? Theme.warn-bg : Theme.lime;
    Icon {
        source: root.warn ? @image-url("../icons/warn.svg") : @image-url("../icons/check.svg");
        tint: root.warn ? Theme.warn-fg : Theme.lime-fg;
        size: root.shown ? 28px : 14px;
        animate size { duration: 320ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }
    init => {
        root.shown = true;
    }
}

// 安装、更新、卸载蒜鸟的窗口（`SuanNIAO.exe --setup` / `--uninstall`，见 ui/src/setup.rs）。
// 和主界面一个样子：左边浅灰的一栏（小鸟、步骤），右边白底；系统的标题栏换成自己画的，只有最小化和关闭
export component SetupWindow inherits Window {
    // 别叫「蒜鸟」：新版主界面靠这个标题认出没挂版本号的旧主界面（win::running_ui）
    title: root.mode == 2 ? "卸载蒜鸟" : "安装蒜鸟";
    icon: @image-url("../../assets/icon.png");
    width: 720px;
    height: 460px;
    default-font-family: "Microsoft YaHei UI";
    background: Theme.win;
    forward-focus: keys;

    // 0 安装，1 更新（主界面下载好新版以后打开的：不问，直接装），2 卸载
    in property <int> mode;
    // 0 选项（卸载是确认），1 正在装，2 好了，3 出错了
    in property <int> page;
    in property <string> version;
    // 要装到的文件夹里已经装着的版本：没装过是空的，装着但看不出版本是「?」
    in property <string> installed;
    // 这个安装包比装着的新（1）、一样（0）、旧（-1）
    in property <int> compare: 1;
    in property <string> folder;
    // 「更改」选的文件夹装不了（要管理员权限）：说为什么
    in property <string> folder-error;
    // 换了文件夹、原来装着的那份会搬过去（装好新的删掉旧的）
    in property <bool> moving;
    // 设置在哪（卸载时没删设置，告诉用户还留在哪）
    in property <string> data-folder;
    in-out property <bool> desktop: true;
    in-out property <bool> remove-data;
    in property <float> progress;
    in property <string> step-text;
    in property <string> error;
    // 正在装、正在卸载：关不了
    in property <bool> busy;
    // 同主界面（win::hook_main_window）
    in property <bool> repaint-all;
    in property <bool> custom-frame;
    in property <bool> window-active: true;
    callback start-setup();
    callback change-folder();
    callback launch();
    callback finish();
    callback minimize-window();
    callback close-window();

    // 两个窗口按钮一共多宽：每格 34px，关闭按钮那格伸到窗口右边
    property <length> window-buttons-width: 34px * 2 + 12px;
    // 左边的步骤、正在装时的大标题：安装 / 更新 / 重新安装
    property <string> verb: root.installed == "" ? "安装" : root.compare > 0 ? "更新" : root.compare == 0 ? "重新安装" : "安装";
    property <string> installed-name: root.installed == "?" ? "电脑上的蒜鸟" : root.installed;

    // Windows 问鼠标在窗口的哪里（同主窗口）：最上面 64px 里没有按钮的地方是标题栏
    public pure function title-hit(x: length, y: length) -> int {
        if (y >= 64px || (root.custom-frame && x >= root.width - root.window-buttons-width)) {
            return 0;
        }
        return 1;
    }

    // 盖满窗口、看不见的一层，只为 repaint-all 一翻就让整个窗口重画（同主窗口）
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: root.repaint-all ? #ffffff00 : #00000000;
    }

    // 回车：选项页开始装，装好了打开蒜鸟（卸载要用鼠标点）；Esc：没在装的时候关掉
    keys := FocusScope {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Return) {
                if (root.page == 0 && root.mode == 0) {
                    root.start-setup();
                    return accept;
                }
                if (root.page == 2 && root.mode == 0) {
                    root.launch();
                    return accept;
                }
                if (root.page == 2 && root.mode == 2) {
                    root.finish();
                    return accept;
                }
            }
            if (event.text == Key.Escape && !root.busy && root.page != 1) {
                root.finish();
                return accept;
            }
            return reject;
        }
        HorizontalLayout {
            // 左边一栏：和主界面的侧边栏一样
            Rectangle {
                width: 210px;
                background: Theme.side;
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Theme.line;
                }
                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 18px;
                    padding-bottom: 18px;
                    HorizontalLayout {
                        padding-left: 4px;
                        padding-bottom: 26px;
                        spacing: 5px;
                        alignment: start;
                        Image {
                            source: @image-url("../../assets/logo.svg");
                            width: 28px;
                            height: 28px;
                        }
                        Wordmark { }
                        VerticalLayout {
                            alignment: end;
                            padding-bottom: 1px;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: Theme.lime-dot;
                            }
                        }
                    }
                    SetupSteps {
                        current: root.page == 0 ? 0 : root.page == 2 ? 2 : 1;
                        items: root.mode == 2 ? [
                            { text: "确认", icon: @image-url("../icons/help.svg") },
                            { text: "卸载", icon: @image-url("../icons/trash.svg") },
                            { text: "完成", icon: @image-url("../icons/check.svg") },
                        ] : root.mode == 1 ? [
                            { text: "下载新版本", icon: @image-url("../icons/download.svg") },
                            { text: "更新", icon: @image-url("../icons/refresh.svg") },
                            { text: "完成", icon: @image-url("../icons/check.svg") },
                        ] : [
                            { text: "选项", icon: @image-url("../icons/sliders.svg") },
                            { text: root.verb, icon: @image-url("../icons/download.svg") },
                            { text: "完成", icon: @image-url("../icons/check.svg") },
                        ];
                    }
                    Rectangle {
                        vertical-stretch: 1;
                    }
                    Text {
                        text: "  版本 " + root.version;
                        color: Theme.mut;
                        font-size: 12px;
                    }
                }
            }
            // 右边：一页一页换（淡入）
            Rectangle {
                horizontal-stretch: 1;
                // 安装：要装到哪、桌面上要不要放一个
                if root.page == 0 && root.mode != 2: Page {
                    VerticalLayout {
                        padding-left: 40px;
                        padding-right: 40px;
                        padding-top: 58px;
                        padding-bottom: 26px;
                        Muted {
                            text: root.installed == "" ? "欢迎" : root.installed == "?" ? "电脑上已经装着蒜鸟" : "电脑上装着蒜鸟 " + root.installed;
                            font-size: 13px;
                        }
                        Rectangle {
                            height: 4px;
                        }
                        Text {
                            text: root.installed == "" ? "安装蒜鸟" : root.compare > 0 ? "更新蒜鸟" : root.compare == 0 ? "重新安装蒜鸟" : "电脑上的蒜鸟更新";
                            color: Theme.fg;
                            font-size: 30px;
                            font-weight: 700;
                            letter-spacing: -0.4px;
                        }
                        Rectangle {
                            height: 10px;
                        }
                        WrapText {
                            text: root.installed == "" ? "把手机变成电脑的触控板、快捷键和语音输入。蓝牙或局域网连接，不用装驱动。"
                                : root.compare > 0 ? root.installed-name + " 会换成 " + root.version + "。按键布局、设置都会留着，开着的蒜鸟会先关掉。"
                                : root.compare == 0 ? "电脑上已经是这个版本（" + root.version + "），会把程序文件重新放一遍。按键布局、设置都会留着。"
                                : root.installed-name + " 比这个安装包（" + root.version + "）新。继续安装会换成 " + root.version + "，按键布局、设置都会留着。";
                            font-size: 13.5px;
                        }
                        Rectangle {
                            height: 22px;
                        }
                        Card {
                            VerticalLayout {
                                SettingRow {
                                    first: true;
                                    label: root.moving ? "搬到" : "装在";
                                    note: root.folder;
                                    VerticalLayout {
                                        alignment: center;
                                        GhostButton {
                                            text: "更改";
                                            small: true;
                                            clicked => {
                                                root.change-folder();
                                            }
                                        }
                                    }
                                }
                                SettingRow {
                                    label: "在桌面放一个「蒜鸟」";
                                    note: "开始菜单里总会有一个。";
                                    VerticalLayout {
                                        alignment: center;
                                        Toggle {
                                            checked <=> root.desktop;
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Muted {
                                    text: root.folder-error != "" ? root.folder-error
                                        : root.moving ? "原来位置上的蒜鸟装好后删掉，设置都留着。"
                                        : "只给当前用户安装，不用管理员权限。";
                                    color: root.folder-error != "" ? Theme.warn-fg : Theme.mut;
                                }
                            }
                            GhostButton {
                                text: "取消";
                                clicked => {
                                    root.finish();
                                }
                            }
                            PrimaryButton {
                                text: root.installed == "" ? "安装" : root.compare > 0 ? "更新" : root.compare == 0 ? "重新安装" : "仍然安装";
                                has-icon: true;
                                icon-after: true;
                                icon: @image-url("../icons/right.svg");
                                clicked => {
                                    root.start-setup();
                                }
                            }
                        }
                    }
                }
                // 卸载：确认，要不要连设置一起删
                if root.page == 0 && root.mode == 2: Page {
                    VerticalLayout {
                        padding-left: 40px;
                        padding-right: 40px;
                        padding-top: 58px;
                        padding-bottom: 26px;
                        Muted {
                            text: root.installed == "" || root.installed == "?" ? "蒜鸟" : "蒜鸟 " + root.installed;
                            font-size: 13px;
                        }
                        Rectangle {
                            height: 4px;
                        }
                        Text {
                            text: "卸载蒜鸟";
                            color: Theme.fg;
                            font-size: 30px;
                            font-weight: 700;
                            letter-spacing: -0.4px;
                        }
                        Rectangle {
                            height: 10px;
                        }
                        WrapText {
                            text: "会先关掉开着的蒜鸟（包括托盘里的后台），再删掉程序和开始菜单、桌面上的「蒜鸟」。";
                            font-size: 13.5px;
                        }
                        Rectangle {
                            height: 22px;
                        }
                        Card {
                            VerticalLayout {
                                SettingRow {
                                    first: true;
                                    label: "装在";
                                    note: root.folder;
                                }
                                SettingRow {
                                    label: "同时删掉设置和日志";
                                    note: "布局、备份、日志。不删的话重装还能接着用";
                                    VerticalLayout {
                                        alignment: center;
                                        Toggle {
                                            checked <=> root.remove-data;
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: end;
                            GhostButton {
                                text: "取消";
                                clicked => {
                                    root.finish();
                                }
                            }
                            DangerButton {
                                text: "卸载";
                                clicked => {
                                    root.start-setup();
                                }
                            }
                        }
                    }
                }
                // 正在装、正在卸载
                if root.page == 1: Page {
                    VerticalLayout {
                        padding-left: 40px;
                        padding-right: 40px;
                        padding-top: 58px;
                        padding-bottom: 58px;
                        alignment: center;
                        spacing: 16px;
                        Text {
                            text: root.mode == 2 ? "正在卸载蒜鸟" : root.mode == 1 || root.verb == "更新" ? "正在更新到 " + root.version : "正在" + root.verb + "蒜鸟 " + root.version;
                            color: Theme.fg;
                            font-size: 24px;
                            font-weight: 700;
                        }
                        ProgressBar {
                            value: root.progress;
                        }
                        Muted {
                            text: root.step-text;
                        }
                    }
                }
                // 好了
                if root.page == 2: Page {
                    VerticalLayout {
                        padding-left: 40px;
                        padding-right: 40px;
                        padding-top: 58px;
                        padding-bottom: 26px;
                        Rectangle {
                            vertical-stretch: 1;
                        }
                        HorizontalLayout {
                            alignment: start;
                            ResultMark { }
                        }
                        Rectangle {
                            height: 18px;
                        }
                        Text {
                            text: root.mode == 2 ? "卸载好了" : root.mode == 1 || root.verb == "更新" ? "已经更新到 " + root.version : "装好了";
                            color: Theme.fg;
                            font-size: 30px;
                            font-weight: 700;
                            letter-spacing: -0.4px;
                        }
                        Rectangle {
                            height: 10px;
                        }
                        WrapText {
                            text: root.mode == 2 ? (root.remove-data ? "蒜鸟和它的设置都从这台电脑上删掉了。" : "设置还留在 " + root.data-folder + "，以后重新安装蒜鸟还能接着用。")
                                : root.mode == 1 ? "蒜鸟马上就打开。"
                                : "开始菜单里有「蒜鸟」" + (root.desktop ? "，桌面上也放了一个" : "") + "。第一次打开时有使用教程，带你把手机连上。";
                            font-size: 13.5px;
                        }
                        Rectangle {
                            vertical-stretch: 2;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: end;
                            if root.mode == 0: GhostButton {
                                text: "完成";
                                clicked => {
                                    root.finish();
                                }
                            }
                            if root.mode == 0: PrimaryButton {
                                text: "打开蒜鸟";
                                has-icon: true;
                                icon-after: true;
                                icon: @image-url("../icons/right.svg");
                                clicked => {
                                    root.launch();
                                }
                            }
                            if root.mode == 2: PrimaryButton {
                                text: "完成";
                                clicked => {
                                    root.finish();
                                }
                            }
                        }
                    }
                }
                // 出错了：说清楚为什么，可以重试
                if root.page == 3: Page {
                    VerticalLayout {
                        padding-left: 40px;
                        padding-right: 40px;
                        padding-top: 58px;
                        padding-bottom: 26px;
                        Rectangle {
                            vertical-stretch: 1;
                        }
                        HorizontalLayout {
                            alignment: start;
                            ResultMark {
                                warn: true;
                            }
                        }
                        Rectangle {
                            height: 18px;
                        }
                        Text {
                            text: root.mode == 2 ? "没卸载完" : root.mode == 1 ? "没更新成" : "没装好";
                            color: Theme.fg;
                            font-size: 30px;
                            font-weight: 700;
                            letter-spacing: -0.4px;
                        }
                        Rectangle {
                            height: 10px;
                        }
                        WrapText {
                            text: root.error;
                            font-size: 13.5px;
                        }
                        Rectangle {
                            vertical-stretch: 2;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: end;
                            GhostButton {
                                text: "关闭";
                                clicked => {
                                    root.finish();
                                }
                            }
                            PrimaryButton {
                                text: "重试";
                                has-icon: true;
                                icon: @image-url("../icons/refresh.svg");
                                clicked => {
                                    root.start-setup();
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // 窗口按钮：最小化、关闭（正在装的时候关不了）
    Rectangle {
        visible: root.custom-frame;
        x: root.width - root.window-buttons-width;
        y: 0;
        width: root.window-buttons-width;
        height: 64px;
        TitleButton {
            x: 0;
            height: parent.height;
            icon: @image-url("../icons/win-min.svg");
            active: root.window-active;
            clicked => {
                root.minimize-window();
            }
        }
        TitleButton {
            x: 34px;
            height: parent.height;
            extra-right: root.window-buttons-width - 34px * 2;
            icon: @image-url("../icons/win-close.svg");
            danger: true;
            active: root.window-active;
            enabled: !root.busy;
            clicked => {
                root.close-window();
            }
        }
    }
}
