<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 「检查更新」用（Updater.kt）：看有没有新版本、下载新版本的安装包，只连 GitHub 和它在国内的镜像 Gitee。
         语音识别照样在手机上做，不联网 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 检查更新：看是不是没联网、是不是在用流量（安装包一百五十多 MB，用流量时提醒一句） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 把下好的新版本交给系统安装，每次都由系统的安装界面问用户 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 局域网连接（扫码绑定的电脑）：INTERNET 用来连电脑；Wi-Fi 低延迟锁要 WAKE_LOCK；
         只用局域网、没给蓝牙权限时，「连接的设备」类前台服务靠 CHANGE_NETWORK_STATE 满足 Android 14 的要求 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- 打开「省电策略」页让用户选「无限制」：不然息屏、切到别的 App 一会儿后局域网会被系统掐断 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 扫电脑上的二维码（只在点「扫码连接电脑」时用）。2026-10-30 在小米 13 上复测：声明、授权、真的打开相机，都还是 120 Hz -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Android 11 起要声明才能找到系统的语音识别服务 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:label="蒜鸟"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/SuanNiao">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 电脑上二维码里的链接：系统的扫一扫、相机扫到后用蒜鸟打开，去绑定这台电脑 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="suanniao" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- 扫电脑上二维码的界面（蒜鸟自己画的，相机和识别用 zxing-android-embedded；见 ScanActivity.kt） -->
        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/SuanNiao.Scan" />

        <!-- 系统「分享」菜单里的「蒜鸟」：把文件（或一段文字）发到电脑。看不见，交给连接服务就关掉（见 ShareActivity.kt） -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="蒜鸟"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".LinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- 电脑上复制的图片放进手机剪贴板：粘贴的 App 通过它读图片（只读，不导出，粘贴时系统临时授权；见 ClipProvider.kt） -->
        <provider
            android:name=".ClipProvider"
            android:authorities="${applicationId}.clip"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 把下好的新版本安装包交给系统安装器读（只读，只认 App 缓存里核对过的安装包；见 Updater.kt 的 ApkProvider） -->
        <provider
            android:name=".ApkProvider"
            android:authorities="${applicationId}.update"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
