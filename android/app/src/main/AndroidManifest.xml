<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 只给「检查更新」用（Updater.kt）：看 GitHub 上有没有新版本、下载新版本的安装包，只连 GitHub。
         语音识别照样在手机上做，不联网 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 检查更新：看是不是没联网、是不是在用流量（安装包一百五十多 MB，用流量时提醒一句） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 把下好的新版本交给系统安装，每次都由系统的安装界面问用户 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 局域网连接（扫码绑定的电脑）：INTERNET 用来连电脑；Wi-Fi 低延迟锁要 WAKE_LOCK；
         只用局域网、没给蓝牙权限时，「连接的设备」类前台服务靠 CHANGE_NETWORK_STATE 满足 Android 14 的要求 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- 不要相机权限：澎湃 OS 把声明了相机权限的 App 归到「跟随应用内设置」，蒜鸟就只有 60 Hz（实测，去掉就是 120 Hz）。
         扫码交给系统的「扫一扫」/ 相机，扫到的 suanniao://pair 链接由下面的 MainActivity 打开。
         这里写 remove，免得以后加的库把相机权限带进来 -->
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />

    <!-- Android 11 起要声明才能找到系统的语音识别服务 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- 扫码绑定电脑：打开小米「扫一扫」 -->
        <package android:name="com.xiaomi.scanner" />
    </queries>

    <application
        android:label="蒜鸟"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/SuanNiao">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 电脑上二维码里的链接：系统的扫一扫、相机扫到后用蒜鸟打开，去绑定这台电脑 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="suanniao" android:host="pair" />
            </intent-filter>
        </activity>

        <service
            android:name=".LinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- 电脑上复制的图片放进手机剪贴板：粘贴的 App 通过它读图片（只读，不导出，粘贴时系统临时授权；见 ClipProvider.kt） -->
        <provider
            android:name=".ClipProvider"
            android:authorities="${applicationId}.clip"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 把下好的新版本安装包交给系统安装器读（只读，只认 App 缓存里核对过的安装包；见 Updater.kt 的 ApkProvider） -->
        <provider
            android:name=".ApkProvider"
            android:authorities="${applicationId}.update"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
